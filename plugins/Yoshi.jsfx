options:no_meter gfx_hz=60

// ============================================================================
//  YOSHI -- a host-synchronised MIDI arpeggiator for REAPER (JSFX)
//
//  Hold a chord, pick a rate and an order. A 16-step expression pattern
//  (accent, octave, gate, chance, ratchet) shapes the result.
//
//  Layout of this file
//    header ....... 100 sliders: 11 globals, 80 pattern steps (hidden; the UI is @gfx)
//    @init ........ memory map, held-note table, order engine, scheduler,
//                   generated-note registry, output queue
//    @block ....... clock, parameter transitions, MIDI in -> scheduler -> MIDI out
//    @serialize ... versioned UI state
//    @gfx ......... the interface
//
//  MIT licence. Copyright (c) 2026 Michele Ibba.
//  Permission is hereby granted, free of charge, to any person obtaining a copy
//  of this software and associated documentation files (the "Software"), to deal
//  in the Software without restriction, including without limitation the rights
//  to use, copy, modify, merge, publish, distribute, sublicense, and/or sell
//  copies of the Software, and to permit persons to whom the Software is
//  furnished to do so, subject to the following conditions: the above copyright
//  notice and this permission notice shall be included in all copies or
//  substantial portions of the Software. THE SOFTWARE IS PROVIDED "AS IS",
//  WITHOUT WARRANTY OF ANY KIND, EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED
//  TO THE WARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND
//  NONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE
//  FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION OF CONTRACT,
//  TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE OR
//  THE USE OR OTHER DEALINGS IN THE SOFTWARE.
//  No third-party code is incorporated.
// ============================================================================

in_pin:none
out_pin:none

slider1:p_enable=1<0,1,1{Off,On}>-Enable
slider2:p_rate=11<0,15,1{1/1,1/2.,1/2,1/4.,1/2T,1/4,1/8.,1/4T,1/8,1/16.,1/8T,1/16,1/32.,1/16T,1/32,1/32T}>-Rate
slider3:p_order=0<0,6,1{Up,Down,Up/Down,Down/Up,As Played,Random,Chord}>-Order
slider4:p_octaves=1<1,4,1>-Octaves
slider5:p_gate=75<5,200,1>-Gate (%)
slider6:p_swing=0<0,100,1>-Swing (%)
slider7:p_hold=0<0,1,1{Off,On}>-Hold
slider8:p_sync=1<0,2,1{Free,Beat,Song}>-Sync
slider9:p_dyn=100<0,100,1>-Dynamics (%)
slider10:p_len=16<1,16,1>-Pattern Length
slider11:p_seed=1<1,99,1>-Seed
// sliders 12..20 are reserved for future global parameters
slider21:100<0,200,1>-Step 1 Accent (%)
slider22:100<0,200,1>-Step 2 Accent (%)
slider23:100<0,200,1>-Step 3 Accent (%)
slider24:100<0,200,1>-Step 4 Accent (%)
slider25:100<0,200,1>-Step 5 Accent (%)
slider26:100<0,200,1>-Step 6 Accent (%)
slider27:100<0,200,1>-Step 7 Accent (%)
slider28:100<0,200,1>-Step 8 Accent (%)
slider29:100<0,200,1>-Step 9 Accent (%)
slider30:100<0,200,1>-Step 10 Accent (%)
slider31:100<0,200,1>-Step 11 Accent (%)
slider32:100<0,200,1>-Step 12 Accent (%)
slider33:100<0,200,1>-Step 13 Accent (%)
slider34:100<0,200,1>-Step 14 Accent (%)
slider35:100<0,200,1>-Step 15 Accent (%)
slider36:100<0,200,1>-Step 16 Accent (%)
slider37:0<-2,2,1>-Step 1 Octave
slider38:0<-2,2,1>-Step 2 Octave
slider39:0<-2,2,1>-Step 3 Octave
slider40:0<-2,2,1>-Step 4 Octave
slider41:0<-2,2,1>-Step 5 Octave
slider42:0<-2,2,1>-Step 6 Octave
slider43:0<-2,2,1>-Step 7 Octave
slider44:0<-2,2,1>-Step 8 Octave
slider45:0<-2,2,1>-Step 9 Octave
slider46:0<-2,2,1>-Step 10 Octave
slider47:0<-2,2,1>-Step 11 Octave
slider48:0<-2,2,1>-Step 12 Octave
slider49:0<-2,2,1>-Step 13 Octave
slider50:0<-2,2,1>-Step 14 Octave
slider51:0<-2,2,1>-Step 15 Octave
slider52:0<-2,2,1>-Step 16 Octave
slider53:100<10,200,1>-Step 1 Gate (%)
slider54:100<10,200,1>-Step 2 Gate (%)
slider55:100<10,200,1>-Step 3 Gate (%)
slider56:100<10,200,1>-Step 4 Gate (%)
slider57:100<10,200,1>-Step 5 Gate (%)
slider58:100<10,200,1>-Step 6 Gate (%)
slider59:100<10,200,1>-Step 7 Gate (%)
slider60:100<10,200,1>-Step 8 Gate (%)
slider61:100<10,200,1>-Step 9 Gate (%)
slider62:100<10,200,1>-Step 10 Gate (%)
slider63:100<10,200,1>-Step 11 Gate (%)
slider64:100<10,200,1>-Step 12 Gate (%)
slider65:100<10,200,1>-Step 13 Gate (%)
slider66:100<10,200,1>-Step 14 Gate (%)
slider67:100<10,200,1>-Step 15 Gate (%)
slider68:100<10,200,1>-Step 16 Gate (%)
slider69:100<0,100,1>-Step 1 Chance (%)
slider70:100<0,100,1>-Step 2 Chance (%)
slider71:100<0,100,1>-Step 3 Chance (%)
slider72:100<0,100,1>-Step 4 Chance (%)
slider73:100<0,100,1>-Step 5 Chance (%)
slider74:100<0,100,1>-Step 6 Chance (%)
slider75:100<0,100,1>-Step 7 Chance (%)
slider76:100<0,100,1>-Step 8 Chance (%)
slider77:100<0,100,1>-Step 9 Chance (%)
slider78:100<0,100,1>-Step 10 Chance (%)
slider79:100<0,100,1>-Step 11 Chance (%)
slider80:100<0,100,1>-Step 12 Chance (%)
slider81:100<0,100,1>-Step 13 Chance (%)
slider82:100<0,100,1>-Step 14 Chance (%)
slider83:100<0,100,1>-Step 15 Chance (%)
slider84:100<0,100,1>-Step 16 Chance (%)
slider85:1<1,4,1>-Step 1 Ratchet
slider86:1<1,4,1>-Step 2 Ratchet
slider87:1<1,4,1>-Step 3 Ratchet
slider88:1<1,4,1>-Step 4 Ratchet
slider89:1<1,4,1>-Step 5 Ratchet
slider90:1<1,4,1>-Step 6 Ratchet
slider91:1<1,4,1>-Step 7 Ratchet
slider92:1<1,4,1>-Step 8 Ratchet
slider93:1<1,4,1>-Step 9 Ratchet
slider94:1<1,4,1>-Step 10 Ratchet
slider95:1<1,4,1>-Step 11 Ratchet
slider96:1<1,4,1>-Step 12 Ratchet
slider97:1<1,4,1>-Step 13 Ratchet
slider98:1<1,4,1>-Step 14 Ratchet
