        stg_gen+=1;m[M_GEN]=stg_gen;m[M_STATUS]=3;bank_owner[b]=2;active_gen=stg_gen;
      ) : (m[M_STATUS]=0;bank_owner[b]=0;active_gen=0;);
      active_bank=b;state_restored=1;restore_pending=1;rate_epoch_reset=1;
      err_state=0;state_error=0;TELE[T_ERR]=0;
      shared_patch_reset(clampf(slider(59),1,16777215)|0);CMD[C_ROUTES_GEN]+=1;region_update();
    );
