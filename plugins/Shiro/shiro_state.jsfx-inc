            layout=reading ? -1 : (l==0 ? 0 : 1);file_var(0,layout);
            ident!=l || rate!=(l==0 ? 48000 : 96000/(2^(l-1))) || channels!=2
              || desc_frames!=expected_frames || layout!=(l==0 ? 0 : 1) ? state_error=1 : (
              l==0 ? (!state_pcm_transfer(canonical_ptr(b),expected_frames*2,reading) ? state_error=1;)
              : (
                !state_pcm_transfer(lvl_ptr(b,l-1),expected_frames,reading) ? state_error=1;
                !state_error && !state_pcm_transfer(lvl_right_ptr(b,l-1),expected_frames,reading) ? state_error=1;
              );
            );l+=1;
          );
          regenerate=m[M_PYRTAG]!=PYR_TAG;
        );
      );
    );
    // Tail validation precedes preparation and every live-state publication.
    schema>=2 && !state_error ? (
      param_count=reading ? 0 : 59;file_var(0,param_count);
      param_count!=59 ? state_error=1 : (
        !reading ? (i=0;while(i<59)(v=slider(i+1);SERIAL_PARAMS[i]=clampf(v==v ? v : 0,SERIAL_LIMITS[2*i],SERIAL_LIMITS[2*i+1]);i+=1;));
        n=file_mem(0,SERIAL_PARAMS,59);end_tag=reading ? 0 : STATE_PARAMS_END;file_var(0,end_tag);
        reading && (n!=59 || end_tag!=STATE_PARAMS_END || !state_params_valid()) ? state_error=1;
      );
    );
