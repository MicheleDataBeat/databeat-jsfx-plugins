function ui_draw_drawer(x0, y0, w, h) local(rowh)
(
  ui_c_panel(); ui_rect(x0, y0, w, h);
  rowh = 26;
  ui_ov_source === 1 ? ( ui_draw_env_adsr_row(x0 + 8, y0 + 8, w * 0.62); ui_draw_assign_list(x0 + 8 + w * 0.64, y0 + 8, w * 0.34, 1, rowh); )
  : ui_ov_source === 2 ? ( ui_draw_lfo_row(x0 + 8, y0 + 8, w * 0.62, 1); ui_draw_assign_list(x0 + 8 + w * 0.64, y0 + 8, w * 0.34, 2, rowh); )
  : ui_ov_source === 3 ? ( ui_draw_lfo_row(x0 + 8, y0 + 8, w * 0.62, 0); ui_draw_assign_list(x0 + 8 + w * 0.64, y0 + 8, w * 0.34, 3, rowh); )
  : ui_ov_source === 4 ? ( ui_draw_random_row(x0 + 8, y0 + 8, w * 0.62); ui_draw_assign_list(x0 + 8 + w * 0.64, y0 + 8, w * 0.34, 4, rowh); )
  : ui_ov_source === 5 ? (
      ui_draw_midi_row(x0 + 8, y0 + 8, w * 0.62);
      ui_c_dim(); ui_font(2, 10); ui_text(x0 + 8, y0 + 44, "Velocity / Pressure / Wheel / Key Track assignments (right-click a field to assign)");
    )
  : ui_ov_source === 6 ? ui_draw_preset_details(x0 + 8, y0 + 8, w - 16)
  : ui_ov_source === 7 ? (
      ui_c_dim(); ui_font(2, 11); ui_text(x0 + 8, y0 + 6, "Amp envelope");
      ui_draw_env_adsr_row2(x0 + 8, y0 + 22, w - 16);
    )
  : ( ui_c_dim(); ui_font(3, 13); ui_text(x0 + 8, y0 + 8, "Select a motion source above."); );
);



// ==================================================================== MACROS
function ui_draw_macros(x0, y0, w, h) local(colw nv i j r cnt cy)
(
  colw = (w - 24) / 4;
  i = 0;
  while (i < 4) (
    nv = ui_numfield(x0 + i * (colw + 8), y0, colw, 56, i === 0 ? "BODY" : i === 1 ? "MOTION" : i === 2 ? "COLOUR" : "SPACE", slider(55 + i), 0, 1, 0, 0.05, 0.005, 0, 3, -1, 0);
    nv != slider(55 + i) ? ( slider(55 + i) = nv; slider_automate(slider(55 + i)); ); ui_touch ? slider_automate(slider(55 + i), 1);
    cy = y0 + 60; cnt = 0; r = 0;
    while (r < NROUTES) (
      ROUTES_UI[r * 4] === 9 + i ? (
        ui_dest_name_short(ROUTES_UI[r * 4 + 1] - 1);
        ui_c_mod(); ui_font(2, 10); ui_textbox(x0 + i * (colw + 8) + cnt * 60, cy, 58, 14, #ui_fv, 0);
        cnt += 1;
      );
      r += 1;
    );
    i += 1;
  );
);

// ==================================================================== FOOTER
function ui_draw_footer(x0, y0, w, h) local(voices grains limitn holdmsL holdmsR pk)
(
  voices = TELE[T_VOICES]; grains = TELE[T_GRAINS];
  sprintf(#ui_fv2, "Voices %d/8 . Grains %d/96", voices, grains);
  ui_c_dim(); ui_font(2, 12); ui_text(x0, y0 + 14, #ui_fv2);
  limitn = 0;
  ui_c_warn(); ui_font(2, 11);
  TELE[T_DROPS] > ui_pt_drops ? ( ui_text(x0 + 220 + limitn * 44, y0 + 15, "drops"); limitn += 1; );
  TELE[T_PITCHCLAMP] > ui_pt_pitch ? ( ui_text(x0 + 220 + limitn * 44, y0 + 15, "pitch"); limitn += 1; );
  TELE[T_RATECAP] > ui_pt_rate ? ( ui_text(x0 + 220 + limitn * 44, y0 + 15, "rate"); limitn += 1; );
  TELE[T_MIDIOVF] > ui_pt_midi ? ( ui_text(x0 + 220 + limitn * 44, y0 + 15, "MIDI"); limitn += 1; );
  TELE[T_PROTECT] > ui_pt_protect ? ( ui_text(x0 + 220 + limitn * 44, y0 + 15, "protect"); limitn += 1; );
  ui_pt_drops = TELE[T_DROPS]; ui_pt_pitch = TELE[T_PITCHCLAMP]; ui_pt_rate = TELE[T_RATECAP]; ui_pt_midi = TELE[T_MIDIOVF]; ui_pt_protect = TELE[T_PROTECT];
  ui_button(x0 + 430, y0 + 6, 60, 32, "Panic") ? ( atomic_set(CMD[C_PANIC], 1); );
  ui_hover_active ? ( ui_c_dim(); ui_font(2, 11); ui_textbox(x0 + 500, y0 + 15, w - 500 - 140, 16, #ui_hint, 0); )
  : time_precise() - ui_warn_flash_t < 1.5 ? ( ui_c_warn(); ui_font(2, 11); ui_textbox(x0 + 500, y0 + 15, w - 500 - 140, 16, #ui_warn_msg, 0); );
  // output meter
  pk = max(TELE[T_PEAKL], TELE[T_PEAKR]);
  pk > ui_meter_hold ? ( ui_meter_hold = pk; ui_meter_hold_t = time_precise(); ) : time_precise() - ui_meter_hold_t > 1.5 ? ui_meter_hold = max(0, ui_meter_hold * 0.9);
  ui_c_field(); ui_rect(x0 + w - 140, y0 + 8, 120, 20);
  ui_c_ok(); ui_rect(x0 + w - 138, y0 + 10, 116 * max(0, min(1, ui_meter_hold)), 16);
  ui_meter_hold > 0.891 ? ( ui_c_warn(); ui_rect(x0 + w - 24, y0 + 10, 2, 16); );
);

// ==================================================================== OVERLAYS

// Keep native controls in four pages: showing all 59 at once pushes @gfx offscreen on macOS.
// Visibility is an editor preference only; parameter identities and values never change.
function ui_host_page(page) local(i last)
(
  ui_host_sliders = max(0, min(4, page | 0)); slider_show(-1, 0);
  ui_host_sliders > 0 ? (
    i = (ui_host_sliders - 1) * 15; last = min(59, i + 15);
    while (i < last) ( slider_show(2 ^ i, 1); i += 1; );
  );
  ui_overlay = 0; ui_focus_ix = -1;
);

function ui_draw_host_controls()
(
  ui_blocked = 0;
  ui_button(16, 16, 120, 32, "Custom panel") ? ui_host_page(0);
  ui_button(148, 16, 100, 32, "Previous") ? ui_host_page(ui_host_sliders <= 1 ? 4 : ui_host_sliders - 1);
  ui_button(260, 16, 100, 32, "Next") ? ui_host_page(ui_host_sliders >= 4 ? 1 : ui_host_sliders + 1);
  ui_c_text(); ui_font(3, 13);
  sprintf(#ui_fv, "REAPER parameters %d-%d of 59", (ui_host_sliders - 1) * 15 + 1, min(59, ui_host_sliders * 15));
  ui_text(16, 64, #ui_fv);
);

function ui_scale_pct(k) ( k === 0 ? 100 : k === 1 ? 125 : k === 2 ? 150 : 200; );

function ui_draw_menu() local(x y w h i n by)
(
  w = 220; x = ui_w - 16 - w; n = 9; h = n * 32 + 8;
  // The top margin is given back when the viewport is shorter than the menu, which is what an
  // enlarged Scale does: at 200 % on a Retina window ui_s is 4, leaving a 218-point viewport
  // against a 296-point menu, and the 48 points are the difference between the Scale rows being
  // reachable and not. At a scale that needs no scrolling this is exactly the old y = 48.
  y = max(0, min(48, ui_view_h - h));
  ui_c_panel(); ui_rect(x, y, w, h); ui_c_line(); ui_frame_rect(x, y, w, h);
  i = 0;
  while (i < n) (
    by = y + 4 + i * 32;
    i == 0 ? strcpy(#ui_fv, "Reset sound")
    : i == 1 ? strcpy(#ui_fv, stg_status === SS_PENDING ? "Apply now" : "(Apply now)")
    : i == 2 ? strcpy(#ui_fv, (stg_status >= SS_PYR1 && stg_status <= SS_PENDING) ? "Cancel load" : "(Cancel load)")
    : i == 3 ? ( ui_scale_idx < 3 ? sprintf(#ui_fv, "Scale up (%d%%)", ui_scale_pct(ui_scale_idx + 1)) : strcpy(#ui_fv, "(Scale up)") )
    : i == 4 ? ( ui_scale_idx > 0 ? sprintf(#ui_fv, "Scale down (%d%%)", ui_scale_pct(ui_scale_idx - 1)) : strcpy(#ui_fv, "(Scale down)") )
    : i == 5 ? strcpy(#ui_fv, "Diagnostics")
    : i == 6 ? strcpy(#ui_fv, "Load file...")
    : i == 7 ? strcpy(#ui_fv, "Host parameters...")
    : strcpy(#ui_fv, "Close");
    ui_rowbutton(x, by, w, 32, #ui_fv) ? (
      i == 0 ? ( reset_sound(); ui_overlay = 0; )
      : i == 1 ? ( stg_status === SS_PENDING ? ( atomic_set(CMD[C_APPLY], 1); ui_overlay = 0; ); )
      : i == 2 ? ( (stg_status >= SS_PYR1 && stg_status <= SS_PENDING) ? ( prep_cancel(); ui_overlay = 0; ); )
      // Scale is two separate rows that clamp at the ends, not one row that cycles (owner FIX,
      // 18 September 2026): a single cycling item made getting back down a matter of going round,
      // and above 100 % the row it had to go round with was off-screen.
      // Each step also asks the viewport to pan fully right and to the top, where the menu lives.
      // The menu is pinned to the right edge of the LOGICAL canvas (ui_w), which above 100 % is
      // wider than the visible viewport, so without the pan the menu lands off-screen on the first
      // step up and the only way back is the scrollbar. 1000000000 is a request, not a position:
      // ui_frame_impl clamps it to ui_view_maxx on the next frame, the first frame that knows the
      // new geometry. The literal is spelled out because EEL2 has no scientific notation -- `1e9`
      // compiles to nothing and takes the whole effect down with it.
      : i == 3 ? ( ui_scale_idx < 3 ? ( ui_scale_idx += 1; ui_view_x = 1000000000; ui_view_y = 0; ); )
      : i == 4 ? ( ui_scale_idx > 0 ? ( ui_scale_idx -= 1; ui_view_x = 1000000000; ui_view_y = 0; ); )
      : i == 5 ? ( ui_overlay = 5; )
      : i == 6 ? ( ui_overlay = 3; ui_edit_active = 1; ui_edit_owner = -5; ui_edit_selected = 0; ui_edit_commit = 0; strcpy(#ui_edit_text, ""); )
      : i == 7 ? ui_host_page(1)
      : ( ui_overlay = 0; );
    );
    i += 1;
  );
  ui_view_hit && (mouse_cap & 1) && !(ui_lastcap & 1) && !(ui_mx >= x && ui_mx < x + w && ui_my >= y && ui_my < y + h) ? ui_overlay = 0;
);

function ui_draw_preset_browser() local(x y w h i n by col1 col2 ncat k c found cy rows skipped shown matched selcat hit)
(
  w = min(ui_w - 40, 720); h = min(ui_h - 100, 480); x = (ui_w - w) / 2; y = 60;
  ui_c_panel(); ui_rect(x, y, w, h); ui_c_line(); ui_frame_rect(x, y, w, h);
  ui_c_text(); ui_font(1, 16); ui_text(x + 12, y + 8, "Preset browser");
  col1 = x + 12; col2 = x + 190;
