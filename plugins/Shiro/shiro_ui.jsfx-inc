  ui_text(x + 12, by, #ui_fv2); by += 18;
  sprintf(#ui_fv2, "stg_status %d  stg_err %d  stg_frames %d  srate %d  tempo %.1f", stg_status, stg_err, stg_frames, srate, cur_tempo);
  ui_text(x + 12, by, #ui_fv2); by += 24;
