  ui_c_text(); ui_font(3, 13); ui_textbox(x + 8, y + 8, w - 16, h - 8, label, 0);
  clicked;
);

function ui_minitext(x, y, w, h, label) local(myslot hit clicked)
(
  myslot = ui_slot; ui_slot += 1; ui_track_focus(myslot, x, y, w, h);
  hit = !ui_blocked && ui_hit(x, y, w, h);
  clicked = hit && !(mouse_cap & 1) && (ui_lastcap & 1) && ui_press_slot === myslot;
  hit && (mouse_cap & 1) && !(ui_lastcap & 1) ? ( ui_press_slot = myslot; ui_focus_ix = myslot; );
  myslot === ui_focus_ix && !ui_blocked && !ui_edit_active && ui_key_enter ? ( clicked = 1; ui_key_enter = 0; ui_key_space = 0; );
  hit ? ui_c_mod() : ui_c_dim();
  ui_font(2, 11); ui_textbox(x, y, w, h, label, 1 | 4);
  clicked;
);

// route source-of-truth helpers (UI copy only)


// does the currently selected motion source (Env/LFO1/LFO2/Random/MIDI's 4 sources) route to this dest?


// ==================================================================== assignment list (routes from one source)
function ui_draw_assign_list(x, y, w, srcid, rowh) local(r count)
(
  count = 0; r = 0;
  while (r < NROUTES) ( ROUTES_UI[r * 4] === srcid ? count += 1; r += 1; );
  sprintf(#ui_fv, "%d assignment%s", count, count === 1 ? "" : "s");
  ui_c_dim(); ui_font(2, 13); ui_text(x, y, #ui_fv);
  ui_button(x, y + 22, min(w, 160), 32, "Edit routes") ? ( ui_overlay = 6; ui_route_scroll = 0; );
);

// ==================================================================== HEADER
function ui_is_modified() local(base i r ne)
(
  factory_origin > 0 && factory_origin <= NFACTORY ? (
    base = FT_PARAMS + (factory_origin - 1) * 64; ne = 0;
    // Skip Polyphony (index 1) and MIDI Channel (index 2) for the same reason patch_apply_staged()
    // no longer writes them: they are the player's performance setup, not part of the sound. Every
    // factory row stores 8 / Omni, so counting them here would light this dot permanently, on every
    // preset, for anyone who has set either -- reporting an edit that the preset did not make.
    i = 0; while (i < 59) ( i == 1 || i == 2 ? 0 : ( abs(slider(i + 1) - base[i]) > 0.0005 ? ne = 1; ); i += 1; );
    abs(preset_trim - base[59]) > 0.0005 ? ne = 1;
    r = 0; while (r < NROUTES) (
      (ROUTES_UI[r * 4] != FT_ROUTES[(factory_origin - 1) * 36 + r * 3] || ROUTES_UI[r * 4 + 1] != FT_ROUTES[(factory_origin - 1) * 36 + r * 3 + 1] || abs(ROUTES_UI[r * 4 + 2] - FT_ROUTES[(factory_origin - 1) * 36 + r * 3 + 2]) > 0.0005) ? ne = 1;
      r += 1;
    );
    ne;
  ) : 0;
);

function ui_draw_header(x0, y0, w) local(px m modified base i r bank_ok nv)
(
  ui_c_text(); ui_font(1, 20); ui_text(x0, y0 + 12, "SHIRO");
  bank_ok = meta_get(active_bank, M_STATUS) === 3;
  px = x0 + 94;
  ui_button(px, y0 + 8, 280, 32, "") ? ( ui_overlay = 1; strcpy(#ui_search, ""); );
  ui_c_dim(); ui_font(2, 11); ui_text(px + 8, y0 + 11, "Preset");
  !bank_ok ? strcpy(#ui_fv, "Empty") : factory_origin <= 0 ? strcpy(#ui_fv, "User") : (
    strcpy(#ui_fv, FS_PRESET_CAT + factory_origin - 1); strcat(#ui_fv, " . "); r = strlen(#ui_fv);
    strcat(#ui_fv, FS_PRESET_NAME + factory_origin - 1);
  );
  ui_c_text(); ui_font(3, 14); ui_textbox(px + 8, y0 + 22, 240, 16, #ui_fv, 0);
  ui_button(px + 300, y0 + 8, 32, 32, "<") ? ( factory_origin > 1 ? factory_load_preset(factory_origin - 2); );
  ui_button(px + 336, y0 + 8, 32, 32, ">") ? ( factory_origin >= 1 && factory_origin < NFACTORY ? factory_load_preset(factory_origin); );
  modified = ui_is_modified();
  modified ? ( ui_c_accent(); gfx_circle(ui_dx(px + 380), ui_dy(y0 + 24), 4 * ui_s, 1, 1); );
  nv = ui_numfield(x0 + w - 188, y0 + 8, 136, 32, "Output", slider(1), -60, 6, 0, 1, 0.1, -12, 8, -1, 0);
  nv != slider(1) ? ( slider(1) = nv; slider_automate(slider(1)); ); ui_touch ? slider_automate(slider(1), 1);
  ui_button(x0 + w - 40, y0 + 8, 32, 32, "menu") ? ( ui_overlay = ui_overlay === 4 ? 0 : 4; );
);



// ==================================================================== SOURCE ROW
function ui_error_text(code)
(
  code == SE_OPEN ? strcpy(#ui_msg, "Could not open the file.")
  : code == SE_CHANNELS ? strcpy(#ui_msg, "Multichannel files are not supported: export a mono or stereo file.")
  : code == SE_TOOLONG ? strcpy(#ui_msg, "Render an excerpt of 12 seconds or less in REAPER.")
  : code == SE_TOOSHORT ? strcpy(#ui_msg, "The recording is shorter than 20 ms.")
  : code == SE_NONFINITE ? strcpy(#ui_msg, "The file contains non-finite samples.")
  : code == SE_NOBANK ? strcpy(#ui_msg, "Busy: a source is still being replaced. Try again in a moment.")
  : code == SE_READ ? strcpy(#ui_msg, "The file could not be read completely.")
  : code == SE_BUSY ? strcpy(#ui_msg, "Busy: a source is being loaded. Try again in a moment.")
  : strcpy(#ui_msg, "");
);

function ui_draw_source(x0, y0, w) local(m nv)
(
  m = meta_ptr(active_bank);
  ui_button(x0, y0 + 4, 260, 32, "") ? ( ui_overlay = 2; strcpy(#ui_search, ""); );
  ui_c_dim(); ui_font(2, 11); ui_text(x0 + 8, y0 + 7, "Source");
  meta_get(active_bank, M_STATUS) === 3 ? strcpy(#ui_fv, active_bank ? #src_name1 : #src_name0) : strcpy(#ui_fv, "(none)");
  ui_c_text(); ui_font(3, 14); ui_textbox(x0 + 8, y0 + 18, 244, 16, #ui_fv, 0);
  nv = ui_numfield(x0 + 268, y0 + 4, 90, 32, "Root", slider(6), 0, 127, 0, 1, 1, 60, 9, -1, 0);
  nv != slider(6) ? ( slider(6) = nv; slider_automate(slider(6)); ); ui_touch ? slider_automate(slider(6), 1);
  nv = ui_numfield(x0 + 366, y0 + 4, 90, 32, "Fine", slider(7), -100, 100, 0, 5, 1, 0, 7, -1, 0);
  nv != slider(7) ? ( slider(7) = nv; slider_automate(slider(7)); ); ui_touch ? slider_automate(slider(7), 1);
  ui_c_dim(); ui_font(2, 12);
  stg_status === SS_ERROR ? ( ui_error_text(stg_err); ui_c_warn(); ui_textbox(x0, y0 + 12, w, 16, #ui_msg, 2); )
  : stg_status >= SS_PYR1 && stg_status <= SS_OVERVIEW ? ( strcpy(#ui_fv2, "preparing source..."); ui_c_warn(); ui_textbox(x0, y0 + 12, w, 16, #ui_fv2, 2); )
  : stg_status === SS_PENDING ? ( ui_button(x0 + w - 200, y0 + 4, 200, 32, "pending . apply now") ? atomic_set(CMD[C_APPLY], 1); )
  : meta_get(active_bank, M_STATUS) === 3 ? ( strcpy(#ui_fv2, meta_get(active_bank, M_FACTORY) > 0 ? "ready . embedded" : "ready . embedded"); ui_c_ok(); ui_textbox(x0, y0 + 12, w, 16, #ui_fv2, 2); )
  : ( strcpy(#ui_fv2, "Drop a WAV, choose a factory source or load a file"); ui_c_dim(); ui_textbox(x0, y0 + 12, w, 16, #ui_fv2, 2); );
);

// ==================================================================== WAVEFORM
function ui_xof(f, frames, wx, ww) ( wx + (f / max(1, frames) - ui_wave_scroll) * ui_wave_zoom * ww; );

function ui_draw_waveform(x0, y0, w, h) local(m fw ov i c mn mx wx wy ww wh sw x1 x2 hx1 hx2 down v vr k rec ph life lvl st sel g0 g1 cnt take start extent dir col ex ey px py posn frac)
(
  wx = x0; wy = y0; ww = w; wh = h - 32;
  ui_c_field(); ui_rect(wx, wy, ww, wh);
  m = meta_ptr(active_bank); fw = m[M_FRAMES];
  meta_get(active_bank, M_STATUS) === 3 && fw > 0 ? (
    ov = ovw_ptr(active_bank);
    ui_col(0.20, 0.24, 0.30);
    x1 = ui_xof(reg_start_fr, fw, wx, ww); x2 = ui_xof(reg_end_fr, fw, wx, ww);
    ui_rect(max(wx, x1), wy, min(wx + ww, x2) - max(wx, x1), wh);
    ui_col(0.55, 0.75, 0.9); i = 0;
    while (i < ww) (
      frac = (i / ww) / ui_wave_zoom + ui_wave_scroll; frac < 0 ? frac = 0; frac > 1 ? frac = 1;
      c = floor(frac * 8192); c > 8191 ? c = 8191;
      mn = ov[2 * c]; mx = ov[2 * c + 1];
      ui_lineseg(wx + i, wy + wh / 2 - mx * wh / 2, wx + i, wy + wh / 2 - mn * wh / 2);
      i += 1;
    );
    // region handles
    ui_c_accent(); ui_rect(x1 - 1, wy, 2, wh); ui_rect(x2 - 1, wy, 2, wh);
    // position marker
    posn = pb_pos; px = ui_xof(reg_start_fr + posn * reg_len_fr, fw, wx, ww);
    ui_col(0.95, 0.85, 0.55); ui_rect(px - 1, wy, 2, wh);
    // scan-centre ticks per active voice + grain spans (selected voice priority, cap 48)
    ui_sel_voice = -1; v = 0;
    while (v < NVOICES) ( VOICES[v * VSTRIDE + V_ST] > 0 && (ui_sel_voice < 0 || VOICES[v * VSTRIDE + V_AGE] > VOICES[ui_sel_voice * VSTRIDE + V_AGE]) ? ui_sel_voice = v; v += 1; );
    v = 0;
    while (v < NVOICES) (
      st = VOICES[v * VSTRIDE + V_ST];
      st > 0 ? (
        ex = ui_xof(reg_start_fr + VOICES[v * VSTRIDE + V_ECENTRE] * reg_len_fr, fw, wx, ww);
        ui_c_mod(); ui_rect(ex - 1, wy, 2, 5); ui_rect(ex - 1, wy + wh - 5, 2, 5);
      );
      v += 1;
    );
    cnt = 0; v = 0; sel = ui_sel_voice;
    while (v < NVOICES && cnt < 48) (
      VOICES[v * VSTRIDE + V_ST] > 0 ? (
        take = v === sel ? 12 : 6; k = 0;
        while (k < take && k < NSLOTS && cnt < 48) (
          rec = GRAINS + (v * NSLOTS + k) * GSTRIDE;
          rec[G_ST] === 1 ? (
            lvl = rec[G_LVL]; g0 = (2 ^ lvl) * 0.5;
            start = rec[G_PH] * g0; life = max(0, rec[G_LIFE]); dir = rec[G_INC] < 0 ? -1 : 1;
            extent = abs(rec[G_INC]) * g0 * max(1, life);
            ex = ui_xof(start, fw, wx, ww); ey = ui_xof(start + dir * extent, fw, wx, ww);
            k === 0 && v === sel ? ui_col(0.98, 0.92, 0.65) : ui_c_mod();
            ui_lineseg(min(ex, ey), wy + wh - 8 - (v % 4) * 3, max(ex, ey), wy + wh - 8 - (v % 4) * 3);
            cnt += 1;
          );
          k += 1;
        );
      );
      v += 1;
    );
    // A full 32-pixel strip remains separate from the waveform edit targets.
    sw = max(32, ww - 132);
    ui_c_line(); ui_rect(wx, wy + wh, sw, 32);
    ui_c_dim(); ui_rect(wx + ui_wave_scroll * sw, wy + wh + 10, sw / ui_wave_zoom, 12);
    ui_button(wx + ww - 124, wy + wh, 32, 32, "-") ? ui_wave_zoom = max(1, ui_wave_zoom / 2);
    ui_button(wx + ww - 88, wy + wh, 32, 32, "+") ? ui_wave_zoom = min(16, ui_wave_zoom * 2);
    ui_button(wx + ww - 52, wy + wh, 52, 32, "Fit") ? ( ui_wave_zoom = 1; ui_wave_scroll = 0; );
    ui_wave_scroll = max(0, min(1 - 1 / ui_wave_zoom, ui_wave_scroll));
    // dragging: handles / position marker / scroll strip
    down = (mouse_cap & 1) && !(ui_lastcap & 1) && !ui_blocked && ui_view_hit && (ui_clip_bottom <= 0 || ui_my < ui_clip_bottom);
    down && abs(ui_mx - x1) < 16 && ui_my >= wy && ui_my < wy + wh ? ui_wave_drag = 1;
    down && abs(ui_mx - x2) < 16 && ui_my >= wy && ui_my < wy + wh && ui_wave_drag != 1 ? ui_wave_drag = 2;
    down && abs(ui_mx - px) < 16 && ui_my >= wy && ui_my < wy + wh && ui_wave_drag < 1 ? ui_wave_drag = 3;   // marker drag only inside the waveform
    down && ui_wave_drag < 1 && ui_mx > wx && ui_mx < wx + ww && ui_my >= wy && ui_my < wy + wh && (mouse_cap & 16) ? ( ui_wave_drag = 4; ui_drag_mx0 = ui_mx; );
    down && ui_wave_drag < 1 && ui_mx > wx && ui_mx < wx + sw && ui_my >= wy + wh && ui_my < wy + wh + 32 ? ( ui_wave_drag = 5; ui_drag_mx0 = ui_mx; );
    // Latch a grab anchor. Expanding a hit band must not move the sound on mouse-down.
    down && ui_wave_drag > 0 && ui_wave_drag < 5 ? (
      ui_drag_mx0 = ui_mx;
      ui_drag_val0 = ui_wave_drag === 2 ? slider(11) : ui_wave_drag === 3 ? slider(12) : slider(10);
    );
    frac = (ui_mx - ui_drag_mx0) / (ui_wave_zoom * ww) * ((mouse_cap & 8) ? 0.1 : 1);
    ui_wave_drag === 1 && (mouse_cap & 1) ? ( slider(10) = max(0, min(1, ui_drag_val0 + frac)); slider_automate(slider(10)); );
    ui_wave_drag === 2 && (mouse_cap & 1) ? ( slider(11) = max(0, min(1 - slider(10), ui_drag_val0 + frac)); slider_automate(slider(11)); );
    ui_wave_drag === 3 && (mouse_cap & 1) ? ( slider(12) = max(0, min(1, ui_drag_val0 + (reg_len_fr > 0 ? frac * fw / reg_len_fr : 0))); slider_automate(slider(12)); );
    ui_wave_drag === 4 && (mouse_cap & 1) ? ( slider(10) = max(0, min(1 - slider(11), ui_drag_val0 + frac)); slider_automate(slider(10)); );
    ui_wave_drag === 5 && (mouse_cap & 1) ? ( ui_wave_scroll = max(0, min(1 - 1 / ui_wave_zoom, ui_wave_scroll + (ui_mx - ui_drag_mx0) / sw / ui_wave_zoom)); ui_drag_mx0 = ui_mx; );
    !(mouse_cap & 1) ? ( ui_wave_drag > 0 && ui_wave_drag < 5 ? slider_automate(ui_wave_drag === 2 ? slider(11) : ui_wave_drag === 3 ? slider(12) : slider(10), 1); ui_wave_drag = 0; );
  ) : ( ui_c_dim(); ui_font(3, 14); ui_textbox(wx, wy, ww, wh, "Drop a WAV, choose a factory source or load a file", 1 | 4); );
  !ui_blocked && ui_mx > wx && ui_mx < wx + ww && ui_my >= wy && ui_my < wy + wh && ui_wheel_steps != 0 ? (
    ui_wave_zoom = max(1, min(16, ui_wave_zoom * (1 + 0.15 * ui_wheel_steps))); ui_wheel_steps = 0;
    ui_wave_scroll = max(0, min(1 - 1 / ui_wave_zoom, ui_wave_scroll));
  );
);

// ==================================================================== SCAN ROW
function ui_draw_scan(x0, y0, w) local(nv sync sc)
(
