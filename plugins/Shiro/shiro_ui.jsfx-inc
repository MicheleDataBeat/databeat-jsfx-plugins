  nv != slider(30) ? ( slider(30) = nv; slider_automate(slider(30)); ); ui_touch ? slider_automate(slider(30), 1);
  nv = ui_numfield(x0 + 2 * (colw3 + 8), y0 + 130, colw3, 32, "Source Width", slider(31), 0, 1, 0, 0.05, 0.005, 1, 3, D_WIDTH, 0);
  nv != slider(31) ? ( slider(31) = nv; slider_automate(slider(31)); ); ui_touch ? slider_automate(slider(31), 1);
  !pulse ? ( rate = min(200, pb_fill / (pb_size * 0.001)); capped = rate >= 199.9; ov = rate * pb_size * 0.001; )
  : ( rate = 1 / max(0.005, ui_pulse_beats_disp(pb_pulsediv) * 60 / max(1, cur_tempo)); capped = 0; ov = rate * pb_size * 0.001; );
  sprintf(#ui_fv2, "base rate %.0f/s . overlap %.1f%s", rate, ov, capped ? "  capped" : "");
  capped ? ui_c_warn() : ui_c_dim(); ui_font(2, 10); ui_textbox(x0 + 8, y0 + h - 18, w - 16, 16, #ui_fv2, 0);
);

function ui_draw_ampenv_mini(x0, y0, w, h) local(myslot hit a d s r tot ax ay bx by cx cy dx dy px)
(
  myslot = ui_slot; ui_slot += 1; ui_track_focus(myslot, x, y, w, h);
  hit = !ui_blocked && ui_hit(x0, y0, w, h);
  hit ? ui_sethint("Amp envelope . click to edit");
