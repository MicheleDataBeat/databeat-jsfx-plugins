  ncat = 0; k = 0;
  while (k < NFACTORY && ncat < 8) (
    found = 0; c = 0; while (c < ncat) ( strcmp(FS_PRESET_CAT + k, UI_CAT_SLOT + c) == 0 ? found = 1; c += 1; );
    !found ? ( strcpy(UI_CAT_SLOT + ncat, FS_PRESET_CAT + k); ncat += 1; );
    k += 1;
  );
  // category column: "All" then each category; click filters and rewinds the list
