// Shiro UI: the full instrument panel. UI thread only (functions ui_*),
// called once per frame as ui_frame() from @gfx 960 680 in Shiro.jsfx. Reads/writes only the interface listed
// here: TELE, active_bank/meta_get/ovw_ptr, region fields, VOICES/GRAINS (read), ROUTES_UI (via
// ui_route_edit/ui_routes_refresh), staging fields, factory tables, pb_*, sliders (via the bound indexed form
// slider(N)=v; slider_automate(slider(N))), atomic_set(CMD[...]), prep_cancel/user_load_path/factory_load_*/reset_sound,
// preset_trim/#preset_desc (deferred undo notification), ui_scale_idx/ui_drawer/ui_details.
// Never calls alloc(): all cross-frame state is plain ui_-prefixed globals; per-frame tables (focus order, hit
// rectangles) are immediate-mode (recomputed every frame from a sequential slot counter), never stored arrays.
@init

gfx_ext_retina = 1;
ui_init_done ? 0 : ( ui_focus_ix = -1; ui_nslots = 0; ui_wave_zoom = 1; ui_wave_scroll = 0; ui_pop_kind = 0; ui_pop_owner = -1; ui_drag_slot = -1; ui_press_slot = -1; ui_browser_cat = -1; ui_browser_scroll = 0; ui_init_done = 1; );
UI_CAT_SLOT = 720;   // eight numbered string slots for the preset browser's category names (factory strings end at 692)

// ==================================================================== colour tokens
function ui_col(r, g, b) ( gfx_r = r; gfx_g = g; gfx_b = b; gfx_a = 1; );
function ui_cola(r, g, b, a) ( gfx_r = r; gfx_g = g; gfx_b = b; gfx_a = a; );
function ui_c_bg() ( ui_col(0.105, 0.107, 0.115); );
function ui_c_panel() ( ui_col(0.145, 0.148, 0.158); );
function ui_c_field() ( ui_col(0.19, 0.195, 0.21); );
function ui_c_fieldhover() ( ui_col(0.23, 0.235, 0.25); );
function ui_c_line() ( ui_col(0.30, 0.31, 0.33); );
function ui_c_text() ( ui_col(0.92, 0.91, 0.88); );
function ui_c_dim() ( ui_col(0.62, 0.62, 0.60); );
function ui_c_accent() ( ui_col(0.93, 0.66, 0.30); );
function ui_c_mod() ( ui_col(0.37, 0.72, 0.78); );
function ui_c_warn() ( ui_col(1.0, 0.55, 0.45); );
function ui_c_ok() ( ui_col(0.55, 0.80, 0.55); );

// ==================================================================== low-level draw / hit helpers
function ui_dx(x) ( (x - ui_view_x) * ui_s; );
function ui_dy(y) ( (y - ui_view_y) * ui_s; );
function ui_rect(x, y, w, h) ( gfx_rect(ui_dx(x), ui_dy(y), max(1, w * ui_s), max(1, h * ui_s)); );
function ui_frame_rect(x, y, w, h) ( gfx_rect(ui_dx(x), ui_dy(y), w * ui_s, 1); gfx_rect(ui_dx(x), ui_dy(y), 1, h * ui_s); gfx_rect(ui_dx(x + w - 1), ui_dy(y), 1, h * ui_s); gfx_rect(ui_dx(x), ui_dy(y + h - 1), w * ui_s, 1); );
function ui_lineseg(x0, y0, x1, y1) ( gfx_line(ui_dx(x0), ui_dy(y0), ui_dx(x1), ui_dy(y1)); );
function ui_font(id, pt) ( gfx_setfont(id, "Arial", floor(max(13, pt) * ui_s + 0.5)); );
function ui_text(x, y, s) ( gfx_x = ui_dx(x); gfx_y = ui_dy(y); gfx_drawstr(s); );
function ui_textbox(x, y, w, h, s, flags) ( gfx_x = ui_dx(x); gfx_y = ui_dy(y); gfx_drawstr(s, flags, ui_dx(x + w), ui_dy(y + h)); );
function ui_hit(x, y, w, h) (
  ui_view_hit && (ui_clip_bottom <= 0 || (ui_my < ui_clip_bottom && (ui_scroll_max <= 0 || ui_mx < ui_w - 32)))
  && ui_mx >= x && ui_mx < x + w && ui_my >= y && ui_my < y + h;
);
function ui_track_focus(slot, x, y, w, h) (
  slot === ui_focus_ix && !ui_blocked ? (
    ui_focus_left = x; ui_focus_right = x + w; ui_focus_top = y; ui_focus_bottom = y + h;
    ui_focus_found = 1; ui_focus_scrollable = ui_clip_bottom > 0;
  );
);
function ui_round(v) ( v >= 0 ? floor(v + 0.5) : -floor(-v + 0.5); );
function ui_request_load(path) ( user_load_path(path); );

// ==================================================================== value <-> fraction / stepping
function ui_val_frac(val, mn, mx, logc) ( logc ? (log(max(0.0000001, val)) - log(mn)) / (log(mx) - log(mn)) : (val - mn) / (mx - mn); );
function ui_step_apply(val, mn, mx, logc, coarse, fine, shifted, steps) local(s v)
(
  s = shifted ? fine : coarse;
  v = logc ? val * (s ^ steps) : val + s * steps;
  v < mn ? v = mn; v > mx ? v = mx;
  v;
);
function ui_dest_transform(dest, val) ( (dest == D_SIZE || dest == D_FILL || dest == D_CUT) ? log(max(0.0000001, val)) / log(2) : dest == D_RESO ? 0.5 + 0.9 * val : val; );

// ==================================================================== names / labels (all @init-time constant text)
function ui_note_name(n) local(nn oct pc s)
(
  nn = max(0, min(127, n | 0)); oct = floor(nn / 12) - 1; pc = nn - floor(nn / 12) * 12;
  pc == 0 ? s = "C" : pc == 1 ? s = "C#" : pc == 2 ? s = "D" : pc == 3 ? s = "D#" : pc == 4 ? s = "E" : pc == 5 ? s = "F"
  : pc == 6 ? s = "F#" : pc == 7 ? s = "G" : pc == 8 ? s = "G#" : pc == 9 ? s = "A" : pc == 10 ? s = "A#" : s = "B";
  sprintf(#ui_fv, "%s%d (%d)", s, oct, nn);
);

function ui_dest_name(d) (
  d == 0 ? strcpy(#ui_fv, "Position") : d == 1 ? strcpy(#ui_fv, "Scan Speed") : d == 2 ? strcpy(#ui_fv, "Size")
  : d == 3 ? strcpy(#ui_fv, "Fill") : d == 4 ? strcpy(#ui_fv, "Timing Variation") : d == 5 ? strcpy(#ui_fv, "Position Scatter")
  : d == 6 ? strcpy(#ui_fv, "Pitch Spread") : d == 7 ? strcpy(#ui_fv, "Shape") : d == 8 ? strcpy(#ui_fv, "Pan")
  : d == 9 ? strcpy(#ui_fv, "Pan Spread") : d == 10 ? strcpy(#ui_fv, "Source Width") : d == 11 ? strcpy(#ui_fv, "Cutoff")
  : d == 12 ? strcpy(#ui_fv, "Resonance") : strcpy(#ui_fv, "Voice Pitch");
);
function ui_dest_name_short(d) (
  d == 0 ? strcpy(#ui_fv, "Position") : d == 1 ? strcpy(#ui_fv, "Scan") : d == 2 ? strcpy(#ui_fv, "Size")
  : d == 3 ? strcpy(#ui_fv, "Fill") : d == 4 ? strcpy(#ui_fv, "Tim.Var") : d == 5 ? strcpy(#ui_fv, "Scatter")
  : d == 6 ? strcpy(#ui_fv, "Pitch Spr") : d == 7 ? strcpy(#ui_fv, "Shape") : d == 8 ? strcpy(#ui_fv, "Pan")
  : d == 9 ? strcpy(#ui_fv, "Pan Spr") : d == 10 ? strcpy(#ui_fv, "Width") : d == 11 ? strcpy(#ui_fv, "Cutoff")
  : d == 12 ? strcpy(#ui_fv, "Reso") : strcpy(#ui_fv, "V.Pitch");
);
function ui_src_name(s) (
  s == 1 ? strcpy(#ui_fv, "Env") : s == 2 ? strcpy(#ui_fv, "LFO 1") : s == 3 ? strcpy(#ui_fv, "LFO 2")
  : s == 4 ? strcpy(#ui_fv, "Random") : s == 5 ? strcpy(#ui_fv, "Velocity") : s == 6 ? strcpy(#ui_fv, "Pressure")
  : s == 7 ? strcpy(#ui_fv, "Wheel") : s == 8 ? strcpy(#ui_fv, "Key Track") : s == 9 ? strcpy(#ui_fv, "Body")
  : s == 10 ? strcpy(#ui_fv, "Motion") : s == 11 ? strcpy(#ui_fv, "Colour") : strcpy(#ui_fv, "Space");
);

function ui_enum_count(t) ( t == 1 ? 3 : t == 2 ? 11 : t == 3 ? 10 : t == 4 ? 4 : t == 5 ? 3 : t == 6 ? 2 : t == 7 ? 17 : 1; );
function ui_enum_label(t, i) local()
(
  t == 1 ? ( i == 0 ? strcpy(#ui_fv, "Wrap") : i == 1 ? strcpy(#ui_fv, "Reflect") : strcpy(#ui_fv, "End Hold"); )
  : t == 2 ? (
    i == 0 ? strcpy(#ui_fv, "1/4 beat") : i == 1 ? strcpy(#ui_fv, "1/2 beat") : i == 2 ? strcpy(#ui_fv, "1 beat")
    : i == 3 ? strcpy(#ui_fv, "2 beats") : i == 4 ? strcpy(#ui_fv, "4 beats") : i == 5 ? strcpy(#ui_fv, "8 beats")
    : i == 6 ? strcpy(#ui_fv, "16 beats") : i == 7 ? strcpy(#ui_fv, "32 beats") : i == 8 ? strcpy(#ui_fv, "64 beats")
    : i == 9 ? strcpy(#ui_fv, "128 beats") : strcpy(#ui_fv, "256 beats");
  )
  : t == 3 ? (
    i == 0 ? strcpy(#ui_fv, "1/16 beat") : i == 1 ? strcpy(#ui_fv, "1/8 beat") : i == 2 ? strcpy(#ui_fv, "1/6 beat")
    : i == 3 ? strcpy(#ui_fv, "1/4 beat") : i == 4 ? strcpy(#ui_fv, "1/3 beat") : i == 5 ? strcpy(#ui_fv, "1/2 beat")
    : i == 6 ? strcpy(#ui_fv, "3/4 beat") : i == 7 ? strcpy(#ui_fv, "1 beat") : i == 8 ? strcpy(#ui_fv, "2 beats")
    : strcpy(#ui_fv, "4 beats");
  )
  : t == 4 ? ( i == 0 ? strcpy(#ui_fv, "Continuous") : i == 1 ? strcpy(#ui_fv, "Chromatic") : i == 2 ? strcpy(#ui_fv, "Octaves") : strcpy(#ui_fv, "Open Fifths"); )
  : t == 5 ? ( i == 0 ? strcpy(#ui_fv, "Sine") : i == 1 ? strcpy(#ui_fv, "Triangle") : strcpy(#ui_fv, "Square"); )
  : t == 6 ? ( i == 0 ? strcpy(#ui_fv, "Free") : strcpy(#ui_fv, "Transport"); )
  : t == 7 ? ( i == 0 ? strcpy(#ui_fv, "Omni") : sprintf(#ui_fv, "%d", i); )
  : strcpy(#ui_fv, "?");
);
function ui_pulse_beats_disp(idx) ( idx == 0 ? 1/16 : idx == 1 ? 1/8 : idx == 2 ? 1/6 : idx == 3 ? 0.25 : idx == 4 ? 1/3 : idx == 5 ? 0.5 : idx == 6 ? 0.75 : idx == 7 ? 1 : idx == 8 ? 2 : 4; );

// Native JSFX menus are host-clamped and keyboard-navigable, including tall lists at enlarged UI scales.
// https://www.reaper.fm/sdk/js/gfx.php (gfx_showmenu, REAPER 4.76+).
function ui_choose(kind, enumtype, selected, srcid, x, y) local(i n choice patch_before routes_before source_before)
(
  n = kind === 1 ? ui_enum_count(enumtype) : kind === 2 ? 12 : 14;
  strcpy(#ui_menu_text, ""); i = 0;
  while (i < n) (
    i > 0 ? strcat(#ui_menu_text, "|");
    kind === 1 ? ui_enum_label(enumtype, i) : kind === 2 ? ui_src_name(i + 1) : ui_dest_name(i);
    i === selected ? strcat(#ui_menu_text, "!");
    kind === 3 && i === D_VPITCH && srcid >= 9 ? strcat(#ui_menu_text, "#");
    strcat(#ui_menu_text, #ui_fv); i += 1;
  );
  gfx_x = min(gfx_w - 1, max(0, ui_dx(x))); gfx_y = min(gfx_h - 1, max(0, ui_dy(y)));
  patch_before = patch_applied_gen; routes_before = CMD[C_ROUTES_GEN]; source_before = active_gen;
  // Native menus pump host callbacks: save can reenter @serialize before this call returns.
  // Release ownership for the modal wait, then reclaim it before any UI mutation resumes.
  ui_popup_active = 1;
  atomic_set(transfer_gate, 0);
  choice = gfx_showmenu(#ui_menu_text);
  atomic_set(ui_resume_claim, 1); // audio finishes its current transfer but starts no new one
  while (atomic_setifequal(transfer_gate, 0, 1) != 0) ( 0; );
  atomic_set(ui_resume_claim, 0);
  ui_popup_active = 0;
  // A selection made for an older patch must not mutate a newly adopted patch or route row.
  patch_before != patch_applied_gen || routes_before != CMD[C_ROUTES_GEN] || source_before != active_gen ? (
    choice = 0; ui_routes_refresh();
  );
  ui_drag_slot = -1; ui_press_slot = -1;
  choice;
);

// ==================================================================== value formatting (one sprintf per drawn value)
function ui_fmt(kind, val) (
  kind == 0 ? sprintf(#ui_fv, "%.2f", val)
  : kind == 1 ? sprintf(#ui_fv, "%.0f ms", val)
  : kind == 2 ? ( val >= 1000 ? sprintf(#ui_fv, "%.2f kHz", val / 1000) : sprintf(#ui_fv, "%.0f Hz", val); )
  : kind == 3 ? sprintf(#ui_fv, "%.0f %%", val * 100)
  : kind == 4 ? sprintf(#ui_fv, "%+.0f %%", val * 100)
  : kind == 5 ? sprintf(#ui_fv, "%+d st", val | 0)
  : kind == 6 ? sprintf(#ui_fv, "%+.1f st", val)
  : kind == 7 ? sprintf(#ui_fv, "%+d c", val | 0)
  : kind == 8 ? sprintf(#ui_fv, "%+.1f dB", val)
  : kind == 9 ? ui_note_name(val)
  : kind == 10 ? sprintf(#ui_fv, "Q %.2f", 0.5 + 0.9 * val)
  : kind == 11 ? ( val >= 1000 ? sprintf(#ui_fv, "%.2f s", val / 1000) : sprintf(#ui_fv, "%.0f ms", val); )
  : kind == 12 ? sprintf(#ui_fv, "%.3f Hz", val)
  : kind == 13 ? sprintf(#ui_fv, "%.2f src s/s", val)
  : kind == 14 ? sprintf(#ui_fv, "%d", val | 0)
  : sprintf(#ui_fv, "%.2f", val);
);

// ==================================================================== interaction plumbing
function ui_is_dclick(slot) local(r)
(
  r = (time_precise() - ui_click_time < 0.45) && ui_click_slot == slot;
  ui_click_time = time_precise(); ui_click_slot = slot;
  r;
);
function ui_focus_ring(x, y, w, h) ( ui_c_accent(); ui_frame_rect(x, y, w, h); );
function ui_sethint(label) ( ui_hover_active = 1; strcpy(#ui_hint, label); );

// ==================================================================== generic field widgets
// Numeric field: drag (up/right = increase), wheel, dbl-click reset, typed entry (Enter), keyboard adjust.
// Validate in the UI before publishing, so rejected edits keep their previous source/destination/depth.
function ui_route_write(slot, src, dst, depth) local(i count ok)
(
  count = 0; i = 0;
  while (i < NROUTES) ( i != slot && ROUTES_UI[i * 4] > 0 && ROUTES_UI[i * 4 + 1] === dst ? count += 1; i += 1; );
  ok = src === 0 || (src >= 1 && src <= 12 && dst >= 1 && dst <= 14 && count < 2 && !(src >= 9 && dst === 14));
  ok ? ui_route_edit(slot, src, dst, depth) : (
    ui_warn_flash_t = time_precise();
    src >= 9 && dst === 14 ? strcpy(#ui_warn_msg, "Macros cannot change Voice Pitch.") : strcpy(#ui_warn_msg, "Two routes per destination.");
  );
  ok;
);
function ui_route_first_free() local(r f) ( f = -1; r = 0; while (r < NROUTES && f < 0) ( ROUTES_UI[r * 4] === 0 ? f = r; r += 1; ); f; );
function ui_route_create(src, dst) local(slot)
(
  slot = ui_route_first_free();
  slot >= 0 ? ( ui_route_write(slot, src, dst, 0.5); ui_pending_slot = slot; ui_pending_src = src; ui_pending_dst = dst; ui_pending_check = 8; )
  : ( ui_warn_flash_t = time_precise(); strcpy(#ui_warn_msg, "No free route slots."); );
);

function ui_src_matches_selected(dest) local(srcid r found)
(
  srcid = ui_ov_source === 1 ? 1 : ui_ov_source === 2 ? 2 : ui_ov_source === 3 ? 3 : ui_ov_source === 4 ? 4 : -1;
  srcid < 0 ? 0 : (
    found = 0; r = 0;
    while (r < NROUTES) ( ROUTES_UI[r * 4] === srcid && ROUTES_UI[r * 4 + 1] === dest + 1 ? found = 1; r += 1; );
    found;
  );
);

function ui_numfield(x, y, w, h, label, val, mn, mx, logc, coarse, fine, deflt, fmtkind, dest, dim) local(myslot hit isfocus isdown shiftheld dx dy steps frac sum spanv basefrac lo hi barh i rr effv eff rowhit clickedout n)
(
  myslot = ui_slot; ui_slot += 1; ui_track_focus(myslot, x, y, w, h);
  ui_touch = 0;
  hit = !ui_blocked && ui_hit(x, y, w, h);
  hit ? ui_sethint(label);
  isfocus = (myslot === ui_focus_ix);
  isdown = hit && (mouse_cap & 1) && !(ui_lastcap & 1);
  isdown ? (
    ui_is_dclick(myslot) ? ( val = deflt; ui_touch = 1; )
    : ( ui_drag_slot = myslot; ui_drag_val0 = val; ui_drag_mx0 = ui_mx; ui_drag_my0 = ui_my; ui_focus_ix = myslot; );
  );
  ui_drag_slot === myslot ? (
    shiftheld = (mouse_cap & 8) != 0;
    dx = ui_mx - ui_drag_mx0; dy = ui_drag_my0 - ui_my;
    steps = ui_round((dx + dy) / 4);
    steps != 0 ? val = ui_step_apply(ui_drag_val0, mn, mx, logc, coarse, fine, shiftheld, steps);
    !(mouse_cap & 1) ? ( ui_drag_slot = -1; ui_touch = 1; );
  );
  hit && ui_wheel_steps != 0 ? ( val = ui_step_apply(val, mn, mx, logc, coarse, fine, (mouse_cap & 8) != 0, ui_wheel_steps); ui_touch = 1; ui_wheel_steps = 0; );
  hit && (mouse_cap & 2) && !(ui_lastcap & 2) && dest >= 0 ? (
    n = ui_choose(2, 0, -1, 0, x, y + h);
    n > 0 ? ( ui_route_create(n, dest + 1); ui_undo_pending = 1; );
  );
  isfocus && !ui_blocked && !ui_edit_active ? (
    ui_key_left ? ( val = ui_step_apply(val, mn, mx, logc, coarse, fine, ui_key_shift, -1); ui_touch = 1; ui_key_left = 0; );
    ui_key_right ? ( val = ui_step_apply(val, mn, mx, logc, coarse, fine, ui_key_shift, 1); ui_touch = 1; ui_key_right = 0; );
    ui_key_up ? ( val = ui_step_apply(val, mn, mx, logc, coarse, fine, ui_key_shift, 1); ui_touch = 1; ui_key_up = 0; );
    ui_key_down ? ( val = ui_step_apply(val, mn, mx, logc, coarse, fine, ui_key_shift, -1); ui_touch = 1; ui_key_down = 0; );
    ui_key_enter ? ( ui_edit_active = 1; ui_edit_owner = myslot; ui_edit_selected = 1; ui_edit_commit = 0; sprintf(#ui_edit_text, "%.4f", val); ui_key_enter = 0; );
  );
  // edit commit (Enter typed above, or clicked from an active edit) handled centrally at frame top for this slot
  ui_edit_active && ui_edit_owner === myslot && ui_edit_commit ? ( match("%f", #ui_edit_text, val) ? 0 : 0; (fmtkind === 5 || fmtkind === 7 || fmtkind === 9 || fmtkind === 14) ? val = ui_round(val); val < mn ? val = mn; val > mx ? val = mx; ui_touch = 1; ui_edit_active = 0; ui_edit_commit = 0; );
  ui_edit_active && ui_edit_owner === myslot && !hit && (mouse_cap & 1) && !(ui_lastcap & 1) ? ( ui_edit_active = 0; );
  // chrome
  dim ? ui_col(0.145, 0.148, 0.158) : (hit ? ui_c_fieldhover() : ui_c_field());
  ui_rect(x, y, w, h);
  (dest >= 0 && ui_ov_source >= 1 && ui_ov_source <= 5 && ui_src_matches_selected(dest)) ? ( ui_c_mod(); ui_frame_rect(x, y, w, h); ) : isfocus && !ui_blocked ? ui_focus_ring(x, y, w, h);
  ui_c_dim(); ui_font(2, 11); ui_text(x + 6, y + 3, label);
  // base bar
  frac = ui_val_frac(val, mn, mx, logc); frac < 0 ? frac = 0; frac > 1 ? frac = 1;
  barh = 3; dim ? ui_col(0.4, 0.35, 0.25) : ui_c_accent(); ui_rect(x + 2, y + h - barh - 2, (w - 4) * frac, barh);
  dest >= 0 ? (
    sum = 0; i = 0;
    while (i < NROUTES) ( ROUTES_UI[i * 4 + 1] === dest + 1 ? sum += abs(ROUTES_UI[i * 4 + 2]); i += 1; );
    spanv = DSPAN[dest * 4 + 2] / max(0.000001, DSPAN[dest * 4 + 1] - DSPAN[dest * 4]);
    sum > 0.0005 ? (
      lo = max(0, frac - sum * spanv); hi = min(1, frac + sum * spanv);
      ui_c_mod(); ui_rect(x + 2 + (w - 4) * lo, y + h - barh - 6, (w - 4) * max(0, hi - lo), 2);
    );
    ui_sel_voice >= 0 && VOICES[ui_sel_voice * VSTRIDE + V_ST] > 0 ? (
      effv = VOICES[ui_sel_voice * VSTRIDE + V_CF + dest];
      eff = (effv - DSPAN[dest * 4]) / max(0.0001, DSPAN[dest * 4 + 1] - DSPAN[dest * 4]); eff < 0 ? eff = 0; eff > 1 ? eff = 1;
      ui_c_mod(); ui_rect(x + 2 + (w - 4) * eff, y + h - barh - 7, 1, barh + 5);
    );
  );
  ui_edit_active && ui_edit_owner === myslot ? (
    ui_col(1, 1, 1); ui_font(3, 15); ui_textbox(x + 6, y + 15, w - 12, 16, #ui_edit_text, 0);
  ) : (
    ui_fmt(fmtkind, val);
    dim ? ui_c_dim() : ui_c_text(); ui_font(3, 15); ui_textbox(x + 6, y + 15, w - 12, 16, #ui_fv, 0);
  );
  val;
);

function ui_togglefield(x, y, w, h, label, val, lbl0, lbl1, deflt, dim) local(myslot hit isdown isfocus)
(
  myslot = ui_slot; ui_slot += 1; ui_track_focus(myslot, x, y, w, h);
  ui_touch = 0;
  hit = !ui_blocked && ui_hit(x, y, w, h);
  hit ? ui_sethint(label);
  isfocus = (myslot === ui_focus_ix);
  isdown = hit && (mouse_cap & 1) && !(ui_lastcap & 1);
  isdown ? (
    ui_is_dclick(myslot) ? val = deflt : ( val = val > 0.5 ? 0 : 1; ui_focus_ix = myslot; );
    ui_touch = 1;
  );
  isfocus && !ui_blocked && !ui_edit_active && ui_key_enter ? ( val = val > 0.5 ? 0 : 1; ui_touch = 1; ui_key_enter = 0; );
  val > 0.5 ? (dim ? ui_col(0.35, 0.30, 0.20) : ui_c_accent()) : (dim ? ui_col(0.145, 0.148, 0.158) : ui_c_field());
  ui_rect(x, y, w, h);
  isfocus && !ui_blocked ? ui_focus_ring(x, y, w, h);
  h < 32 || strlen(label) == 0 ? (
    val > 0.5 ? ui_col(0.08, 0.08, 0.08) : ui_c_text(); ui_font(3, 13);
    ui_textbox(x, y, w, h, val > 0.5 ? lbl1 : lbl0, 1 | 4);
  ) : (
    val > 0.5 ? ui_col(0.08, 0.08, 0.08) : ui_c_dim(); ui_font(2, 13); ui_text(x + 6, y + 3, label);
    val > 0.5 ? ui_col(0.08, 0.08, 0.08) : ui_col(0.95, 0.95, 0.93); ui_font(3, 14);
    ui_textbox(x + 6, y + 16, w - 12, 16, val > 0.5 ? lbl1 : lbl0, 0);
  );
  val;
);

function ui_enumfield(x, y, w, h, label, val, enumtype, deflt, dim) local(myslot hit isdown isfocus n i rowhit clickedout)
(
  myslot = ui_slot; ui_slot += 1; ui_track_focus(myslot, x, y, w, h);
  ui_touch = 0;
  n = ui_enum_count(enumtype);
  hit = !ui_blocked && ui_hit(x, y, w, h);
  hit ? ui_sethint(label);
  isfocus = (myslot === ui_focus_ix);
  isdown = hit && (mouse_cap & 1) && !(ui_lastcap & 1);
  isdown ? ui_focus_ix = myslot;
  // Left click opens the list (owner ruling, 2026-09-18). It used to only take focus, so a field that
  // draws a dropdown chevron did nothing under the button everyone reaches for first, and looked as dead
  // as the unbound sliders did. Right click and Enter still open it. `deflt` is kept for the signature
  // and for callers' documentation: double-click-to-default is unreachable now, because the first click
  // raises a modal menu that swallows the second.
  isdown || (hit && (mouse_cap & 2) && !(ui_lastcap & 2)) || (isfocus && !ui_blocked && !ui_edit_active && ui_key_enter) ? (
    i = ui_choose(1, enumtype, val + 0, 0, x, y + h);
    i > 0 ? ( val = i - 1; ui_touch = 1; ); ui_key_enter = 0;
  );
  isfocus && !ui_blocked && !ui_edit_active ? (
    ui_key_left ? ( val = (val - 1 + n) % n; ui_touch = 1; ui_key_left = 0; );
    ui_key_right ? ( val = (val + 1) % n; ui_touch = 1; ui_key_right = 0; );
  );
  dim ? ui_col(0.145, 0.148, 0.158) : (hit ? ui_c_fieldhover() : ui_c_field());
  ui_rect(x, y, w, h);
