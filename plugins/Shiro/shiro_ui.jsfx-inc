// One compact list exposes every route, including MIDI and the four macros; no new modulation sources.
function ui_draw_routes() local(x y w h rows i by src dst dep nv chosen maxscroll)
(
  w = min(ui_w - 40, 720); h = min(ui_h - 40, 560); x = (ui_w - w) / 2; y = 20;
  ui_c_panel(); ui_rect(x, y, w, h); ui_c_line(); ui_frame_rect(x, y, w, h);
  ui_c_text(); ui_font(1, 16); ui_text(x + 12, y + 8, "Modulation routes");
  rows = max(1, floor((h - 96) / 40)); maxscroll = max(0, NROUTES - rows);
  ui_wheel_steps != 0 && ui_hit(x, y + 36, w - 160, h - 90) ? ( ui_route_scroll -= ui_wheel_steps; ui_wheel_steps = 0; );
  ui_route_scroll = max(0, min(maxscroll, ui_route_scroll));
  i = ui_route_scroll; by = y + 36;
  while (i < NROUTES && i < ui_route_scroll + rows) (
    src = ROUTES_UI[i * 4]; dst = ROUTES_UI[i * 4 + 1]; dep = ROUTES_UI[i * 4 + 2];
    src > 0 ? ui_src_name(src) : strcpy(#ui_fv, "+ Source");
    ui_button(x + 12, by, 140, 32, #ui_fv) ? (
      chosen = ui_choose(2, 0, src - 1, 0, x + 12, by + 32);
      chosen > 0 ? ( dst <= 0 || (dst === 14 && chosen >= 9) ? dst = 1; ui_route_write(i, chosen, dst, dep); ui_undo_pending = 1; );
    );
    src > 0 ? (
      ui_dest_name(dst - 1);
      ui_button(x + 160, by, w - 340, 32, #ui_fv) ? (
        chosen = ui_choose(3, 0, dst - 1, src + 0, x + 160, by + 32);
        chosen > 0 ? ( ui_route_write(i, src, chosen, dep); ui_undo_pending = 1; );
      );
      nv = ui_numfield(x + w - 172, by, 108, 32, "Depth", dep + 0, -1, 1, 0, 0.05, 0.005, 0, 4, -1, 0);
      nv != dep ? ui_route_write(i, src, dst, nv); ui_touch ? ui_undo_pending = 1;
      ui_button(x + w - 56, by, 40, 32, "X") ? ( ui_route_write(i, 0, 0, 0); ui_undo_pending = 1; );
    );
    by += 40; i += 1;
  );
  ui_button(x + 12, y + h - 48, 72, 32, "Prev") ? ui_route_scroll = max(0, ui_route_scroll - rows);
  ui_button(x + 92, y + h - 48, 72, 32, "Next") ? ui_route_scroll = min(maxscroll, ui_route_scroll + rows);
  ui_button(x + w - 90, y + h - 48, 78, 32, "Close") ? ( ui_overlay = 0; ui_edit_active = 0; );
  ui_view_hit && (mouse_cap & 1) && !(ui_lastcap & 1) && !ui_hit(x, y, w, h) ? ( ui_overlay = 0; ui_edit_active = 0; );
);

