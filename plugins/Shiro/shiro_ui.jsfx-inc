    ui_edit_active = 1; ui_edit_owner = -4; ui_edit_selected = 1; ui_edit_commit = 0;
    strcpy(#ui_edit_text, #ui_search); ui_browser_scroll = 0;
  );
  strcpy(#ui_pat, "*"); strcat(#ui_pat, #ui_search); strcat(#ui_pat, "*");
  NFACTORY === 0 ? ( ui_c_dim(); ui_font(3, 13); ui_text(col2, y + 72, "No factory presets are installed yet."); )
  : (
    rows = floor((y + h - 30 - (y + 72)) / 32);
    // wheel over the list scrolls it
