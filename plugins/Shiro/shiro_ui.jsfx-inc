    n = NFACTORY; by = y + 72; i = 0; skipped = 0; shown = 0; matched = 0;
    while (i < n) (
      selcat = ui_browser_cat < 0 || strcmp(FS_PRESET_CAT + i, UI_CAT_SLOT + ui_browser_cat) == 0;
      selcat && (!strlen(#ui_search) || matchi(#ui_pat, FS_PRESET_NAME + i)) ? (
        matched += 1; skipped < ui_browser_scroll ? skipped += 1 : shown < rows ? (
          strcpy(#ui_fv, FS_PRESET_NAME + i);
          ui_rowbutton(col2, by, x + w - 12 - col2, 32, #ui_fv) ? ( factory_load_preset(i); ui_overlay = 0; );
          (i + 1) === factory_origin ? ( ui_c_accent(); ui_rect(col2 + 2, by + 2, 3, 28); );
          by += 32; shown += 1;
        );
      );
      i += 1;
    );
  );
  ui_button(col2, y + h - 44, 64, 32, "Prev") ? ui_browser_scroll = max(0, ui_browser_scroll - rows);
  ui_button(col2 + 72, y + h - 44, 64, 32, "Next") ? ui_browser_scroll = min(max(0, matched - rows), ui_browser_scroll + rows);
  ui_button(x + w - 90, y + h - 44, 78, 32, "Close") ? ui_overlay = 0;
  !ui_blocked && ui_view_hit && (mouse_cap & 1) && !(ui_lastcap & 1) && !(ui_mx >= x && ui_mx < x + w && ui_my >= y && ui_my < y + h) ? ui_overlay = 0;
);

