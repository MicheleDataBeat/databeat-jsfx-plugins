  hit && (mouse_cap & 1) && !(ui_lastcap & 1) ? ( ui_ov_source = 7; ui_drawer = 1; ui_focus_ix = myslot; );
  ui_c_dim(); ui_font(2, 11); ui_text(x0 + 6, y0 + 2, "Amp envelope");
  a = slider(32); d = slider(33); s = slider(34); r = slider(35); tot = max(1, a + d + r);
  px = x0 + 4; ax = px; ay = y0 + h - 2;
  bx = px + w * 0.3 * a / tot; by = y0 + 4;
  cx = bx + w * 0.3 * d / tot; cy = y0 + 4 + (1 - s) * (h - 8);
  dx = x0 + w - 6; dy = cy;
  ui_c_accent();
  ui_lineseg(ax, ay, bx, by); ui_lineseg(bx, by, cx, cy); ui_lineseg(cx, cy, dx, dy); ui_lineseg(dx, dy, x0 + w - 2, y0 + h - 2);
);

