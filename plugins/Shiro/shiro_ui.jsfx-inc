);

// ==================================================================== keyboard input
// Process every text event in queue order; UTF-8 is stored in EEL2 strings, with a byte-bounded edit buffer.
function ui_edit_codepoint(cp) local(n)
(
  ui_edit_selected ? ( strcpy(#ui_edit_text, ""); ui_edit_selected = 0; );
  strcpy(#ui_edit_tmp, "");
  cp < 128 ? sprintf(#ui_edit_tmp, "%c", cp)
  : cp < 2048 ? sprintf(#ui_edit_tmp, "%c%c", 192 | (cp >> 6), 128 | (cp & 63))
  : cp < 65536 ? sprintf(#ui_edit_tmp, "%c%c%c", 224 | (cp >> 12), 128 | ((cp >> 6) & 63), 128 | (cp & 63))
  : sprintf(#ui_edit_tmp, "%c%c%c%c", 240 | (cp >> 18), 128 | ((cp >> 12) & 63), 128 | ((cp >> 6) & 63), 128 | (cp & 63));
  n = ui_edit_owner === -5 ? 4096 : ui_edit_owner === -3 ? 512 : 128;
  strlen(#ui_edit_text) + strlen(#ui_edit_tmp) <= n ? strcat(#ui_edit_text, #ui_edit_tmp);
);
function ui_edit_key(c) local(n cp)
(
  c === 1 ? ui_edit_selected = 1
  : c === 8 ? (
    ui_edit_selected ? ( strcpy(#ui_edit_text, ""); ui_edit_selected = 0; ) : (
      n = strlen(#ui_edit_text); n > 0 ? (
        n -= 1; while (n > 0 && (str_getchar(#ui_edit_text, n) & 192) === 128) ( n -= 1; );
        strcpy_substr(#ui_edit_tmp, #ui_edit_text, 0, n); strcpy(#ui_edit_text, #ui_edit_tmp);
      );
    );
  )
  : c === 13 ? ui_edit_commit = 1
  : c === 27 ? ( ui_edit_active = 0; ui_edit_commit = 0; )
  : c === 22 ? ( ui_warn_flash_t = time_precise(); strcpy(#ui_warn_msg, "Clipboard unavailable in JSFX: type a path or drop the WAV."); )
  : c >= 32 && c < 127 ? ui_edit_codepoint(c)
  : (c >> 24) === 'u' ? ( cp = c & 16777215; cp <= 1114111 ? ui_edit_codepoint(cp); );
);
function ui_read_keys() local(c n)
(
  ui_key_tab = 0; ui_key_shifttab = 0; ui_key_left = 0; ui_key_right = 0; ui_key_up = 0; ui_key_down = 0;
  ui_key_enter = 0; ui_key_space = 0; ui_key_shift = (mouse_cap & 8) != 0;
  c = gfx_getchar(); n = 0;
  while (c > 0 && n < 4096) (
    ui_edit_active ? ui_edit_key(c)
    : c === 9 ? ( ui_key_shift ? ui_key_shifttab = 1 : ui_key_tab = 1; )
    : c === 'left' ? ui_key_left = 1
    : c === 'rght' ? ui_key_right = 1
    : c === 'up' ? ui_key_up = 1
    : c === 'down' ? ui_key_down = 1
    : c === 13 ? ui_key_enter = 1
    : c === 27 ? ( ui_overlay = 0; ui_focus_ix = -1; );
    n += 1; c = gfx_getchar();
  );
);
function ui_service_edit() (
  ui_edit_active && ui_edit_commit ? (
    ui_edit_owner === -3 ? ( strcpy(#preset_desc, #ui_edit_text); ui_undo_pending = 1; ui_edit_active = 0; ui_edit_commit = 0; )
    : ui_edit_owner === -4 ? ( strcpy(#ui_search, #ui_edit_text); ui_browser_scroll = 0; ui_edit_active = 0; ui_edit_commit = 0; )
    : ui_edit_owner === -5 ? ( strcpy(#ui_path, #ui_edit_text); strlen(#ui_path) ? ui_request_load(#ui_path); ui_edit_active = 0; ui_overlay = 0; ui_edit_commit = 0; );
  );
);

// Viewport bars only appear when the host area is smaller than the minimum logical canvas.
// They reserve 32 logical pixels and never write a sound parameter or host undo point.
function ui_draw_viewport() local(down track thumb span)
(
  down = (mouse_cap & 1) && !(ui_lastcap & 1);
  down && ui_phys_my >= ui_view_h && ui_view_maxx > 0 ? ui_view_drag = 1;
  down && ui_phys_mx >= ui_view_w && ui_view_maxy > 0 ? ui_view_drag = 2;
  ui_view_maxx > 0 ? (
    track = ui_view_w; thumb = max(32, track * ui_view_w / ui_w); span = max(1, track - thumb);
    ui_c_field(); gfx_rect(0, ui_view_h * ui_s, ui_phys_w * ui_s, 32 * ui_s);
    ui_c_dim(); gfx_rect(ui_view_x / ui_view_maxx * span * ui_s, (ui_view_h + 8) * ui_s, thumb * ui_s, 16 * ui_s);
    ui_view_drag === 1 && (mouse_cap & 1) ? ui_view_x = max(0, min(ui_view_maxx, (ui_phys_mx - thumb / 2) / span * ui_view_maxx));
  );
  ui_view_maxy > 0 ? (
    track = ui_view_h; thumb = max(32, track * ui_view_h / ui_h); span = max(1, track - thumb);
    ui_c_field(); gfx_rect(ui_view_w * ui_s, 0, 32 * ui_s, ui_phys_h * ui_s);
    ui_c_dim(); gfx_rect((ui_view_w + 8) * ui_s, ui_view_y / ui_view_maxy * span * ui_s, 16 * ui_s, thumb * ui_s);
    ui_view_drag === 2 && (mouse_cap & 1) ? ui_view_y = max(0, min(ui_view_maxy, (ui_phys_my - thumb / 2) / span * ui_view_maxy));
  );
  !(mouse_cap & 1) ? ui_view_drag = 0;
);

// ==================================================================== top-level frame
function ui_frame_impl() local(n dropped OY LWv wave_h card_h drawer_h y_header y_source y_wave y_scan y_cards y_motion y_drawer y_macros y_footer content_h)
(
  // mandatory first: idle servicing (also runs with the editor closed under gfx_idle)
  stg_status >= SS_PYR1 && stg_status <= SS_OVERVIEW && !stg_sync ? prep_step();   // never while the audio thread runs a synchronous load
  stg_status === SS_PENDING && src_committed_flag ? ( src_committed_flag = 0; stg_status = SS_IDLE; );
  gfx_ext_flags & 2 ? 0 : (
    n = 0; dropped = 0;
    while (gfx_getdropfile(n, #dropfile)) ( n === 0 ? ( strcpy(#ui_path, #dropfile); dropped = 1; ); n += 1; );
    gfx_getdropfile(-1);
    dropped && !match("@fx:*", #ui_path) ? ui_request_load(#ui_path);

    CMD[C_ROUTES_GEN] != ui_routes_gen_seen ? ui_routes_refresh();
    ui_pending_check > 0 ? ( ui_pending_check -= 1; ui_pending_check === 0 ? ( (ROUTES_UI[ui_pending_slot * 4] != ui_pending_src || ROUTES_UI[ui_pending_slot * 4 + 1] != ui_pending_dst) ? ( ui_warn_flash_t = time_precise(); strcpy(#ui_warn_msg, "Two routes per destination."); ); ); );

    ui_zoom = ui_host_sliders > 0 ? 1 : ui_scale_idx === 0 ? 1 : ui_scale_idx === 1 ? 1.25 : ui_scale_idx === 2 ? 1.5 : 2;
    ui_s = ui_zoom * max(1, gfx_ext_retina);
    ui_phys_w = gfx_w / ui_s; ui_phys_h = gfx_h / ui_s;
    ui_min_w = ui_host_sliders > 0 ? 380 : 800; ui_min_h = ui_host_sliders > 0 ? 96 : 600;
    ui_view_w = ui_phys_w; ui_view_h = ui_phys_h;
    ui_view_w < ui_min_w ? ui_view_h -= 32;
    ui_view_h < ui_min_h ? ui_view_w -= 32;
    ui_view_w < ui_min_w && ui_view_h === ui_phys_h ? ui_view_h -= 32;
    ui_view_w = max(32, ui_view_w); ui_view_h = max(32, ui_view_h);
    ui_w = max(ui_min_w, ui_view_w); ui_h = max(ui_min_h, ui_view_h);
    ui_view_maxx = max(0, ui_w - ui_view_w); ui_view_maxy = max(0, ui_h - ui_view_h);
    ui_view_x = max(0, min(ui_view_maxx, ui_view_x)); ui_view_y = max(0, min(ui_view_maxy, ui_view_y));
    ui_phys_mx = mouse_x / ui_s; ui_phys_my = mouse_y / ui_s;
    ui_view_hit = ui_phys_mx < ui_view_w && ui_phys_my < ui_view_h;
    ui_mx = ui_phys_mx + ui_view_x; ui_my = ui_phys_my + ui_view_y;
    ui_wheel_steps = mouse_wheel > 0 ? floor(mouse_wheel / 120 + 0.5) : mouse_wheel < 0 ? ceil(mouse_wheel / 120 - 0.5) : 0;
    mouse_wheel = 0; mouse_hwheel = 0;

    ui_reveal_focus = ui_focus_context != ui_overlay;
    ui_focus_context != ui_overlay ? ( ui_focus_ix = 0; ui_nslots = 0; ui_focus_context = ui_overlay; );
    ui_read_keys(); ui_reveal_focus = ui_reveal_focus || ui_key_tab || ui_key_shifttab;
    ui_nslots > 0 ? (
      ui_key_tab ? ui_focus_ix = ui_focus_ix < 0 ? 0 : (ui_focus_ix + 1) % ui_nslots;
      ui_key_shifttab ? ui_focus_ix = ui_focus_ix < 0 ? ui_nslots - 1 : (ui_focus_ix - 1 + ui_nslots) % ui_nslots;
    );

    ui_blocked = ui_overlay > 0 || ui_pop_kind > 0;
    ui_slot = 0;
    ui_hover_active = 0; ui_focus_found = 0; ui_focus_top = -1; ui_focus_bottom = -1; ui_clip_bottom = 0;

    card_h = 190; drawer_h = ui_drawer ? 172 : 72;
    OY = -ui_scroll;
    y_header = OY + 0; y_source = OY + 48; y_wave = OY + 88; y_scan = OY + 194; y_cards = OY + 194 + 48;
    y_motion = y_cards + card_h; y_drawer = y_motion + 40;
    content_h = y_drawer - OY + drawer_h;
    y_macros = min(content_h, max(0, ui_h - 136)); y_footer = y_macros + 92;
    ui_scroll_max = max(0, content_h - y_macros);
    ui_scroll = max(0, min(ui_scroll_max, ui_scroll));
    LWv = ui_w - (ui_scroll_max > 0 ? 32 : 0);

    gfx_clear = -1; ui_c_bg(); gfx_rect(0, 0, gfx_w, gfx_h);

