  ui_c_dim(); ui_font(2, 11); ui_text(x + 6, y + 3, label);
  ui_enum_label(enumtype, val);
  dim ? ui_c_dim() : ui_c_text(); ui_font(3, 14); ui_textbox(x + 6, y + 16, w - 20, 16, #ui_fv, 0);
  ui_c_dim(); ui_font(3, 12); ui_textbox(x, y + 16, w - 6, 16, "v", 2);
  val;
);

function ui_button(x, y, w, h, label) local(myslot hit clicked)
(
  myslot = ui_slot; ui_slot += 1; ui_track_focus(myslot, x, y, w, h);
  hit = !ui_blocked && ui_hit(x, y, w, h);
  hit ? ui_sethint(label);
  clicked = hit && !(mouse_cap & 1) && (ui_lastcap & 1) && ui_press_slot === myslot;
  hit && (mouse_cap & 1) && !(ui_lastcap & 1) ? ( ui_press_slot = myslot; ui_focus_ix = myslot; );
  myslot === ui_focus_ix && !ui_blocked && !ui_edit_active && ui_key_enter ? ( clicked = 1; ui_key_enter = 0; ui_key_space = 0; );
  hit ? ui_c_fieldhover() : ui_c_field();
  ui_rect(x, y, w, h);
  myslot === ui_focus_ix && !ui_blocked ? ui_focus_ring(x, y, w, h);
  ui_c_text(); ui_font(3, 13); ui_textbox(x, y, w, h, label, 1 | 4);
  clicked;
);

function ui_rowbutton(x, y, w, h, label) local(clicked hit)
(
  clicked = ui_button(x, y, w, h, "");
  hit = !ui_blocked && ui_hit(x, y, w, h);
