function ui_draw_preset_details(x0, y0, w) local(nv colw)
(
  colw = (w - 8) / 2;
  nv = ui_numfield(x0, y0, colw, 32, "Preset Trim", preset_trim + 0, -24, 12, 0, 1, 0.1, 0, 8, -1, 0);
  nv != preset_trim ? preset_trim = nv; ui_touch ? ui_undo_pending = 1;
  // Variation Seed, with prev/next steppers (owner ruling, 18 September 2026, replacing the
  // momentary New Variation button removed earlier the same day). Typing the number still works and
  // is still the only way to jump; these two walk it in ones and ask the audio side to re-articulate
  // whatever is held, because a seed reaches a voice only at note-on and is otherwise inaudible
  // until the next note. Same 32 x 32 idiom as the preset steppers in the header.
  nv = ui_numfield(x0 + colw + 8, y0, colw - 76, 32, "Variation Seed", slider(59), 1, 16777215, 0, 1, 1, 1, 14, -1, 0);
  nv != slider(59) ? ( slider(59) = nv; slider_automate(slider(59)); ); ui_touch ? slider_automate(slider(59), 1);
  ui_button(x0 + 2 * colw - 60, y0, 32, 32, "<") ? seed_step(-1);
  ui_button(x0 + 2 * colw - 24, y0, 32, 32, ">") ? seed_step(1);
  ui_c_dim(); ui_font(2, 11); ui_text(x0, y0 + 36, "Description");
  ui_edit_active && ui_edit_owner === -3 ? ( ui_col(1, 1, 1); ui_font(3, 13); ui_textbox(x0, y0 + 48, w, 16, #ui_edit_text, 0); )
  : ( ui_c_text(); ui_font(3, 13); ui_textbox(x0, y0 + 48, w, 16, #preset_desc, 0);
      !ui_blocked && ui_hit(x0, y0 + 40, w, 32) && (mouse_cap & 1) && !(ui_lastcap & 1) ? ( ui_edit_active = 1; ui_edit_owner = -3; ui_edit_selected = 1; ui_edit_commit = 0; strcpy(#ui_edit_text, #preset_desc); ); );
);

