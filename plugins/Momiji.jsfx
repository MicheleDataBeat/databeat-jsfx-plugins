  xa = x0; xb = x1; x0 = cth * xa + sth * xb; x1 = cth * xb - sth * xa;
  xa = x2; xb = x3; x2 = cth * xa + sth * xb; x3 = cth * xb - sth * xa;
  xa = x4; xb = x5; x4 = cth * xa + sth * xb; x5 = cth * xb - sth * xa;
  xa = x6; xb = x7; x6 = cth * xa + sth * xb; x7 = cth * xb - sth * xa;
  xa = x8; xb = x9; x8 = cth * xa + sth * xb; x9 = cth * xb - sth * xa;
  xa = x10; xb = x11; x10 = cth * xa + sth * xb; x11 = cth * xb - sth * xa;
  xa = x12; xb = x13; x12 = cth * xa + sth * xb; x13 = cth * xb - sth * xa;
  xa = x14; xb = x15; x14 = cth * xa + sth * xb; x15 = cth * xb - sth * xa;
  // stage 1: pairs (i, i+2)
  xa = x0; xb = x2; x0 = cth * xa + sth * xb; x2 = cth * xb - sth * xa;
  xa = x1; xb = x3; x1 = cth * xa + sth * xb; x3 = cth * xb - sth * xa;
  xa = x4; xb = x6; x4 = cth * xa + sth * xb; x6 = cth * xb - sth * xa;
  xa = x5; xb = x7; x5 = cth * xa + sth * xb; x7 = cth * xb - sth * xa;
  xa = x8; xb = x10; x8 = cth * xa + sth * xb; x10 = cth * xb - sth * xa;
  xa = x9; xb = x11; x9 = cth * xa + sth * xb; x11 = cth * xb - sth * xa;
  xa = x12; xb = x14; x12 = cth * xa + sth * xb; x14 = cth * xb - sth * xa;
  xa = x13; xb = x15; x13 = cth * xa + sth * xb; x15 = cth * xb - sth * xa;
  // stage 2: pairs (i, i+4)
  xa = x0; xb = x4; x0 = cth * xa + sth * xb; x4 = cth * xb - sth * xa;
  xa = x1; xb = x5; x1 = cth * xa + sth * xb; x5 = cth * xb - sth * xa;
  xa = x2; xb = x6; x2 = cth * xa + sth * xb; x6 = cth * xb - sth * xa;
  xa = x3; xb = x7; x3 = cth * xa + sth * xb; x7 = cth * xb - sth * xa;
  xa = x8; xb = x12; x8 = cth * xa + sth * xb; x12 = cth * xb - sth * xa;
  xa = x9; xb = x13; x9 = cth * xa + sth * xb; x13 = cth * xb - sth * xa;
  xa = x10; xb = x14; x10 = cth * xa + sth * xb; x14 = cth * xb - sth * xa;
  xa = x11; xb = x15; x11 = cth * xa + sth * xb; x15 = cth * xb - sth * xa;
  // stage 3: pairs (i, i+8)
  xa = x0; xb = x8; x0 = cth * xa + sth * xb; x8 = cth * xb - sth * xa;
  xa = x1; xb = x9; x1 = cth * xa + sth * xb; x9 = cth * xb - sth * xa;
  xa = x2; xb = x10; x2 = cth * xa + sth * xb; x10 = cth * xb - sth * xa;
  xa = x3; xb = x11; x3 = cth * xa + sth * xb; x11 = cth * xb - sth * xa;
  xa = x4; xb = x12; x4 = cth * xa + sth * xb; x12 = cth * xb - sth * xa;
  xa = x5; xb = x13; x5 = cth * xa + sth * xb; x13 = cth * xb - sth * xa;
  xa = x6; xb = x14; x6 = cth * xa + sth * xb; x14 = cth * xb - sth * xa;
  xa = x7; xb = x15; x7 = cth * xa + sth * xb; x15 = cth * xb - sth * xa;

  // ---- per-line low shelf, high shelf, scalar gain; injection (B rows: +-1/(4 sqrt 2)); write
  il = 0.088388347648318440 * x_l * env; ir = 0.088388347648318440 * x_r * env;
  vi = x7;
  ell = lpb_l * (vi + lx1_0) + lpa_l * ly1_0; lx1_0 = vi; ly1_0 = ell;
  zh = vi - (1 - rl0) * ell;
  elh = lpb_h * (zh + lx2_0) + lpa_h * ly2_0; lx2_0 = zh; ly2_0 = elh;
  u0 = gm0 * (rh0 * zh + (1 - rh0) * elh) + il;
  vi = -x12;
  ell = lpb_l * (vi + lx1_1) + lpa_l * ly1_1; lx1_1 = vi; ly1_1 = ell;
  zh = vi - (1 - rl1) * ell;
  elh = lpb_h * (zh + lx2_1) + lpa_h * ly2_1; lx2_1 = zh; ly2_1 = elh;
  u1 = gm1 * (rh1 * zh + (1 - rh1) * elh) - ir;
  vi = -x1;
  ell = lpb_l * (vi + lx1_2) + lpa_l * ly1_2; lx1_2 = vi; ly1_2 = ell;
  zh = vi - (1 - rl2) * ell;
  elh = lpb_h * (zh + lx2_2) + lpa_h * ly2_2; lx2_2 = zh; ly2_2 = elh;
  u2 = gm2 * (rh2 * zh + (1 - rh2) * elh) + ir;
  vi = x14;
  ell = lpb_l * (vi + lx1_3) + lpa_l * ly1_3; lx1_3 = vi; ly1_3 = ell;
  zh = vi - (1 - rl3) * ell;
  elh = lpb_h * (zh + lx2_3) + lpa_h * ly2_3; lx2_3 = zh; ly2_3 = elh;
  u3 = gm3 * (rh3 * zh + (1 - rh3) * elh) - il;
  vi = -x5;
  ell = lpb_l * (vi + lx1_4) + lpa_l * ly1_4; lx1_4 = vi; ly1_4 = ell;
  zh = vi - (1 - rl4) * ell;
  elh = lpb_h * (zh + lx2_4) + lpa_h * ly2_4; lx2_4 = zh; ly2_4 = elh;
  u4 = gm4 * (rh4 * zh + (1 - rh4) * elh) + il;
  vi = x0;
  ell = lpb_l * (vi + lx1_5) + lpa_l * ly1_5; lx1_5 = vi; ly1_5 = ell;
  zh = vi - (1 - rl5) * ell;
  elh = lpb_h * (zh + lx2_5) + lpa_h * ly2_5; lx2_5 = zh; ly2_5 = elh;
  u5 = gm5 * (rh5 * zh + (1 - rh5) * elh) - ir;
  vi = x11;
  ell = lpb_l * (vi + lx1_6) + lpa_l * ly1_6; lx1_6 = vi; ly1_6 = ell;
  zh = vi - (1 - rl6) * ell;
  elh = lpb_h * (zh + lx2_6) + lpa_h * ly2_6; lx2_6 = zh; ly2_6 = elh;
  u6 = gm6 * (rh6 * zh + (1 - rh6) * elh) + ir;
  vi = -x8;
  ell = lpb_l * (vi + lx1_7) + lpa_l * ly1_7; lx1_7 = vi; ly1_7 = ell;
  zh = vi - (1 - rl7) * ell;
  elh = lpb_h * (zh + lx2_7) + lpa_h * ly2_7; lx2_7 = zh; ly2_7 = elh;
  u7 = gm7 * (rh7 * zh + (1 - rh7) * elh) - il;
  vi = x3;
  ell = lpb_l * (vi + lx1_8) + lpa_l * ly1_8; lx1_8 = vi; ly1_8 = ell;
  zh = vi - (1 - rl8) * ell;
  elh = lpb_h * (zh + lx2_8) + lpa_h * ly2_8; lx2_8 = zh; ly2_8 = elh;
  u8 = gm8 * (rh8 * zh + (1 - rh8) * elh) + il;
  vi = x10;
  ell = lpb_l * (vi + lx1_9) + lpa_l * ly1_9; lx1_9 = vi; ly1_9 = ell;
  zh = vi - (1 - rl9) * ell;
  elh = lpb_h * (zh + lx2_9) + lpa_h * ly2_9; lx2_9 = zh; ly2_9 = elh;
  u9 = gm9 * (rh9 * zh + (1 - rh9) * elh) - ir;
  vi = -x15;
  ell = lpb_l * (vi + lx1_10) + lpa_l * ly1_10; lx1_10 = vi; ly1_10 = ell;
  zh = vi - (1 - rl10) * ell;
  elh = lpb_h * (zh + lx2_10) + lpa_h * ly2_10; lx2_10 = zh; ly2_10 = elh;
  u10 = gm10 * (rh10 * zh + (1 - rh10) * elh) + ir;
  vi = -x4;
  ell = lpb_l * (vi + lx1_11) + lpa_l * ly1_11; lx1_11 = vi; ly1_11 = ell;
  zh = vi - (1 - rl11) * ell;
  elh = lpb_h * (zh + lx2_11) + lpa_h * ly2_11; lx2_11 = zh; ly2_11 = elh;
  u11 = gm11 * (rh11 * zh + (1 - rh11) * elh) - il;
  vi = x13;
  ell = lpb_l * (vi + lx1_12) + lpa_l * ly1_12; lx1_12 = vi; ly1_12 = ell;
  zh = vi - (1 - rl12) * ell;
  elh = lpb_h * (zh + lx2_12) + lpa_h * ly2_12; lx2_12 = zh; ly2_12 = elh;
  u12 = gm12 * (rh12 * zh + (1 - rh12) * elh) + il;
  vi = -x6;
  ell = lpb_l * (vi + lx1_13) + lpa_l * ly1_13; lx1_13 = vi; ly1_13 = ell;
  zh = vi - (1 - rl13) * ell;
  elh = lpb_h * (zh + lx2_13) + lpa_h * ly2_13; lx2_13 = zh; ly2_13 = elh;
  u13 = gm13 * (rh13 * zh + (1 - rh13) * elh) - ir;
  vi = x9;
  ell = lpb_l * (vi + lx1_14) + lpa_l * ly1_14; lx1_14 = vi; ly1_14 = ell;
  zh = vi - (1 - rl14) * ell;
  elh = lpb_h * (zh + lx2_14) + lpa_h * ly2_14; lx2_14 = zh; ly2_14 = elh;
  u14 = gm14 * (rh14 * zh + (1 - rh14) * elh) + ir;
  vi = -x2;
  ell = lpb_l * (vi + lx1_15) + lpa_l * ly1_15; lx1_15 = vi; ly1_15 = ell;
  zh = vi - (1 - rl15) * ell;
  elh = lpb_h * (zh + lx2_15) + lpa_h * ly2_15; lx2_15 = zh; ly2_15 = elh;
  u15 = gm15 * (rh15 * zh + (1 - rh15) * elh) - il;
  esum = u0 * u0 + u1 * u1 + u2 * u2 + u3 * u3 + u4 * u4 + u5 * u5 + u6 * u6 + u7 * u7 + u8 * u8 + u9 * u9 + u10 * u10 + u11 * u11 + u12 * u12 + u13 * u13 + u14 * u14 + u15 * u15;
  esum < 1000000000000 ? (
    esum < 0.0000000000000000000000000000000000000001 ? ( u0 = 0; u1 = 0; u2 = 0; u3 = 0; u4 = 0; u5 = 0; u6 = 0; u7 = 0; u8 = 0; u9 = 0; u10 = 0; u11 = 0; u12 = 0; u13 = 0; u14 = 0; u15 = 0; );
    bs0[w0] = u0; w0 += 1; w0 >= ln0 ? w0 = 0; vd0 < ln0 ? vd0 += 1;
    bs1[w1] = u1; w1 += 1; w1 >= ln1 ? w1 = 0; vd1 < ln1 ? vd1 += 1;
    bs2[w2] = u2; w2 += 1; w2 >= ln2 ? w2 = 0; vd2 < ln2 ? vd2 += 1;
    bs3[w3] = u3; w3 += 1; w3 >= ln3 ? w3 = 0; vd3 < ln3 ? vd3 += 1;
    bs4[w4] = u4; w4 += 1; w4 >= ln4 ? w4 = 0; vd4 < ln4 ? vd4 += 1;
    bs5[w5] = u5; w5 += 1; w5 >= ln5 ? w5 = 0; vd5 < ln5 ? vd5 += 1;
    bs6[w6] = u6; w6 += 1; w6 >= ln6 ? w6 = 0; vd6 < ln6 ? vd6 += 1;
    bs7[w7] = u7; w7 += 1; w7 >= ln7 ? w7 = 0; vd7 < ln7 ? vd7 += 1;
    bs8[w8] = u8; w8 += 1; w8 >= ln8 ? w8 = 0; vd8 < ln8 ? vd8 += 1;
    bs9[w9] = u9; w9 += 1; w9 >= ln9 ? w9 = 0; vd9 < ln9 ? vd9 += 1;
    bs10[w10] = u10; w10 += 1; w10 >= ln10 ? w10 = 0; vd10 < ln10 ? vd10 += 1;
    bs11[w11] = u11; w11 += 1; w11 >= ln11 ? w11 = 0; vd11 < ln11 ? vd11 += 1;
    bs12[w12] = u12; w12 += 1; w12 >= ln12 ? w12 = 0; vd12 < ln12 ? vd12 += 1;
    bs13[w13] = u13; w13 += 1; w13 >= ln13 ? w13 = 0; vd13 < ln13 ? vd13 += 1;
    bs14[w14] = u14; w14 += 1; w14 >= ln14 ? w14 = 0; vd14 < ln14 ? vd14 += 1;
    bs15[w15] = u15; w15 += 1; w15 >= ln15 ? w15 = 0; vd15 < ln15 ? vd15 += 1;
    !(y_l > -1048576 && y_l < 1048576 && y_r > -1048576 && y_r < 1048576) ? (
      fault_internal += 1; dc_l = last_l; dc_r = last_r; declick_n = 0; y_l = 0; y_r = 0; tank_restart();
    );
    last_l = y_l; last_r = y_r;
  ) : (
    // non-finite or exploding state: keep the last valid pair, restart the network
    fault_internal += 1; dc_l = last_l; dc_r = last_r; declick_n = 0; y_l = 0; y_r = 0; tank_restart();
  );
  // oscillator advance (rotation by omega)
  oc2 = oc * cw - os * sw; os = os * cw + oc * sw; oc = oc2;
) : ( y_l = 0; y_r = 0; );
//@CORE_S_END

// ---- declick residual after a fault or rate change
declick_n < declick_len ? (
  dcg = 0.5 * (1 + cos($pi * declick_n / declick_len)); declick_n += 1;
  y_l += dc_l * dcg; y_r += dc_r * dcg;
);

// ---- width (M/S) and mix
g_width += sm_out * (t_width - g_width);
g_mix_w += sm_out * (sin(t_mix * 0.5 * $pi) - g_mix_w);
g_mix_d += sm_out * (cos(t_mix * 0.5 * $pi) - g_mix_d);
mid = 0.5 * (y_l + y_r); sid = 0.5 * (y_l - y_r) * g_width;
w_l = mid + sid; w_r = mid - sid;
al = abs(w_l); al > peak_l ? peak_l = al;
ar = abs(w_r); ar > peak_r ? peak_r = ar;
spl0 = x_l * g_mix_d + w_l * g_mix_w;
spl1 = x_r * g_mix_d + w_r * g_mix_w;
blk_i += 1; blk_i == samplesblock ? cpu_busy = time_precise() - cpu_t0;

@serialize
ser_ver = 1;
file_var(0, ser_ver);
file_var(0, preset_idx);
file_var(0, preset_dirty);
file_var(0, flip_seed);
preset_idx >= 0 && preset_idx < NPRESET ? preset_parse(PSTR_DATA + preset_idx);
preset_check_dirty();

@gfx 900 400
// ============================================================================
//  Interface. Design units are the 900 x 400 layout; everything is drawn through ui_s
//  (1 on plain displays, 2 on Retina) so lines and text stay crisp. Immediate mode:
//  widgets read and write the sliders; the audio sections see only the sliders,
//  ui_req_preset, ui_req_flip and the peak meter decay.
// ============================================================================
gfx_ext_retina < 1 ? gfx_ext_retina = 1;
ui_s = gfx_ext_retina > 1 ? gfx_ext_retina : 1;
ui_mx = mouse_x / ui_s; ui_my = mouse_y / ui_s;

// ---------- palette ----------
function col_bg() ( gfx_set(0.104, 0.108, 0.120, 1); );
function col_bar() ( gfx_set(0.072, 0.075, 0.084, 1); );
function col_panel() ( gfx_set(0.140, 0.146, 0.162, 1); );
function col_panel_top() ( gfx_set(0.158, 0.165, 0.182, 1); );
function col_edge() ( gfx_set(0.235, 0.245, 0.268, 1); );
function col_edge_hi() ( gfx_set(0.34, 0.355, 0.385, 1); );
function col_well() ( gfx_set(0.058, 0.061, 0.070, 1); );
function col_text() ( gfx_set(0.92, 0.925, 0.94, 1); );
function col_dim() ( gfx_set(0.62, 0.64, 0.69, 1); );
function col_faint() ( gfx_set(0.40, 0.42, 0.47, 1); );
function col_accent() ( gfx_set(0.86, 0.47, 0.34, 1); );
function col_accent_dim() ( gfx_set(0.52, 0.31, 0.24, 1); );
function col_knob() ( gfx_set(0.205, 0.212, 0.235, 1); );
function col_knob_dk() ( gfx_set(0.150, 0.156, 0.174, 1); );

// ---------- scaled primitives ----------
function ui_font(sz, flags) ( gfx_setfont(1, "Helvetica Neue", floor(sz * ui_s + 0.5), flags); );
function ui_rect(x, y, w, h) ( gfx_rect(x * ui_s, y * ui_s, w * ui_s, h * ui_s, 1); );
function ui_line(x1, y1, x2, y2) ( gfx_line(x1 * ui_s, y1 * ui_s, x2 * ui_s, y2 * ui_s, 1); );
function ui_circle(x, y, r, fill) ( gfx_circle(x * ui_s, y * ui_s, r * ui_s, fill, 1); );
function ui_ring(x, y, r, a1, a2, w) local(k) ( k = 0; while (k < w * ui_s) ( gfx_arc(x * ui_s, y * ui_s, r * ui_s - k, a1, a2, 1); k += 1; ); );
function ui_rrect(x, y, w, h, r) (
  gfx_rect((x + r) * ui_s, y * ui_s, (w - 2 * r) * ui_s, h * ui_s, 1);
  gfx_rect(x * ui_s, (y + r) * ui_s, w * ui_s, (h - 2 * r) * ui_s, 1);
  gfx_circle((x + r) * ui_s, (y + r) * ui_s, r * ui_s, 1, 1); gfx_circle((x + w - r) * ui_s, (y + r) * ui_s, r * ui_s, 1, 1);
  gfx_circle((x + r) * ui_s, (y + h - r) * ui_s, r * ui_s, 1, 1); gfx_circle((x + w - r) * ui_s, (y + h - r) * ui_s, r * ui_s, 1, 1);
);
function ui_rrect_edge(x, y, w, h, r) ( gfx_roundrect(x * ui_s, y * ui_s, w * ui_s - 1, h * ui_s - 1, r * ui_s, 1); );
function ui_text(x, y, s) ( gfx_x = x * ui_s; gfx_y = y * ui_s; gfx_drawstr(s); );
function ui_text_box(x, y, w, h, s, flags) ( gfx_x = x * ui_s; gfx_y = y * ui_s; gfx_drawstr(s, flags | 4, (x + w) * ui_s, (y + h) * ui_s); );
function ui_tri(x0, y0, x1, y1, x2, y2) ( gfx_triangle(x0 * ui_s, y0 * ui_s, x1 * ui_s, y1 * ui_s, x2 * ui_s, y2 * ui_s); );
function hit(x, y, w, h) ( ui_mx >= x && ui_mx < x + w && ui_my >= y && ui_my < y + h; );

// ---------- slider ranges, defaults, display law ----------
function srange(i) (
  i == 1 ? ( ui_lo = 0; ui_hi = 100; ui_def = 32; ui_log = 0; )
  : i == 2 ? ( ui_lo = 20; ui_hi = 4000; ui_def = 80; ui_log = 1; )
  : i == 3 ? ( ui_lo = 0; ui_hi = 100; ui_def = 55; ui_log = 0; )
  : i == 4 ? ( ui_lo = 0; ui_hi = 100; ui_def = 100; ui_log = 0; )
  : i == 5 ? ( ui_lo = 0.2; ui_hi = 40; ui_def = 2.6; ui_log = 1; )
  : i == 6 ? ( ui_lo = 0; ui_hi = 100; ui_def = 30; ui_log = 0; )
  : i == 7 ? ( ui_lo = 0; ui_hi = 100; ui_def = 40; ui_log = 0; )
  : i == 8 ? ( ui_lo = 0.05; ui_hi = 2; ui_def = 0.25; ui_log = 1; )
  : i == 9 ? ( ui_lo = 0; ui_hi = 100; ui_def = 30; ui_log = 0; )
  : i == 10 ? ( ui_lo = 0; ui_hi = 200; ui_def = 110; ui_log = 0; )
  : i == 11 ? ( ui_lo = 0; ui_hi = 1; ui_def = 0; ui_log = 0; )
  : ( ui_lo = 0; ui_hi = 20; ui_def = 7; ui_log = 0; );
);
function div_name(k) local(b, v) (
  k = clamp(floor(k + 0.5), 0, 20); b = floor(k / 3); v = k - 3 * b;
  b == 0 ? strcpy(#div, "1/32") : b == 1 ? strcpy(#div, "1/16") : b == 2 ? strcpy(#div, "1/8") : b == 3 ? strcpy(#div, "1/4") : b == 4 ? strcpy(#div, "1/2") : b == 5 ? strcpy(#div, "1") : strcpy(#div, "2");
  v == 0 ? strcat(#div, "T") : v == 2 ? strcat(#div, ".");
);
function fmt_val(i, v) (
  i == 2 ? sprintf(#val, "%.0f ms", v)
  : i == 12 ? ( div_name(v); sprintf(#val, "%s · %.0f ms", #div, div_seconds(v) * 1000); )
  : i == 5 ? (v < 10 ? sprintf(#val, "%.2f s", v) : sprintf(#val, "%.1f s", v))
  : i == 8 ? sprintf(#val, "%.2f Hz", v)
  : sprintf(#val, "%.0f %%", v);
);
// normalized position <-> value (log law for time and rate knobs)
function to_norm(i, v) ( srange(i); ui_log ? log(max(v, ui_lo) / ui_lo) / log(ui_hi / ui_lo) : (v - ui_lo) / (ui_hi - ui_lo); );
function from_norm(i, t) ( srange(i); t = clamp(t, 0, 1); ui_log ? ui_lo * exp(log(ui_hi / ui_lo) * t) : ui_lo + (ui_hi - ui_lo) * t; );
function sset(i, v) (
  srange(i); v = clamp(v, ui_lo, ui_hi);
  i == 8 ? v = floor(v * 1000 + 0.5) / 1000 : i == 5 ? v = floor(v * 100 + 0.5) / 100 : i >= 11 ? v = floor(v + 0.5) : v = floor(v * 10 + 0.5) / 10;
  v !== slider(i) ? ( slider(i) = v; sliderchange(slider(i)); slider_automate(slider(i)); preset_check_dirty(); );
);

// ---------- widgets ----------
function panel(x, y, w, h, name) (
  col_panel(); ui_rrect(x, y, w, h, 5);
  col_panel_top(); ui_rrect(x, y, w, 28, 5); ui_rect(x, y + 20, w, 8);
  col_edge(); ui_rrect_edge(x, y, w, h, 5);
  col_accent_dim(); ui_rect(x + 10, y + 27, w - 20, 1);
  col_dim(); ui_font(11, 'b'); ui_text(x + 11, y + 8, name);
);

// Knob: vertical drag (220 units full range, Shift = fine), double-click resets, wheel nudges.
// Label always under the knob; the value under the label, accented while hovered or dragged.
function knob(i, x, y, r, name) local(v, t, hov, a0, a1, ang, dv, ax, ay) (
  v = slider(i); t = to_norm(i, v);
  hov = hit(x - r - 8, y - r - 8, 2 * r + 16, 2 * r + 36);
  hov && g_mdown && !g_menu_open ? (
    (g_now - g_click_t < 0.35 && g_click_id == i) ? ( sset(i, ui_def); g_drag = -1; g_click_t = 0; )
    : ( g_drag = i; g_dragy = ui_my; g_dragt = t; g_click_t = g_now; g_click_id = i; );
  );
  g_drag == i ? ( dv = (g_dragy - ui_my) / ((mouse_cap & 8) ? 2400 : 220); sset(i, from_norm(i, g_dragt + dv)); );
  hov && g_wheel != 0 ? ( sset(i, from_norm(i, t + g_wheel / 120 * ((mouse_cap & 8) ? 0.002 : 0.02))); g_wheel = 0; );
  v = slider(i); t = to_norm(i, v);
  hov = hov || g_drag == i;
  // track (270 degrees from 7:30 clockwise; gfx_arc: 0 = up) and value arc
  a0 = -0.75 * $pi; a1 = a0 + 1.5 * $pi * t;
  col_well(); ui_circle(x, y, r + 1, 1);
  col_edge_hi(); ui_ring(x, y, r, a0, a0 + 1.5 * $pi, 2);
  hov ? col_accent() : col_accent_dim(); t > 0.003 ? ui_ring(x, y, r, a0, a1, 2);
  col_knob(); ui_circle(x, y, r - 4, 1);
  col_knob_dk(); ui_circle(x, y + 1, r - 6, 1);
  ang = 0.75 * $pi + 1.5 * $pi * t;
  ax = x + cos(ang) * (r - 8); ay = y + sin(ang) * (r - 8);
  hov ? col_text() : col_dim(); ui_line(x + cos(ang) * 3, y + sin(ang) * 3, ax, ay);
  fmt_val(i, v);
  hov ? col_text() : col_dim(); ui_font(10, 'b'); ui_text_box(x - r - 18, y + r + 5, 2 * r + 36, 12, name, 1);
  hov ? col_accent() : col_faint(); ui_font(9, 0); ui_text_box(x - r - 18, y + r + 17, 2 * r + 36, 11, #val, 1);
);

function button(x, y, w, h, name, on) local(hov) (
  hov = hit(x, y, w, h);
  on ? col_accent_dim() : (hov ? col_edge() : col_well()); ui_rrect(x, y, w, h, 4);
  hov ? col_accent() : col_edge_hi(); ui_rrect_edge(x, y, w, h, 4);
  hov || on ? col_text() : col_dim(); ui_font(11, 'b'); ui_text_box(x, y, w, h, name, 1);
  hov && g_mdown && !g_menu_open;
);

function preset_step(d) local(n) ( NPRESET > 0 ? ( n = preset_idx + d; n < 0 ? n = NPRESET - 1; n >= NPRESET ? n = 0; ui_req_preset = n; ); );

// Preset browser: prev / category menu / name menu / next. Menus are built from the library.
function preset_browser(x, y, w, h) local(hov, k, r, n, cnt, i) (
  col_well(); ui_rrect(x, y, w, h, 5); col_edge(); ui_rrect_edge(x, y, w, h, 5);
  hov = hit(x, y, 26, h); hov && g_mdown && !g_menu_open ? preset_step(-1);
  hov ? col_accent() : col_dim(); ui_tri(x + 17, y + 7, x + 17, y + h - 7, x + 8, y + h * 0.5);
  hov = hit(x + w - 26, y, 26, h); hov && g_mdown && !g_menu_open ? preset_step(1);
  hov ? col_accent() : col_dim(); ui_tri(x + w - 17, y + 7, x + w - 17, y + h - 7, x + w - 8, y + h * 0.5);
  col_edge(); ui_rect(x + 26, y + 5, 1, h - 10); ui_rect(x + w - 27, y + 5, 1, h - 10); ui_rect(x + 122, y + 5, 1, h - 10);
  // category
  hov = hit(x + 26, y, 96, h);
  preset_idx >= 0 && preset_idx < NPRESET ? strcpy(#tmp, PSTR_CAT + preset_idx) : strcpy(#tmp, "-");
  hov ? col_accent() : col_dim(); ui_font(10, 'b'); ui_text_box(x + 26, y, 96, h, #tmp, 1);
  hov && g_mdown && !g_menu_open ? (
    strcpy(#menu, ""); cnt = 0; i = 0;
    while (i < NPRESET) (
      k = 0; n = 0; while (k < i) ( strcmp(PSTR_CAT + k, PSTR_CAT + i) == 0 ? n = 1; k += 1; );
      n == 0 ? ( cnt > 0 ? strcat(#menu, "|"); strcmp(PSTR_CAT + i, #tmp) == 0 ? strcat(#menu, "!"); strcat(#menu, PSTR_CAT + i); MENUMAP[cnt] = i; cnt += 1; );
      i += 1;
    );
    gfx_x = (x + 26) * ui_s; gfx_y = (y + h) * ui_s;
    r = gfx_showmenu(#menu); r > 0 ? ui_req_preset = MENUMAP[r - 1];
    g_menu_open = 1;
  );
  // name
  hov = hit(x + 122, y, w - 149, h);
  preset_idx >= 0 && preset_idx < NPRESET ? strcpy(#tmp2, PSTR_NAME + preset_idx) : strcpy(#tmp2, "-");
  preset_dirty ? strcat(#tmp2, " *");
  hov ? col_accent() : col_text(); ui_font(14, 'b'); ui_text_box(x + 122, y, w - 149, h, #tmp2, 1);
  hov && g_mdown && !g_menu_open ? (
    strcpy(#menu, ""); cnt = 0; i = 0;
    while (i < NPRESET) (
      strcmp(PSTR_CAT + i, #tmp) == 0 ? ( cnt > 0 ? strcat(#menu, "|"); i == preset_idx ? strcat(#menu, "!"); strcat(#menu, PSTR_NAME + i); MENUMAP[cnt] = i; cnt += 1; );
      i += 1;
    );
    gfx_x = (x + 122) * ui_s; gfx_y = (y + h) * ui_s;
    r = gfx_showmenu(#menu); r > 0 ? ui_req_preset = MENUMAP[r - 1];
    g_menu_open = 1;
  );
);

// ---------- displays ----------
// delay-line geometry: the sixteen current line lengths on a time axis
function draw_geometry(x, y, w, h) local(k, px, smax, tx, lbl, dim) (
  col_well(); ui_rrect(x, y, w, h, 3); col_edge(); ui_rrect_edge(x, y, w, h, 3);
  smax = max(DBASE[15], 1) / fs;
  col_edge_hi(); ui_rect(x + 8, y + h - 16, w - 16, 1);
  // the bars dim with Density: bright at 100 % (lines fully mixed), faint at 0 % (lines kept apart)
  dim = 0.35 + 0.65 * clamp(s_rho, 0, 1);
  k = 0;
  while (k < 16) (
    px = x + 8 + (w - 16) * (DBASE[k] / fs) / smax;
    k < 8 ? gfx_set(0.86 * dim, 0.47 * dim, 0.34 * dim, 1) : gfx_set(0.52 * dim, 0.31 * dim, 0.24 * dim, 1);
    ui_rect(px - 0.5, y + 10, 1.5, h - 27);
    k += 1;
  );
  col_faint(); ui_font(8, 0); ui_text(x + 8, y + h - 12, "0");
  p_sync > 0.5 ? ( div_name(p_div); sprintf(#tmp, "%s · %.0f ms", #div, smax * 1000); ) : sprintf(#tmp, "%.0f ms", smax * 1000);
  ui_text_box(x + w - 110, y + h - 12, 102, 10, #tmp, 2);
  ui_text(x + 8, y + 2, "LINE LENGTHS");
);
// predicted decay time against frequency from the frozen loop response (Astra 01 s6 proxy):
// T(f) = -ln(1000) sum(tau_i) / sum(ln|G_i(f)|), with the two shelves and the scalar gain.
function draw_decay_curve(x, y, w, h) local(k, nf, f, om, zr, zi, lr, li, hr, hi, den, gr, gi, gl, sumln, sumtau, tpr, px, py, lx, ly, tmax, i, a, b, cr, ci, mr, mi, tl, th) (
  col_well(); ui_rrect(x, y, w, h, 3); col_edge(); ui_rrect_edge(x, y, w, h, 3);
  tmax = t_eff * 1.08; nf = 48;
  sumtau = 0; i = 0; while (i < 16) ( sumtau += DBASE[i] / fs; i += 1; );
  // reference grid: 100 Hz, 1 kHz, 10 kHz and the nominal T
  col_edge(); k = 0;
  while (k < 3) ( px = x + 8 + (w - 16) * (log(100 * 10 ^ k / 40) / log(16000 / 40)); ui_rect(px, y + 12, 1, h - 26); k += 1; );
  py = y + h - 14 - (h - 28) * (t_eff / tmax); col_edge_hi(); ui_rect(x + 8, py, w - 16, 1);
  k = 0;
  while (k < nf) (
    f = 40 * exp(log(16000 / 40) * k / (nf - 1));
    f < fs * 0.49 ? (
      om = 2 * $pi * f / fs; zr = cos(om); zi = -sin(om);
      // low primitive L = b(1+z)/(1-a z)
      a = lpa_l; b = lpb_l; den = (1 - a * zr) * (1 - a * zr) + (a * zi) * (a * zi);
      lr = b * ((1 + zr) * (1 - a * zr) + zi * (a * zi)) / den; li = b * (zi * (1 - a * zr) - (1 + zr) * (a * zi)) / den;
      a = lpa_h; b = lpb_h; den = (1 - a * zr) * (1 - a * zr) + (a * zi) * (a * zi);
      hr = b * ((1 + zr) * (1 - a * zr) + zi * (a * zi)) / den; hi = b * (zi * (1 - a * zr) - (1 + zr) * (a * zi)) / den;
      sumln = 0; i = 0;
      while (i < 16) (
        tl = 1 - RLN[i]; th = 1 - RHN[i];
        cr = 1 - tl * lr; ci = -tl * li;                 // low shelf
        mr = RHN[i] + th * hr; mi = th * hi;             // high shelf
        gr = cr * mr - ci * mi; gi = cr * mi + ci * mr;
        gl = GMN[i] * sqrt(gr * gr + gi * gi);
        sumln += log(max(gl, 0.000001));
        i += 1;
      );
      tpr = sumln < -0.0000001 ? -KLN * sumtau / sumln : tmax;
      tpr = min(tpr, tmax);
      px = x + 8 + (w - 16) * k / (nf - 1); py = y + h - 14 - (h - 28) * (tpr / tmax);
      k > 0 ? ( col_accent(); ui_line(lx, ly, px, py); );
      lx = px; ly = py;
    );
    k += 1;
  );
  col_faint(); ui_font(8, 0); ui_text(x + 8, y + 2, "DECAY TIME vs FREQUENCY");
  sprintf(#tmp, "%.2f s", t_eff); ui_text_box(x + w - 70, y + 2, 62, 10, #tmp, 2);
  ui_text(x + 8 + (w - 16) * (log(100 / 40) / log(400)) - 8, y + h - 12, "100");
  ui_text(x + 8 + (w - 16) * (log(1000 / 40) / log(400)) - 6, y + h - 12, "1k");
  ui_text(x + 8 + (w - 16) * (log(10000 / 40) / log(400)) - 8, y + h - 12, "10k");
);

// ============================================================================
//  Frame
// ============================================================================
g_now = time_precise();
g_mdown = (mouse_cap & 1) && !(g_last_cap & 1);
g_last_cap = mouse_cap;
(mouse_cap & 1) == 0 ? g_drag = -1;
g_wheel = mouse_wheel; mouse_wheel = 0;
g_menu_open = 0;
gfx_clear = -1;
col_bg(); gfx_rect(0, 0, gfx_w, gfx_h, 1);

// ---------- header ----------
col_bar(); ui_rect(0, 0, 900, 58);
col_accent(); ui_rect(0, 57, 900, 1);
col_accent(); ui_font(24, 'b'); ui_text(16, 13, "MOMIJI");
col_faint(); ui_font(10, 0); ui_text(122, 22, "ALGORITHMIC STEREO REVERB");
preset_browser(300, 15, 392, 28);
button(706, 15, 96, 28, "Switch Flip", flip_flash > g_now) ? ( ui_req_flip = 1; flip_flash = g_now + 0.25; );
// output meter (wet, post width), 60 dB range
col_well(); ui_rrect(818, 16, 66, 11, 2); ui_rrect(818, 31, 66, 11, 2);
ui_db = clamp(1 + 20 * log10(max(peak_l, 0.000001)) / 60, 0, 1);
ui_db > 0 ? ( col_accent_dim(); ui_rect(820, 18, 62 * ui_db, 7); );
ui_db = clamp(1 + 20 * log10(max(peak_r, 0.000001)) / 60, 0, 1);
ui_db > 0 ? ( col_accent_dim(); ui_rect(820, 33, 62 * ui_db, 7); );
col_edge(); ui_rrect_edge(818, 16, 66, 11, 2); ui_rrect_edge(818, 31, 66, 11, 2);
col_faint(); ui_font(8, 0); ui_text(818, 45, "WET L / R");
peak_l *= 0.82; peak_r *= 0.82;

// ---------- row 1: the network ----------
panel(16, 72, 262, 172, "DELAY NETWORK");
button(206, 76, 62, 20, "SYNC", p_sync > 0.5) ? sset(11, p_sync > 0.5 ? 0 : 1);
knob(p_sync > 0.5 ? 12 : 2, 63, 150, 24, "DELAY"); knob(3, 147, 150, 24, "WARP"); knob(4, 231, 150, 24, "DENSITY");
panel(288, 72, 262, 172, "DECAY");
knob(5, 335, 150, 24, "DECAY"); knob(6, 419, 150, 24, "LOW DAMP"); knob(7, 503, 150, 24, "HIGH DAMP");
panel(560, 72, 160, 172, "MODULATION");
knob(8, 605, 150, 22, "RATE"); knob(9, 675, 150, 22, "DEPTH");
panel(730, 72, 154, 172, "OUTPUT");
knob(10, 772, 150, 22, "WIDTH"); knob(1, 842, 150, 22, "MIX");

// ---------- row 2: state of the network ----------
panel(16, 254, 868, 112, "NETWORK");
draw_geometry(30, 290, 400, 66);
draw_decay_curve(444, 290, 426, 66);
// modulation and effective-decay readout under the panel title
col_faint(); ui_font(9, 0);
p_sync > 0.5 ? sprintf(#tmp, "synced to %.1f BPM  ·  mod ±%.2f ms at %.2f Hz  ·  %d lines  ·  %.0f Hz  ·  %s", tempo, a_target * 1000, f_actual, NLINES, fs, mem_ok ? "0 samples PDC" : "memory unavailable: wet disabled")
           : sprintf(#tmp, "mod ±%.2f ms at %.2f Hz  ·  %d lines  ·  %.0f Hz  ·  %s", a_target * 1000, f_actual, NLINES, fs, mem_ok ? "0 samples PDC" : "memory unavailable: wet disabled");
ui_text_box(420, 262, 456, 12, #tmp, 2);

// ---------- footer ----------
col_faint(); ui_font(8, 0);
ui_text(16, 380, "DRAG KNOBS VERTICALLY  ·  SHIFT FOR FINE  ·  DOUBLE-CLICK RESETS  ·  WHEEL NUDGES");
sprintf(#tmp, "MOMIJI 1.0  ·  %d PRESETS  ·  CPU %.1f %%", NPRESET, cpu_pct);
ui_text_box(560, 380, 324, 10, #tmp, 2);
