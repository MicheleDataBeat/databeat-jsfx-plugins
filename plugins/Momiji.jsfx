preset_add("Breakbeat Room", "Mix", "1=24 2=48 3=70 4=100 5=0.9 6=40 7=55 8=0.25 9=15 10=105");
//@PRESETS_END

// ---------------------------------------------------------------- init
oc = 1; os = 0;
!instance_ready ? ( instance_ready = 1; preset_idx = 0; preset_parse(PSTR_DATA + 0); preset_check_dirty(); flip_seed = 12345; ui_req_preset = -1; ui_req_flip = 0; );
layout_init();
tank_invalidate();
snap_all();
fade_mode = 2; fade_n = 0; env = 0;
declick_n = declick_len; dc_l = 0; dc_r = 0;
last_l = 0; last_r = 0;
fault_input = 0; fault_internal = 0; fault_osc = 0;
peak_l = 0; peak_r = 0;
gfx_ext_retina = 1;

@slider
preset_check_dirty();

@block
dsp_rate !== srate ? ( layout_init(); tank_restart(); );
ui_req_preset >= 0 ? ( preset_load(ui_req_preset); ui_req_preset = -1; );
ui_req_flip ? ( flip_generate(); ui_req_flip = 0; );
cpu_now = time_precise();
cpu_t0 > 0 && samplesblock > 0 ? cpu_pct = 0.9 * cpu_pct + 0.1 * 100 * cpu_busy / max(cpu_now - cpu_t0, 0.000001);
cpu_t0 = cpu_now; cpu_busy = 0; blk_i = 0;

@sample
// ---- fades: 0 running, 1 fading out before a restart, 2 fading in after one
fade_mode == 1 ? (
  env = 0.5 * (1 + cos($pi * fade_n / fade_len)); fade_n += 1;
  fade_n >= fade_len ? tank_restart();
) : fade_mode == 2 ? (
  env = 0.5 * (1 - cos($pi * fade_n / fade_len)); fade_n += 1;
  fade_n >= fade_len ? ( fade_mode = 0; env = 1; );
);

// ---- control clock
tick_ctr == 0 ? control_tick();
tick_ctr += 1; tick_ctr >= HTICK ? tick_ctr = 0;

//@CORE_S_BEGIN (generated by tools/gen_core.py)
// ---- coefficient ramps (linear across the tick interval)
theta_d !== 0 ? (
  theta += theta_d;
  tick_ctr == 0 ? ( theta = theta_end; theta_d = 0; );
  cth = cos(theta); sth = sin(theta);
);
coef_ramp > 0 ? (
  gm0 += gmd0; rl0 += rld0; rh0 += rhd0;
  gm1 += gmd1; rl1 += rld1; rh1 += rhd1;
  gm2 += gmd2; rl2 += rld2; rh2 += rhd2;
  gm3 += gmd3; rl3 += rld3; rh3 += rhd3;
  gm4 += gmd4; rl4 += rld4; rh4 += rhd4;
  gm5 += gmd5; rl5 += rld5; rh5 += rhd5;
  gm6 += gmd6; rl6 += rld6; rh6 += rhd6;
  gm7 += gmd7; rl7 += rld7; rh7 += rhd7;
  gm8 += gmd8; rl8 += rld8; rh8 += rhd8;
  gm9 += gmd9; rl9 += rld9; rh9 += rhd9;
  gm10 += gmd10; rl10 += rld10; rh10 += rhd10;
  gm11 += gmd11; rl11 += rld11; rh11 += rhd11;
  gm12 += gmd12; rl12 += rld12; rh12 += rhd12;
  gm13 += gmd13; rl13 += rld13; rh13 += rhd13;
  gm14 += gmd14; rl14 += rld14; rh14 += rhd14;
  gm15 += gmd15; rl15 += rld15; rh15 += rhd15;
  coef_ramp -= 1;
);
// ---- delay geometry: bounded glide toward the target lengths (settles to exact integers)
!geo_settled ? (
  geo_settled = 1;
  df = DTGT[0] - db0; (abs(df) < 0.000001 && abs(gv0) < 0.0001) ? ( db0 = DTGT[0]; gv0 = 0; ) : ( st = alpha_d * df; st > SSIZE ? st = SSIZE; st < -SSIZE ? st = -SSIZE; st -= gv0; st > SACC ? st = SACC; st < -SACC ? st = -SACC; gv0 += st; db0 += gv0; geo_settled = 0; );
