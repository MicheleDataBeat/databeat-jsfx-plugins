    su5 = zp4 * zp3; su4 = su5 * zp2; su3 = su4 * zp1; su2 = su3 * mu; su1 = su2 * zm1; su0 = su1 * zm2;
    hm3 = su0 * INVD0; hm2 = zm3 * su1 * INVD1; hm1 = pr2 * su2 * INVD2; h0 = pr3 * su3 * INVD3;
    h1 = pr4 * su4 * INVD4; h2 = pr5 * su5 * INVD5; h3 = pr6 * zp4 * INVD6; h4 = pr7 * INVD7;
    t0 = w15 - mm - 4; t0 < 0 ? t0 += ln15;
    (t0 + 7 < ln15 && mm + 4 <= vd15) ? (
      mem_get_values(bs15 + t0, r0, r1, r2, r3, r4, r5, r6, r7);
      d15 = h4 * r0 + h3 * r1 + h2 * r2 + h1 * r3 + h0 * r4 + hm1 * r5 + hm2 * r6 + hm3 * r7;
    ) : (
      acc = 0; tt = t0; ag = mm + 4; rp = bs15;
      acc += h4 * ((ag <= vd15) ? rp[tt] : 0); tt += 1; tt >= ln15 ? tt = 0; ag -= 1;
      acc += h3 * ((ag <= vd15) ? rp[tt] : 0); tt += 1; tt >= ln15 ? tt = 0; ag -= 1;
      acc += h2 * ((ag <= vd15) ? rp[tt] : 0); tt += 1; tt >= ln15 ? tt = 0; ag -= 1;
      acc += h1 * ((ag <= vd15) ? rp[tt] : 0); tt += 1; tt >= ln15 ? tt = 0; ag -= 1;
      acc += h0 * ((ag <= vd15) ? rp[tt] : 0); tt += 1; tt >= ln15 ? tt = 0; ag -= 1;
      acc += hm1 * ((ag <= vd15) ? rp[tt] : 0); tt += 1; tt >= ln15 ? tt = 0; ag -= 1;
      acc += hm2 * ((ag <= vd15) ? rp[tt] : 0); tt += 1; tt >= ln15 ? tt = 0; ag -= 1;
      acc += hm3 * ((ag <= vd15) ? rp[tt] : 0);
      d15 = acc;
    );
  );

  // ---- wet extraction (before scattering): C rows are Walsh signs, +-1/4
  y_l = 0.125 * WET_GAIN * env * (+ d0 + d1 + d2 + d3 - d4 - d5 - d6 - d7 + d8 + d9 + d10 + d11 - d12 - d13 - d14 - d15);
  y_r = 0.125 * WET_GAIN * env * (+ d0 + d1 + d2 + d3 + d4 + d5 + d6 + d7 - d8 - d9 - d10 - d11 - d12 - d13 - d14 - d15);

  // ---- scattering: four butterfly stages of one shared rotation, then signed permutation
  x0 = d0;
  x1 = d1;
  x2 = d2;
  x3 = d3;
  x4 = d4;
  x5 = d5;
  x6 = d6;
  x7 = d7;
  x8 = d8;
  x9 = d9;
  x10 = d10;
  x11 = d11;
  x12 = d12;
  x13 = d13;
  x14 = d14;
  x15 = d15;
