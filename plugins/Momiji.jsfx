desc:Momiji
//tags: reverb
//author: Michele Ibba (with Claude)
//version: 1.0
//SPDX-License-Identifier: MIT
options:no_meter gfx_hz=30 maxmem=16777216

// ============================================================================
//  MOMIJI -- algorithmic stereo reverb for REAPER (JSFX)
//
//  A 16-line feedback delay network, sample by sample, zero added latency:
//    stereo injection (Walsh vectors) -> 16 fractional delays (7th-order Lagrange)
//    -> orthogonal scattering (4-stage Givens butterfly, Density = rotation angle)
//    -> per-line low/high attenuation shelves + delay-proportional decay gain
//    -> writeback.  One quadrature oscillator drives balanced (opposite-pair)
//    delay modulation with a rate-dependent excursion cap.  Width (M/S) and Mix
//    follow.  The dry path is the current sample.
//
//  Layout of this file
//    header ....... 12 sliders (hidden; the UI is @gfx)
//    @init ........ constants, memory map, layout per sample rate, DSP functions,
//                   presets, Switch Flip
//    @slider ...... host/automation targets
//    @block ....... sample-rate check, preset/flip requests, tail size
//    @sample ...... the network
//    @serialize ... preset index and UI state
//    @gfx ......... the interface (900 x 400, fixed)
//
//  MIT licence. Copyright (c) 2026 Michele Ibba.
//  Permission is hereby granted, free of charge, to any person obtaining a copy
//  of this software and associated documentation files (the "Software"), to deal
//  in the Software without restriction, including without limitation the rights
//  to use, copy, modify, merge, publish, distribute, sublicense, and/or sell
//  copies of the Software, and to permit persons to whom the Software is
//  furnished to do so, subject to the following conditions: the above copyright
//  notice and this permission notice shall be included in all copies or
//  substantial portions of the Software. THE SOFTWARE IS PROVIDED "AS IS",
//  WITHOUT WARRANTY OF ANY KIND, EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED
//  TO THE WARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND
//  NONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE
//  FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION OF CONTRACT,
//  TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE OR
//  THE USE OR OTHER DEALINGS IN THE SOFTWARE.
//
//  Provenance. Every line of this file was written for Momiji; no code from any other
//  project is incorporated. Published techniques used from their descriptions: feedback
//  delay networks with per-line attenuation (Jot and Chaigne, 1991; Schlecht and Habets,
//  2017), orthogonal Givens-rotation scattering, Lagrange fractional-delay interpolation
//  (J. O. Smith, Physical Audio Signal Processing), the normalized echo-density measure used
//  in its verification (Abel and Huang, 2006). The delay ratios, presets, graphics and text
//  are original. Nothing from any commercial reverb is reproduced.
// ============================================================================

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

slider1:p_mix=30<0,100,0.1>-Mix (%)
slider2:p_delay=80<20,4000,0.1>-Delay (ms)
slider3:p_warp=55<0,100,0.1>-Warp (%)
slider4:p_density=100<0,100,0.1>-Density (%)
slider5:p_decay=2.6<0.2,40,0.01>-Decay (s)
slider6:p_lowdamp=30<0,100,0.1>-Low Damp (%)
slider7:p_highdamp=40<0,100,0.1>-High Damp (%)
slider8:p_rate=0.25<0.05,2,0.001>-Mod Rate (Hz)
slider9:p_depth=30<0,100,0.1>-Mod Depth (%)
slider10:p_width=110<0,200,0.1>-Width (%)
slider11:p_sync=0<0,1,1{Off,On}>-Sync
slider12:p_div=7<0,20,1{1/32T,1/32,1/32.,1/16T,1/16,1/16.,1/8T,1/8,1/8.,1/4T,1/4,1/4.,1/2T,1/2,1/2.,1T,1,1.,2T,2,2.}>-Sync Division

@init
ext_noinit = 1;
ext_nodenorm = 1;
pdc_delay = 0;
pdc_bot_ch = 0;
pdc_top_ch = 2;

// ---------------------------------------------------------------- constants
NLINES = 16;                      // sixteen lines: the per-line code is generated by tools/gen_core.py
HTICK = 32;                       // control clock, samples
KLN = 6.907755278982137;          // ln(1000)
S_MIN = 0.020; S_MAX = 4.0;       // longest line, seconds (the upper bound may be reduced by available memory)
EXP_LO = 0.35; EXP_HI = 1.20;     // warp: line i delay = S * r_i ^ e(w)
THETA0 = 0.04;                    // density angle floor (fraction of pi/4)
T_MIN = 0.2; T_MAX = 40;
T_FLOOR = 2;                      // effective decay >= this many longest-line transits
BL_MIN = 0.35; BH_MIN = 0.15;     // strongest low / high decay ratio
FC_L0 = 90; FC_L1 = 360;          // low shelf crossover Hz at damp 0 / 1
FC_H0 = 9000; FC_H1 = 2500;       // high shelf crossover Hz at damp 0 / 1
MOD_CENTS = 10; A_MAX = 0.0015;   // one-pass modulation slope budget (cents), max excursion (s)
SIZE_CENTS = 100;                 // delay-change glide: pitch-slope budget (cents); the slope itself ramps over SACC_MS
WET_GAIN = 10;                    // fixed wet scaling outside the loop (calibrated against level-matched references, see tests)
GMAX = 0.9995;                    // per-line scalar gain cap

// ---------------------------------------------------------------- memory map (slots)
RATIO = 0; LNR = 16; PERM = 32; SGN = 48; PHC = 64; PHS = 72;
BLV = 80; BRV = 96; CLV = 112; CRV = 128;
LBASE = 144; LLEN = 160;
DBASE = 208; DTGT = 224;
GMN = 240; RLN = 256; RHN = 272;   // per-line coefficient targets computed at control ticks
MENUMAP = 300; PVAL = 400;         // preset-menu index map (100 slots); values of the loaded preset (10 slots)
AUDIO = 4096;
PSTR_NAME = 100; PSTR_CAT = 200; PSTR_DATA = 300;   // string slots

RATIO[0]=0.184937; RATIO[1]=0.213183; RATIO[2]=0.233320; RATIO[3]=0.259929; RATIO[4]=0.286259; RATIO[5]=0.337378; RATIO[6]=0.358602; RATIO[7]=0.401350; 
RATIO[8]=0.466894; RATIO[9]=0.492980; RATIO[10]=0.544646; RATIO[11]=0.621198; RATIO[12]=0.739792; RATIO[13]=0.785371; RATIO[14]=0.906775; RATIO[15]=1.000000; 
PERM[0]=7; PERM[1]=12; PERM[2]=1; PERM[3]=14; PERM[4]=5; PERM[5]=0; PERM[6]=11; PERM[7]=8;
PERM[8]=3; PERM[9]=10; PERM[10]=15; PERM[11]=4; PERM[12]=13; PERM[13]=6; PERM[14]=9; PERM[15]=2;
SGN[0]=1; SGN[1]=-1; SGN[2]=-1; SGN[3]=1; SGN[4]=-1; SGN[5]=1; SGN[6]=1; SGN[7]=-1;
SGN[8]=1; SGN[9]=1; SGN[10]=-1; SGN[11]=-1; SGN[12]=1; SGN[13]=-1; SGN[14]=1; SGN[15]=-1;
i = 0;
loop(16,
  LNR[i] = log(RATIO[i]);
  // Walsh sign vectors v_k,i = (1 - 2 bit_k(i)) / 4 ; B is v0,v1 rotated 45 degrees so a
  // mono (L = R) input reaches all sixteen lines; C = v2, v3.
  b0 = (i & 1) ? -0.25 : 0.25; b1 = (i & 2) ? -0.25 : 0.25; b2 = (i & 4) ? -0.25 : 0.25; b3 = (i & 8) ? -0.25 : 0.25;
  BLV[i] = (b0 + b1) * 0.70710678118654752; BRV[i] = (b0 - b1) * 0.70710678118654752;
  CLV[i] = b2; CRV[i] = b3;
  i += 1;
);
i = 0;
loop(8, ph = 2 * $pi * ((3 * i) % 8) / 8; PHC[i] = cos(ph); PHS[i] = sin(ph); i += 1;);
INVD0 = -1/5040; INVD1 = 1/720; INVD2 = -1/240; INVD3 = 1/144; INVD4 = -1/144; INVD5 = 1/240; INVD6 = -1/720; INVD7 = 1/5040;
SMOD = 1 - 2^(-MOD_CENTS/1200);
function clamp(v, lo, hi) ( v < lo ? lo : v > hi ? hi : v );
// tempo sync: division k = 3 * base + variant; base beats 1/32 .. 2 whole notes, variant triplet / straight / dotted
DIVB = 464;
DIVB[0] = 0.125; DIVB[1] = 0.25; DIVB[2] = 0.5; DIVB[3] = 1; DIVB[4] = 2; DIVB[5] = 4; DIVB[6] = 8;
function div_seconds(k) local(b, v, beats) (
  k = clamp(floor(k + 0.5), 0, 20); b = floor(k / 3); v = k - 3 * b;
  beats = DIVB[b] * (v == 0 ? 2 / 3 : v == 1 ? 1 : 1.5);
  beats * 60 / (tempo > 1 ? tempo : 120);
);
SSIZE = 1 - 2^(-SIZE_CENTS/1200);


//@CORE_A_BEGIN (generated by tools/gen_core.py)
// per-line scalars: bs=buffer base, ln=length, w=write offset, vd=valid history count,
// db=base delay, gm/rl/rh=current coefficients (+d: per-sample ramp), lx/ly=one-pole states
function core_layout() (
  bs0 = LBASE[0]; ln0 = LLEN[0];
  bs1 = LBASE[1]; ln1 = LLEN[1];
  bs2 = LBASE[2]; ln2 = LLEN[2];
  bs3 = LBASE[3]; ln3 = LLEN[3];
  bs4 = LBASE[4]; ln4 = LLEN[4];
  bs5 = LBASE[5]; ln5 = LLEN[5];
  bs6 = LBASE[6]; ln6 = LLEN[6];
  bs7 = LBASE[7]; ln7 = LLEN[7];
  bs8 = LBASE[8]; ln8 = LLEN[8];
  bs9 = LBASE[9]; ln9 = LLEN[9];
  bs10 = LBASE[10]; ln10 = LLEN[10];
  bs11 = LBASE[11]; ln11 = LLEN[11];
  bs12 = LBASE[12]; ln12 = LLEN[12];
  bs13 = LBASE[13]; ln13 = LLEN[13];
  bs14 = LBASE[14]; ln14 = LLEN[14];
  bs15 = LBASE[15]; ln15 = LLEN[15];
);
// history invalidation: taps older than vd read as zero, so no buffer clear is needed
function tank_invalidate() (
  w0 = 0; vd0 = 0; lx1_0 = 0; ly1_0 = 0; lx2_0 = 0; ly2_0 = 0;
  w1 = 0; vd1 = 0; lx1_1 = 0; ly1_1 = 0; lx2_1 = 0; ly2_1 = 0;
  w2 = 0; vd2 = 0; lx1_2 = 0; ly1_2 = 0; lx2_2 = 0; ly2_2 = 0;
  w3 = 0; vd3 = 0; lx1_3 = 0; ly1_3 = 0; lx2_3 = 0; ly2_3 = 0;
  w4 = 0; vd4 = 0; lx1_4 = 0; ly1_4 = 0; lx2_4 = 0; ly2_4 = 0;
  w5 = 0; vd5 = 0; lx1_5 = 0; ly1_5 = 0; lx2_5 = 0; ly2_5 = 0;
  w6 = 0; vd6 = 0; lx1_6 = 0; ly1_6 = 0; lx2_6 = 0; ly2_6 = 0;
  w7 = 0; vd7 = 0; lx1_7 = 0; ly1_7 = 0; lx2_7 = 0; ly2_7 = 0;
  w8 = 0; vd8 = 0; lx1_8 = 0; ly1_8 = 0; lx2_8 = 0; ly2_8 = 0;
  w9 = 0; vd9 = 0; lx1_9 = 0; ly1_9 = 0; lx2_9 = 0; ly2_9 = 0;
  w10 = 0; vd10 = 0; lx1_10 = 0; ly1_10 = 0; lx2_10 = 0; ly2_10 = 0;
  w11 = 0; vd11 = 0; lx1_11 = 0; ly1_11 = 0; lx2_11 = 0; ly2_11 = 0;
  w12 = 0; vd12 = 0; lx1_12 = 0; ly1_12 = 0; lx2_12 = 0; ly2_12 = 0;
  w13 = 0; vd13 = 0; lx1_13 = 0; ly1_13 = 0; lx2_13 = 0; ly2_13 = 0;
  w14 = 0; vd14 = 0; lx1_14 = 0; ly1_14 = 0; lx2_14 = 0; ly2_14 = 0;
  w15 = 0; vd15 = 0; lx1_15 = 0; ly1_15 = 0; lx2_15 = 0; ly2_15 = 0;
);
function core_snap_geometry() (
  db0 = DTGT[0]; DBASE[0] = db0; gv0 = 0;
  db1 = DTGT[1]; DBASE[1] = db1; gv1 = 0;
  db2 = DTGT[2]; DBASE[2] = db2; gv2 = 0;
  db3 = DTGT[3]; DBASE[3] = db3; gv3 = 0;
  db4 = DTGT[4]; DBASE[4] = db4; gv4 = 0;
  db5 = DTGT[5]; DBASE[5] = db5; gv5 = 0;
  db6 = DTGT[6]; DBASE[6] = db6; gv6 = 0;
  db7 = DTGT[7]; DBASE[7] = db7; gv7 = 0;
  db8 = DTGT[8]; DBASE[8] = db8; gv8 = 0;
  db9 = DTGT[9]; DBASE[9] = db9; gv9 = 0;
  db10 = DTGT[10]; DBASE[10] = db10; gv10 = 0;
  db11 = DTGT[11]; DBASE[11] = db11; gv11 = 0;
  db12 = DTGT[12]; DBASE[12] = db12; gv12 = 0;
  db13 = DTGT[13]; DBASE[13] = db13; gv13 = 0;
  db14 = DTGT[14]; DBASE[14] = db14; gv14 = 0;
  db15 = DTGT[15]; DBASE[15] = db15; gv15 = 0;
  geo_settled = 1;
);
function core_export_db() (
  DBASE[0] = db0;
  DBASE[1] = db1;
  DBASE[2] = db2;
  DBASE[3] = db3;
  DBASE[4] = db4;
  DBASE[5] = db5;
  DBASE[6] = db6;
  DBASE[7] = db7;
  DBASE[8] = db8;
  DBASE[9] = db9;
  DBASE[10] = db10;
  DBASE[11] = db11;
  DBASE[12] = db12;
  DBASE[13] = db13;
  DBASE[14] = db14;
  DBASE[15] = db15;
);
function core_set_ramps() (
  gmd0 = (GMN[0] - gm0) / HTICK; rld0 = (RLN[0] - rl0) / HTICK; rhd0 = (RHN[0] - rh0) / HTICK;
  gmd1 = (GMN[1] - gm1) / HTICK; rld1 = (RLN[1] - rl1) / HTICK; rhd1 = (RHN[1] - rh1) / HTICK;
  gmd2 = (GMN[2] - gm2) / HTICK; rld2 = (RLN[2] - rl2) / HTICK; rhd2 = (RHN[2] - rh2) / HTICK;
  gmd3 = (GMN[3] - gm3) / HTICK; rld3 = (RLN[3] - rl3) / HTICK; rhd3 = (RHN[3] - rh3) / HTICK;
  gmd4 = (GMN[4] - gm4) / HTICK; rld4 = (RLN[4] - rl4) / HTICK; rhd4 = (RHN[4] - rh4) / HTICK;
  gmd5 = (GMN[5] - gm5) / HTICK; rld5 = (RLN[5] - rl5) / HTICK; rhd5 = (RHN[5] - rh5) / HTICK;
  gmd6 = (GMN[6] - gm6) / HTICK; rld6 = (RLN[6] - rl6) / HTICK; rhd6 = (RHN[6] - rh6) / HTICK;
  gmd7 = (GMN[7] - gm7) / HTICK; rld7 = (RLN[7] - rl7) / HTICK; rhd7 = (RHN[7] - rh7) / HTICK;
  gmd8 = (GMN[8] - gm8) / HTICK; rld8 = (RLN[8] - rl8) / HTICK; rhd8 = (RHN[8] - rh8) / HTICK;
  gmd9 = (GMN[9] - gm9) / HTICK; rld9 = (RLN[9] - rl9) / HTICK; rhd9 = (RHN[9] - rh9) / HTICK;
  gmd10 = (GMN[10] - gm10) / HTICK; rld10 = (RLN[10] - rl10) / HTICK; rhd10 = (RHN[10] - rh10) / HTICK;
  gmd11 = (GMN[11] - gm11) / HTICK; rld11 = (RLN[11] - rl11) / HTICK; rhd11 = (RHN[11] - rh11) / HTICK;
  gmd12 = (GMN[12] - gm12) / HTICK; rld12 = (RLN[12] - rl12) / HTICK; rhd12 = (RHN[12] - rh12) / HTICK;
  gmd13 = (GMN[13] - gm13) / HTICK; rld13 = (RLN[13] - rl13) / HTICK; rhd13 = (RHN[13] - rh13) / HTICK;
  gmd14 = (GMN[14] - gm14) / HTICK; rld14 = (RLN[14] - rl14) / HTICK; rhd14 = (RHN[14] - rh14) / HTICK;
  gmd15 = (GMN[15] - gm15) / HTICK; rld15 = (RLN[15] - rl15) / HTICK; rhd15 = (RHN[15] - rh15) / HTICK;
  coef_ramp = HTICK;
);
function core_snap_coefs() (
  gm0 = GMN[0]; rl0 = RLN[0]; rh0 = RHN[0]; gmd0 = 0; rld0 = 0; rhd0 = 0;
  gm1 = GMN[1]; rl1 = RLN[1]; rh1 = RHN[1]; gmd1 = 0; rld1 = 0; rhd1 = 0;
  gm2 = GMN[2]; rl2 = RLN[2]; rh2 = RHN[2]; gmd2 = 0; rld2 = 0; rhd2 = 0;
  gm3 = GMN[3]; rl3 = RLN[3]; rh3 = RHN[3]; gmd3 = 0; rld3 = 0; rhd3 = 0;
  gm4 = GMN[4]; rl4 = RLN[4]; rh4 = RHN[4]; gmd4 = 0; rld4 = 0; rhd4 = 0;
  gm5 = GMN[5]; rl5 = RLN[5]; rh5 = RHN[5]; gmd5 = 0; rld5 = 0; rhd5 = 0;
  gm6 = GMN[6]; rl6 = RLN[6]; rh6 = RHN[6]; gmd6 = 0; rld6 = 0; rhd6 = 0;
  gm7 = GMN[7]; rl7 = RLN[7]; rh7 = RHN[7]; gmd7 = 0; rld7 = 0; rhd7 = 0;
  gm8 = GMN[8]; rl8 = RLN[8]; rh8 = RHN[8]; gmd8 = 0; rld8 = 0; rhd8 = 0;
  gm9 = GMN[9]; rl9 = RLN[9]; rh9 = RHN[9]; gmd9 = 0; rld9 = 0; rhd9 = 0;
  gm10 = GMN[10]; rl10 = RLN[10]; rh10 = RHN[10]; gmd10 = 0; rld10 = 0; rhd10 = 0;
  gm11 = GMN[11]; rl11 = RLN[11]; rh11 = RHN[11]; gmd11 = 0; rld11 = 0; rhd11 = 0;
  gm12 = GMN[12]; rl12 = RLN[12]; rh12 = RHN[12]; gmd12 = 0; rld12 = 0; rhd12 = 0;
  gm13 = GMN[13]; rl13 = RLN[13]; rh13 = RHN[13]; gmd13 = 0; rld13 = 0; rhd13 = 0;
  gm14 = GMN[14]; rl14 = RLN[14]; rh14 = RHN[14]; gmd14 = 0; rld14 = 0; rhd14 = 0;
  gm15 = GMN[15]; rl15 = RLN[15]; rh15 = RHN[15]; gmd15 = 0; rld15 = 0; rhd15 = 0;
  coef_ramp = 0;
);
function core_flush_states() (
  abs(ly1_0) < 0.000000000000000000000001 ? ly1_0 = 0; abs(ly2_0) < 0.000000000000000000000001 ? ly2_0 = 0; abs(lx1_0) < 0.000000000000000000000001 ? lx1_0 = 0; abs(lx2_0) < 0.000000000000000000000001 ? lx2_0 = 0;
  abs(ly1_1) < 0.000000000000000000000001 ? ly1_1 = 0; abs(ly2_1) < 0.000000000000000000000001 ? ly2_1 = 0; abs(lx1_1) < 0.000000000000000000000001 ? lx1_1 = 0; abs(lx2_1) < 0.000000000000000000000001 ? lx2_1 = 0;
  abs(ly1_2) < 0.000000000000000000000001 ? ly1_2 = 0; abs(ly2_2) < 0.000000000000000000000001 ? ly2_2 = 0; abs(lx1_2) < 0.000000000000000000000001 ? lx1_2 = 0; abs(lx2_2) < 0.000000000000000000000001 ? lx2_2 = 0;
  abs(ly1_3) < 0.000000000000000000000001 ? ly1_3 = 0; abs(ly2_3) < 0.000000000000000000000001 ? ly2_3 = 0; abs(lx1_3) < 0.000000000000000000000001 ? lx1_3 = 0; abs(lx2_3) < 0.000000000000000000000001 ? lx2_3 = 0;
  abs(ly1_4) < 0.000000000000000000000001 ? ly1_4 = 0; abs(ly2_4) < 0.000000000000000000000001 ? ly2_4 = 0; abs(lx1_4) < 0.000000000000000000000001 ? lx1_4 = 0; abs(lx2_4) < 0.000000000000000000000001 ? lx2_4 = 0;
  abs(ly1_5) < 0.000000000000000000000001 ? ly1_5 = 0; abs(ly2_5) < 0.000000000000000000000001 ? ly2_5 = 0; abs(lx1_5) < 0.000000000000000000000001 ? lx1_5 = 0; abs(lx2_5) < 0.000000000000000000000001 ? lx2_5 = 0;
  abs(ly1_6) < 0.000000000000000000000001 ? ly1_6 = 0; abs(ly2_6) < 0.000000000000000000000001 ? ly2_6 = 0; abs(lx1_6) < 0.000000000000000000000001 ? lx1_6 = 0; abs(lx2_6) < 0.000000000000000000000001 ? lx2_6 = 0;
  abs(ly1_7) < 0.000000000000000000000001 ? ly1_7 = 0; abs(ly2_7) < 0.000000000000000000000001 ? ly2_7 = 0; abs(lx1_7) < 0.000000000000000000000001 ? lx1_7 = 0; abs(lx2_7) < 0.000000000000000000000001 ? lx2_7 = 0;
  abs(ly1_8) < 0.000000000000000000000001 ? ly1_8 = 0; abs(ly2_8) < 0.000000000000000000000001 ? ly2_8 = 0; abs(lx1_8) < 0.000000000000000000000001 ? lx1_8 = 0; abs(lx2_8) < 0.000000000000000000000001 ? lx2_8 = 0;
  abs(ly1_9) < 0.000000000000000000000001 ? ly1_9 = 0; abs(ly2_9) < 0.000000000000000000000001 ? ly2_9 = 0; abs(lx1_9) < 0.000000000000000000000001 ? lx1_9 = 0; abs(lx2_9) < 0.000000000000000000000001 ? lx2_9 = 0;
  abs(ly1_10) < 0.000000000000000000000001 ? ly1_10 = 0; abs(ly2_10) < 0.000000000000000000000001 ? ly2_10 = 0; abs(lx1_10) < 0.000000000000000000000001 ? lx1_10 = 0; abs(lx2_10) < 0.000000000000000000000001 ? lx2_10 = 0;
  abs(ly1_11) < 0.000000000000000000000001 ? ly1_11 = 0; abs(ly2_11) < 0.000000000000000000000001 ? ly2_11 = 0; abs(lx1_11) < 0.000000000000000000000001 ? lx1_11 = 0; abs(lx2_11) < 0.000000000000000000000001 ? lx2_11 = 0;
  abs(ly1_12) < 0.000000000000000000000001 ? ly1_12 = 0; abs(ly2_12) < 0.000000000000000000000001 ? ly2_12 = 0; abs(lx1_12) < 0.000000000000000000000001 ? lx1_12 = 0; abs(lx2_12) < 0.000000000000000000000001 ? lx2_12 = 0;
  abs(ly1_13) < 0.000000000000000000000001 ? ly1_13 = 0; abs(ly2_13) < 0.000000000000000000000001 ? ly2_13 = 0; abs(lx1_13) < 0.000000000000000000000001 ? lx1_13 = 0; abs(lx2_13) < 0.000000000000000000000001 ? lx2_13 = 0;
  abs(ly1_14) < 0.000000000000000000000001 ? ly1_14 = 0; abs(ly2_14) < 0.000000000000000000000001 ? ly2_14 = 0; abs(lx1_14) < 0.000000000000000000000001 ? lx1_14 = 0; abs(lx2_14) < 0.000000000000000000000001 ? lx2_14 = 0;
  abs(ly1_15) < 0.000000000000000000000001 ? ly1_15 = 0; abs(ly2_15) < 0.000000000000000000000001 ? ly2_15 = 0; abs(lx1_15) < 0.000000000000000000000001 ? lx1_15 = 0; abs(lx2_15) < 0.000000000000000000000001 ? lx2_15 = 0;
);
//@CORE_A_END
// ---------------------------------------------------------------- layout per sample rate
function layout_init() local(k, tot)
(
  fs = srate;
  // the longest reservable line at this rate: the 16 buffers (largest ratio family, EXP_LO) must fit
  rsum = 0; k = 0; loop(16, rsum += exp(EXP_LO * LNR[k]); k += 1;);
  s_max_eff = min(S_MAX, (__memtop() - AUDIO - 16 * 17 - 16 * fs * A_MAX) / (fs * rsum));
  tot = AUDIO; k = 0;
  loop(16,
    LLEN[k] = ceil(fs * (s_max_eff * exp(EXP_LO * LNR[k]) + A_MAX)) + 16;
    LBASE[k] = tot; tot += LLEN[k];
    k += 1;
  );
  mem_total = tot;
  core_layout();
  mem_ok = (mem_total <= __memtop()) && (s_max_eff >= 2 * S_MIN) && (fs >= 44100) && (fs <= 384000);
  alpha_d = 1 - exp(-1 / (0.080 * fs));
  SACC = SSIZE / (0.020 * fs);   // glide acceleration limit: full slope reached over 20 ms, no pitch step
  alpha_a = 1 - exp(-1 / (0.100 * fs));
  a_slew = 0.2 * SMOD / fs;
  sm_rho = 1 - exp(-HTICK / (fs * 0.050));
  sm_log = 1 - exp(-HTICK / (fs * 0.100));
  sm_f = 1 - exp(-HTICK / (fs * 0.150));
  sm_m = 1 - exp(-HTICK / (fs * 0.100));
  sm_out = 1 - exp(-1 / (fs * 0.020));   // mix / width, per sample
  fade_len = floor(0.020 * fs + 0.5);
  declick_len = floor(0.005 * fs + 0.5);
  dsp_rate = fs;
);


// ---------------------------------------------------------------- parameter targets
function read_targets()
(
  sync_on = p_sync > 0.5;
  t_S = clamp(sync_on ? div_seconds(p_div) : p_delay * 0.001, S_MIN, s_max_eff);
  t_w = clamp(p_warp, 0, 100) * 0.01;
  t_rho = clamp(p_density, 0, 100) * 0.01;
  t_lnT = log(clamp(p_decay, T_MIN, T_MAX));
  t_dl = clamp(p_lowdamp, 0, 100) * 0.01;
  t_dh = clamp(p_highdamp, 0, 100) * 0.01;
  t_f = clamp(p_rate, 0.05, 2);
  t_m = clamp(p_depth, 0, 100) * 0.01;
  t_mix = clamp(p_mix, 0, 100) * 0.01;
  t_width = clamp(p_width, 0, 200) * 0.01;
);

function geometry_targets() local(k, e)
(
  e = EXP_LO + (EXP_HI - EXP_LO) * cur_w;
  k = 0;
  loop(16, DTGT[k] = floor(fs * cur_S * exp(e * LNR[k]) + 0.5); k += 1;);
  geo_settled = 0;
);

function lp_coefs(fc) local(kk)
(
  kk = tan($pi * fc / fs);
  lp_a = (1 - kk) / (1 + kk); lp_b = kk / (1 + kk);
);

// per-line decay / shelf coefficient targets from the current base transits
function coef_targets() local(k, tr, tau, betal, betah, tl, th)
(
  tr = exp(s_lnT);
  t_eff = max(tr, T_FLOOR * DBASE[15] / fs);
  betal = 1 - (1 - BL_MIN) * s_dl; betah = 1 - (1 - BH_MIN) * s_dh;
  tl = betal * t_eff; th = betah * t_eff;
  k = 0;
  loop(16,
    tau = DBASE[k] / fs;
    GMN[k] = min(GMAX, exp(-KLN * tau / t_eff));
    RLN[k] = exp(-KLN * tau * (1 / tl - 1 / t_eff));
    RHN[k] = exp(-KLN * tau * (1 / th - 1 / t_eff));
    k += 1;
  );
  lp_coefs(FC_L0 * exp(log(FC_L1 / FC_L0) * s_dl)); lpa_l = lp_a; lpb_l = lp_b;
  lp_coefs(FC_H0 * exp(log(FC_H1 / FC_H0) * s_dh)); lpa_h = lp_a; lpb_h = lp_b;
);

function snap_all() local(k)
(
  read_targets();
  cur_sync = sync_on; cur_div = p_div;
  cur_S = t_S; cur_w = t_w; geometry_targets(); core_snap_geometry();
  s_rho = t_rho; s_lnT = t_lnT; s_dl = t_dl; s_dh = t_dh; s_f = t_f; s_m = t_m;
  theta = 0.25 * $pi * (THETA0 + (1 - THETA0) * (s_rho ^ 1.6)); theta_d = 0; cth = cos(theta); sth = sin(theta);
  coef_targets(); core_snap_coefs();
  a_target = s_m * min(A_MAX, 0.8 * SMOD / (2 * $pi * s_f));
  amp = 0;
  f_actual = s_f; omega = 2 * $pi * f_actual / fs; cw = cos(omega); sw = sin(omega);
  g_mix_w = sin(t_mix * 0.5 * $pi); g_mix_d = cos(t_mix * 0.5 * $pi); g_width = t_width;
  tick_ctr = 0;
);

// request a fade-out followed by a restart on the current targets (preset recall, flip, sync change);
// a request during the fade-in continues from the current envelope level, a request during a
// fade-out is coalesced
function request_restart() (
  fade_mode == 2 ? ( fade_n = floor(fade_len * acos(clamp(2 * env - 1, -1, 1)) / $pi + 0.5); fade_mode = 1; )
  : fade_mode == 0 ? ( fade_mode = 1; fade_n = 0; );
);

// one control tick: smooth targets, set the coefficient ramps for the next HTICK samples
function control_tick() local(k, th_new)
(
  read_targets();
  (sync_on !== cur_sync || (sync_on && p_div !== cur_div)) ? ( cur_sync = sync_on; cur_div = p_div; request_restart(); );
  (t_S !== cur_S || t_w !== cur_w) ? ( cur_S = t_S; cur_w = t_w; geometry_targets(); );
  s_rho += sm_rho * (t_rho - s_rho);
  s_lnT += sm_log * (t_lnT - s_lnT);
  s_dl += sm_log * (t_dl - s_dl);
  s_dh += sm_log * (t_dh - s_dh);
  s_f += sm_f * (t_f - s_f);
  s_m += sm_m * (t_m - s_m);
  (t_m === 0 && s_m < 0.000000001) ? s_m = 0;
  th_new = 0.25 * $pi * (THETA0 + (1 - THETA0) * (s_rho ^ 1.6));
  theta_d = (th_new - theta) / HTICK;
  abs(th_new - theta) < 0.0000000001 ? ( theta = th_new; theta_d = 0; cth = cos(theta); sth = sin(theta); );
  // exact comparisons (===, !==) throughout the DSP: EEL2's == and != carry a 1e-5 tolerance
  theta_end = th_new;
  core_export_db();
  coef_targets(); core_set_ramps();
  a_target = s_m * min(A_MAX, 0.8 * SMOD / (2 * $pi * s_f));
  f_actual = min(s_f, 0.8 * SMOD / (2 * $pi * max(max(amp, a_target), 0.000000000000000000000000000001)));
  omega = 2 * $pi * f_actual / fs; cw = cos(omega); sw = sin(omega);
  core_flush_states();   // denormal guard (ext_nodenorm is on)
  // oscillator amplitude maintenance
  osc_ctr += HTICK;
  osc_ctr >= 4096 ? (
    osc_ctr = 0; nn = oc * oc + os * os;
    (nn > 0.5 && nn < 2) ? ( nn = 1 / sqrt(nn); oc *= nn; os *= nn; ) : ( oc = 1; os = 0; fault_osc += 1; );
  );
  ext_tail_size = ceil(fs * min(90, 3 * t_eff + 1));
);

// full restart of the network (after a fade-out, a fault, or a sample-rate change)
function tank_restart()
(
  tank_invalidate();
  snap_all();
  fade_mode = 2; fade_n = 0; env = 0;
);

// ---------------------------------------------------------------- presets
// One string of "index=value" pairs per preset (all ten sliders). Loading snaps every
// smoothed quantity to the new state through a 20 ms fade-out / restart / fade-in.
NPRESET = 0;
function preset_add(name, cat, data)
(
  NPRESET < 100 ? (
    strcpy(PSTR_NAME + NPRESET, name); strcpy(PSTR_CAT + NPRESET, cat); strcpy(PSTR_DATA + NPRESET, data);
    NPRESET += 1;
  );
);
function preset_parse(str) local(n, i, ch, state, num, sign, frac, scale, key)
(
  n = strlen(str);
  i = 0; state = 0; key = 0; num = 0; sign = 1; frac = 0; scale = 1;
  while (i <= n) (
    ch = i < n ? str_getchar(str, i) : 32;
    ch == $'=' ? ( key = num * sign; num = 0; sign = 1; frac = 0; scale = 1; state = 1; )
    : ch == $'-' ? sign = -1
    : ch == $'.' ? frac = 1
    : (ch >= $'0' && ch <= $'9') ? ( frac ? ( scale *= 0.1; num += (ch - $'0') * scale; ) : num = num * 10 + (ch - $'0'); )
    : (ch == 32 || ch == 10 || ch == 13 || ch == 9 || ch == $',') ? (
      state == 1 && key >= 1 && key <= 10 ? PVAL[key - 1] = num * sign;
      num = 0; sign = 1; frac = 0; scale = 1; state = 0;
    );
    i += 1;
  );
);
function preset_apply_string(str) local(k) ( preset_parse(str); k = 1; while (k <= 10) ( slider(k) = PVAL[k - 1]; k += 1; ); );
// the edited marker: any of the ten sound controls away from the loaded preset's value
function preset_check_dirty() local(k, d) ( d = 0; k = 1; while (k <= 10) ( abs(slider(k) - PVAL[k - 1]) > 0.0005 ? d = 1; k += 1; ); preset_dirty = d; );
function preset_load(idx)
(
  idx >= 0 && idx < NPRESET ? (
    preset_apply_string(PSTR_DATA + idx);
    preset_idx = idx;
    sliderchange(-1);
    request_restart();   // fade the old tank out, then restart on the new state
    preset_dirty = 0;
    1
  ) : 0;
);

// ---------------------------------------------------------------- Switch Flip
// A new musically coherent state: one of eight archetypes with bounded, correlated variation.
// Mix is left where the user has it (send or insert context is theirs); Width moves mildly.
function rnd01() ( flip_seed = (flip_seed * 1664525 + 1013904223) % 4294967296; flip_seed / 4294967296 );
function rrange(lo, hi) ( lo + (hi - lo) * rnd01() );
function rlog(lo, hi) ( lo * exp(log(hi / lo) * rnd01()) );
function flip_generate() local(a, dly, dec, dens, warp, dl, dh, rate, depth, wid)
(
  flip_count += 1;
  a = floor(rnd01() * 8);
  a == 0 ? ( // tight room
    dly = rlog(22, 45); warp = rrange(55, 95); dens = rrange(80, 100); dec = rlog(0.3, 0.9);
    dl = rrange(20, 60); dh = rrange(30, 70); rate = rlog(0.1, 0.6); depth = rrange(0, 30); )
  : a == 1 ? ( // medium hall
    dly = rlog(60, 120); warp = rrange(45, 85); dens = rrange(75, 100); dec = rlog(1.2, 3.0);
    dl = rrange(15, 55); dh = rrange(25, 65); rate = rlog(0.15, 0.6); depth = rrange(15, 45); )
  : a == 2 ? ( // long ambient
    dly = rlog(90, 220); warp = rrange(50, 90); dens = rrange(80, 100); dec = rlog(5, 18);
    dl = rrange(35, 80); dh = rrange(30, 70); rate = rlog(0.08, 0.35); depth = rrange(25, 60); )
  : a == 3 ? ( // lush modulated
    dly = rlog(50, 140); warp = rrange(40, 80); dens = rrange(85, 100); dec = rlog(2, 8);
    dl = rrange(25, 60); dh = rrange(20, 55); rate = rlog(0.25, 1.2); depth = rrange(55, 100); )
  : a == 4 ? ( // dark
    dly = rlog(50, 160); warp = rrange(40, 90); dens = rrange(70, 100); dec = rlog(1.5, 6);
    dl = rrange(30, 70); dh = rrange(70, 100); rate = rlog(0.1, 0.5); depth = rrange(10, 45); )
  : a == 5 ? ( // bright / open
    dly = rlog(40, 110); warp = rrange(50, 100); dens = rrange(80, 100); dec = rlog(1.0, 4);
    dl = rrange(30, 70); dh = rrange(0, 20); rate = rlog(0.1, 0.5); depth = rrange(10, 40); )
  : a == 6 ? ( // echo-verb cluster
    dly = rlog(180, 600); warp = rrange(0, 30); dens = rrange(5, 40); dec = rlog(2, 6);
    dl = rrange(30, 70); dh = rrange(35, 80); rate = rlog(0.1, 0.5); depth = rrange(10, 50); )
  : ( // wide bloom
    dly = rlog(120, 300); warp = rrange(30, 70); dens = rrange(50, 90); dec = rlog(3, 10);
    dl = rrange(40, 80); dh = rrange(40, 75); rate = rlog(0.1, 0.4); depth = rrange(30, 70); );
  // dependencies: long tails get more low damping; fast rates get less depth; very long delays keep decay finite
  dec > 6 ? dl = max(dl, 40);
  rate > 0.8 ? depth = min(depth, 60);
  dly > 300 ? dec = min(dec, 8);
  wid = rrange(85, 130);
  p_delay = floor(dly + 0.5); p_warp = floor(warp + 0.5); p_density = floor(dens + 0.5);
  p_decay = floor(dec * 100 + 0.5) / 100; p_lowdamp = floor(dl + 0.5); p_highdamp = floor(dh + 0.5);
  p_rate = floor(rate * 100 + 0.5) / 100; p_depth = floor(depth + 0.5); p_width = floor(wid + 0.5);
  sliderchange(-1);
  request_restart();
  preset_dirty = 1;
  flip_archetype = a;   // read by the test build's telemetry
);

// ---------------------------------------------------------------- factory library
