desc:Satya
//tags: instrument synthesizer
//author: Michele Ibba (with Claude)
//version: 1.0.0
options:maxmem=16000000
//@TEST_OPTIONS

// ============================================================================
//  SATYA -- polyphonic wavetable synthesizer for REAPER (JSFX)
//  MIT licence, copyright and attribution: see the block at the end of this file.
//
//  Layout of this file
//    header ......... 206 sliders (hidden from the generic UI, all automatable)
//    @init .......... memory map, wavetable generation, voice/MIDI/modulation,
//                     effects, presets, the factory library
//    @block ......... MIDI -> events, voice-major rendering, effects
//    @sample ........ output of the block buffer
//    @gfx ........... the interface
// ============================================================================

in_pin:none
out_pin:left output
out_pin:right output

// ---------------------------------------------------------------- global
slider1:vol=0<-60,12,0.1>-Master Volume (dB)
slider2:vspread=0<0,1,0.01>-Voice Pan Spread
slider3:vmode=0<0,2,1{Poly,Mono,Legato}>-Voice Mode
slider4:glide=0<0,1,0.001>-Glide Time
slider5:glide_leg=0<0,1,1{Always,Legato only}>-Glide Mode
slider6:bendrange=2<0,24,1>-Pitch Bend Range
slider7:polymax=16<1,16,1>-Polyphony
slider8:velcurve=0<-1,1,0.01>-Velocity Curve
slider9:drift=0<0,1,0.01>-Analog Drift
slider10:outwidth=1<0,2,0.01>-Stereo Width
// ---------------------------------------------------------------- osc A
slider11:a_on=1<0,1,1>-Osc A On
slider12:a_bank=0<0,15,1{Basic,Warm,Pulse,FM One,FM Two,FM Even,Sync,Vowel,Organ,Bell,Digital,Fold,Grit,Air,OddEven,Decay}>-Osc A Bank
slider13:a_pos=0.4<0,1,0.001>-Osc A Position
slider14:a_warp=0<0,5,1{Off,Bend,Sync,Mirror,Quantize,Formant}>-Osc A Warp Mode
slider15:a_warpamt=0<0,1,0.001>-Osc A Warp
slider16:a_semi=0<-36,36,1>-Osc A Semitones
slider17:a_fine=0<-100,100,0.1>-Osc A Fine (cents)
slider18:a_level=-6<-60,12,0.1>-Osc A Level (dB)
slider19:a_pan=0<-1,1,0.01>-Osc A Pan
slider20:a_uni=1<1,8,1>-Osc A Unison
slider21:a_unidet=0.25<0,1,0.001>-Osc A Unison Detune
slider22:a_unispread=0.5<0,1,0.001>-Osc A Unison Spread
slider23:a_uniblend=0.7<0,1,0.001>-Osc A Unison Blend
slider24:a_retrig=0<0,1,1{Free,Reset}>-Osc A Phase
slider25:a_key=1<0,1,1>-Osc A Keytrack
// ---------------------------------------------------------------- osc B
slider26:b_on=0<0,1,1>-Osc B On
slider27:b_bank=0<0,15,1{Basic,Warm,Pulse,FM One,FM Two,FM Even,Sync,Vowel,Organ,Bell,Digital,Fold,Grit,Air,OddEven,Decay}>-Osc B Bank
slider28:b_pos=0<0,1,0.001>-Osc B Position
slider29:b_warp=0<0,5,1{Off,Bend,Sync,Mirror,Quantize,Formant}>-Osc B Warp Mode
slider30:b_warpamt=0<0,1,0.001>-Osc B Warp
slider31:b_semi=0<-36,36,1>-Osc B Semitones
slider32:b_fine=0<-100,100,0.1>-Osc B Fine (cents)
slider33:b_level=-6<-60,12,0.1>-Osc B Level (dB)
slider34:b_pan=0<-1,1,0.01>-Osc B Pan
slider35:b_uni=1<1,8,1>-Osc B Unison
slider36:b_unidet=0.25<0,1,0.001>-Osc B Unison Detune
slider37:b_unispread=0.5<0,1,0.001>-Osc B Unison Spread
slider38:b_uniblend=0.7<0,1,0.001>-Osc B Unison Blend
slider39:b_retrig=0<0,1,1{Free,Reset}>-Osc B Phase
slider40:b_key=1<0,1,1>-Osc B Keytrack
slider41:b_pm=0<0,1,0.001>-Osc B Phase Mod from A
slider42:ringmod=0<0,1,0.001>-Ring Mod A x B
// ---------------------------------------------------------------- sub / noise
slider43:sub_level=-60<-60,12,0.1>-Sub Level (dB)
slider44:sub_shape=0<0,2,1{Sine,Triangle,Square}>-Sub Shape
slider45:sub_oct=0<0,1,1{-1 oct,-2 oct}>-Sub Octave
slider46:noise_level=-60<-60,12,0.1>-Noise Level (dB)
slider47:noise_color=0<-1,1,0.01>-Noise Color
// ---------------------------------------------------------------- filters
slider48:f1_type=1<0,8,1{Off,LP 12,LP 24,HP 12,HP 24,BP 12,BP 24,Notch,Ladder}>-Filter 1 Type
slider49:f1_cut=1<0,1,0.0001>-Filter 1 Cutoff
slider50:f1_res=0.2<0,1,0.001>-Filter 1 Resonance
slider51:f1_drive=0<0,1,0.001>-Filter 1 Drive
slider52:f1_key=0<0,1,0.01>-Filter 1 Keytrack
slider53:f1_env=0<-1,1,0.001>-Filter 1 Env 2 Amount
slider54:f1_env3=0<-1,1,0.001>-Filter 1 Env 3 Amount
slider55:f2_type=0<0,8,1{Off,LP 12,LP 24,HP 12,HP 24,BP 12,BP 24,Notch,Ladder}>-Filter 2 Type
slider56:f2_cut=1<0,1,0.0001>-Filter 2 Cutoff
slider57:f2_res=0.2<0,1,0.001>-Filter 2 Resonance
slider58:f2_drive=0<0,1,0.001>-Filter 2 Drive
slider59:f2_key=0<0,1,0.01>-Filter 2 Keytrack
slider60:f2_env=0<-1,1,0.001>-Filter 2 Env 2 Amount
slider61:f2_env3=0<-1,1,0.001>-Filter 2 Env 3 Amount
slider62:froute=0<0,2,1{Series,Parallel,Split A/B}>-Filter Routing
slider63:fmix=0<-1,1,0.01>-Filter Mix
// ---------------------------------------------------------------- envelopes (6 each)
slider64:e1_a=0.05<0,1,0.001>-Env 1 Attack
slider65:e1_d=0.4<0,1,0.001>-Env 1 Decay
slider66:e1_s=0.8<0,1,0.001>-Env 1 Sustain
slider67:e1_r=0.4<0,1,0.001>-Env 1 Release
slider68:e1_c=0<-1,1,0.01>-Env 1 Curve
slider69:e1_v=0.5<0,1,0.01>-Env 1 Velocity
slider70:e2_a=0.05<0,1,0.001>-Env 2 Attack
slider71:e2_d=0.5<0,1,0.001>-Env 2 Decay
slider72:e2_s=0.3<0,1,0.001>-Env 2 Sustain
slider73:e2_r=0.4<0,1,0.001>-Env 2 Release
slider74:e2_c=0<-1,1,0.01>-Env 2 Curve
slider75:e2_v=0<0,1,0.01>-Env 2 Velocity
slider76:e3_a=0.3<0,1,0.001>-Env 3 Attack
slider77:e3_d=0.5<0,1,0.001>-Env 3 Decay
slider78:e3_s=0.5<0,1,0.001>-Env 3 Sustain
slider79:e3_r=0.5<0,1,0.001>-Env 3 Release
slider80:e3_c=0<-1,1,0.01>-Env 3 Curve
slider81:e3_v=0<0,1,0.01>-Env 3 Velocity
// ---------------------------------------------------------------- LFOs (8 each)
slider82:l1_shape=0<0,7,1{Sine,Triangle,Saw Up,Saw Down,Square,Sample&Hold,Smooth Random,Pulse}>-LFO 1 Shape
slider83:l1_rate=0.6<0,1,0.001>-LFO 1 Rate
slider84:l1_sync=0<0,1,1>-LFO 1 Sync
slider85:l1_div=5<0,12,1{4/1,2/1,1/1,1/2,1/2.,1/4,1/4.,1/4T,1/8,1/8.,1/8T,1/16,1/32}>-LFO 1 Division
slider86:l1_phase=0<0,1,0.001>-LFO 1 Phase
slider87:l1_fade=0<0,1,0.001>-LFO 1 Fade In
slider88:l1_mode=0<0,1,1{Poly,Mono}>-LFO 1 Mode
slider89:l1_uni=0<0,1,1{Bipolar,Unipolar}>-LFO 1 Polarity
slider90:l2_shape=0<0,7,1{Sine,Triangle,Saw Up,Saw Down,Square,Sample&Hold,Smooth Random,Pulse}>-LFO 2 Shape
slider91:l2_rate=0.5<0,1,0.001>-LFO 2 Rate
slider92:l2_sync=0<0,1,1>-LFO 2 Sync
slider93:l2_div=5<0,12,1{4/1,2/1,1/1,1/2,1/2.,1/4,1/4.,1/4T,1/8,1/8.,1/8T,1/16,1/32}>-LFO 2 Division
slider94:l2_phase=0<0,1,0.001>-LFO 2 Phase
slider95:l2_fade=0<0,1,0.001>-LFO 2 Fade In
slider96:l2_mode=0<0,1,1{Poly,Mono}>-LFO 2 Mode
slider97:l2_uni=0<0,1,1{Bipolar,Unipolar}>-LFO 2 Polarity
slider98:l3_shape=0<0,7,1{Sine,Triangle,Saw Up,Saw Down,Square,Sample&Hold,Smooth Random,Pulse}>-LFO 3 Shape
slider99:l3_rate=0.3<0,1,0.001>-LFO 3 Rate
slider100:l3_sync=0<0,1,1>-LFO 3 Sync
slider101:l3_div=5<0,12,1{4/1,2/1,1/1,1/2,1/2.,1/4,1/4.,1/4T,1/8,1/8.,1/8T,1/16,1/32}>-LFO 3 Division
slider102:l3_phase=0<0,1,0.001>-LFO 3 Phase
slider103:l3_fade=0<0,1,0.001>-LFO 3 Fade In
slider104:l3_mode=1<0,1,1{Poly,Mono}>-LFO 3 Mode
slider105:l3_uni=0<0,1,1{Bipolar,Unipolar}>-LFO 3 Polarity
// ---------------------------------------------------------------- macros
slider106:macro1=0<0,1,0.001>-Macro 1
slider107:macro2=0<0,1,0.001>-Macro 2
slider108:macro3=0<0,1,0.001>-Macro 3
slider109:macro4=0<0,1,0.001>-Macro 4
