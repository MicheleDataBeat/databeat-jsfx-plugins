//@PRESETS_END
tables_ready = 1;
sidx = 0;
cpu_us = 0;
gpos = 0;

@slider
preset_dirty = 1;

@block
// ---- MIDI: gather events with their offsets
nev = 0;
while (midirecv(ofs, m1, m2, m3)) (
  nev < 4096 ? (
    EVQ[nev * 4] = ofs; EVQ[nev * 4 + 1] = m1; EVQ[nev * 4 + 2] = m2; EVQ[nev * 4 + 3] = m3;
    nev += 1;
  );
  midisend(ofs, m1, m2, m3);
);
tb0 = time_precise();
fx_srate != srate ? fx_init();
preset_pending >= 0 ? ( preset_load(preset_pending); preset_pending = -1; );
nblk = min(samplesblock, MAXBLOCK);
memset(BUFL, 0, nblk);
memset(BUFR, 0, nblk);
pos = 0; ev = 0; lim_gmin = 1;
while (pos < nblk) (
  // control chunks end on the CTRL grid counted from the first block (independent of block size)
  while (ev < nev && EVQ[ev * 4] <= pos) (
    handle_event(EVQ[ev * 4 + 1], EVQ[ev * 4 + 2], EVQ[ev * 4 + 3]);
    ev += 1;
  );
  nxt = min((floor((gpos + pos) / CTRL) + 1) * CTRL - gpos, nblk);
  // sample-accurate note starts: split at the next note on/off; CCs, bend and pressure wait
  // for the control boundary, which bounds the control-rate work under dense controller data
  k = ev; while (k < nev && (EVQ[k * 4 + 1] & $xE0) != $x80) ( k += 1; );
  k < nev ? nxt = min(nxt, max(EVQ[k * 4], pos + 1));
  n = nxt - pos;
  global_control(n);
  vi = 0;
  loop(NSLOT,
    voice_addr(vi)[V_STATE] != 0 ? voice_render(vi, pos, n);
    vi += 1;
  );
  // a constant far below hearing keeps every one-pole and feedback line in the effects
  // away from denormal territory (ext_nodenorm is on: REAPER's own guard only touches inputs)
  i = pos; loop(n, BUFL[i] += 0.000000000000000001; BUFR[i] += 0.000000000000000001; i += 1;);
  // ---- global matrix and effects for this chunk: effect modulation follows the same control
  //      grid as the voices, so the result does not depend on the host buffer size
  run_matrix_global();
  fx_process(pos, n);
  pos = nxt;
);
// events at or beyond the block end (should not happen) are applied now
while (ev < nev) ( handle_event(EVQ[ev * 4 + 1], EVQ[ev * 4 + 2], EVQ[ev * 4 + 3]); ev += 1; );
lim_gr = lim_gmin;   // deepest limiter gain of the block, for the meter
cpu_us = 0.9 * cpu_us + 0.1 * (time_precise() - tb0) * 1000000;
gpos += nblk;   // running sample counter: the control grid and the effect LFOs follow it
                // (play_position is not reliable inside an offline render, measured 2026-09-05)
//@TEST_TELEMETRY
sidx = 0;

@sample
sidx < nblk ? ( spl0 = BUFL[sidx]; spl1 = BUFR[sidx]; ) : ( spl0 = 0; spl1 = 0; );
sidx += 1;

@gfx 1400 900
// ============================================================================
//  GUI -- immediate-mode widgets drawn with gfx; runs on the UI thread.
//  Layout is written in design units (1120 x 720). UI_ZOOM enlarges it (the window is
//  1400 x 900 points) and the retina factor doubles the pixels behind it, so text and
//  lines are drawn sharp instead of being upscaled by the OS.
// ============================================================================
UI_ZOOM = 1.25;
ui_s = UI_ZOOM * (gfx_ext_retina > 1 ? gfx_ext_retina : 1);
ui_mx = mouse_x / ui_s; ui_my = mouse_y / ui_s;
function rect(x, y, w, h, f) ( gfx_rect(x * ui_s, y * ui_s, w * ui_s, h * ui_s, f); );
function line(x0, y0, x1, y1, aa) ( gfx_line(x0 * ui_s, y0 * ui_s, x1 * ui_s, y1 * ui_s, aa); );
function circle(x, y, r, f, aa) ( gfx_circle(x * ui_s, y * ui_s, r * ui_s, f, aa); );
// arcs are drawn as a ring of 1-px arcs so a 1-unit ring stays solid at any scale
function arc(x, y, r, a0, a1, aa) ( gfx_arc(x * ui_s, y * ui_s, r * ui_s, a0, a1, aa); ui_s >= 2 ? gfx_arc(x * ui_s, y * ui_s, r * ui_s - 1, a0, a1, aa); ui_s >= 3 ? gfx_arc(x * ui_s, y * ui_s, r * ui_s - 2, a0, a1, aa); );
function tri(x0, y0, x1, y1, x2, y2) ( gfx_triangle(x0 * ui_s, y0 * ui_s, x1 * ui_s, y1 * ui_s, x2 * ui_s, y2 * ui_s); );
function fsize(pt) ( (pt * ui_s + 0.5) | 0 );
function col(r, g, b) ( gfx_r = r; gfx_g = g; gfx_b = b; gfx_a = 1; );
function col_bg() ( col(0.11, 0.113, 0.128); );
function col_panel() ( col(0.152, 0.157, 0.176); );
function col_panel2() ( col(0.185, 0.19, 0.212); );
function col_line() ( col(0.31, 0.32, 0.36); );
function col_text() ( col(0.93, 0.93, 0.95); );
function col_dim() ( col(0.70, 0.71, 0.75); );
function col_accent() ( col(0.95, 0.63, 0.22); );
function col_accent_dim() ( col(0.62, 0.44, 0.18); );
function col_mod() ( col(0.30, 0.78, 0.72); );
function col_knob() ( col(0.21, 0.215, 0.24); );
function col_knob_hi() ( col(0.30, 0.31, 0.34); );

function font_label() ( gfx_setfont(1, "Helvetica Neue", fsize(11)); );
function font_title() ( gfx_setfont(3, "Helvetica Neue", fsize(12), $'b'); );
function font_logo() ( gfx_setfont(4, "Helvetica Neue", fsize(22), $'b'); );
function font_small() ( gfx_setfont(5, "Helvetica Neue", fsize(10)); );
function font_big() ( gfx_setfont(6, "Helvetica Neue", fsize(14)); );

function text_in(str, x, y, w, h, flags) ( gfx_x = x * ui_s; gfx_y = y * ui_s; gfx_drawstr(str, flags, (x + w) * ui_s, (y + h) * ui_s); );
function text_c(str, x, y, w, h) ( text_in(str, x, y, w, h, 1 | 4); );
function text_l(str, x, y, w, h) ( text_in(str, x, y, w, h, 4); );
function text_r(str, x, y, w, h) ( text_in(str, x, y, w, h, 2 | 4); );

function inside(x, y, w, h) ( ui_mx >= x && ui_mx < x + w && ui_my >= y && ui_my < y + h );

// ---- slider access ---------------------------------------------------------
function sset(i, v) local(st)
(
  v = clamp(v, SMIN[i], SMAX[i]);
  st = SSTEP[i];
  st >= 1 ? v = floor(v / st + 0.5) * st;
  v != slider(i) ? (
    slider(i) = v;
    sliderchange(slider(i));
    slider_automate(slider(i));
    preset_dirty = 1;
  );
);

// value formatting by slider index
function fmt_val(dst, i, v) local(k)
(
  (i == 1 || i == 18 || i == 33 || i == 43 || i == 46 || i == 164 || i == 166 || i == 169 || i == 200 || i == 204 || i == 206) ? sprintf(dst, "%.1f dB", v)
  : (i == 16 || i == 31 || i == 6) ? sprintf(dst, "%+d st", v)
  : (i == 17 || i == 32) ? sprintf(dst, "%+.0f ct", v)
  : (i == 49 || i == 56) ? sprintf(dst, "%.0f Hz", cut_hz(v))
  : (i == 64 || i == 70 || i == 76) ? ( k = knob_time(v, 0.0005, 20); k < 1 ? sprintf(dst, "%.1f ms", k * 1000) : sprintf(dst, "%.2f s", k); )
  : (i == 65 || i == 67 || i == 71 || i == 73 || i == 77 || i == 79) ? ( k = knob_time(v, 0.001, 20); k < 1 ? sprintf(dst, "%.0f ms", k * 1000) : sprintf(dst, "%.2f s", k); )
  : (i == 83 || i == 91 || i == 99) ? sprintf(dst, "%.2f Hz", 0.01 * exp(log(5000) * v))
  : (i == 4) ? ( k = knob_time(v, 0.005, 5); k < 1 ? sprintf(dst, "%.0f ms", k * 1000) : sprintf(dst, "%.2f s", k); )
  : (i == 7 || i == 20 || i == 35) ? sprintf(dst, "%d", v)
  : (i == 165) ? sprintf(dst, "%.0f Hz", 40 * exp(LN2 * v * 4))
  : (i == 167) ? sprintf(dst, "%.0f Hz", 200 * exp(LN2 * v * 5.3))
  : (i == 170) ? sprintf(dst, "%.0f Hz", 1500 * exp(LN2 * v * 3.4))
  : (i == 168) ? sprintf(dst, "Q %.2f", 0.4 * exp(LN2 * v * 4))
  : (i == 172) ? sprintf(dst, "%.2f Hz", 0.05 * exp(LN2 * v * 6.6))
  : (i == 177) ? sprintf(dst, "%.2f Hz", 0.02 * exp(LN2 * v * 8))
  : (i == 190) ? sprintf(dst, "%.0f ms", exp(log(2000) * v))
  : (i == 193) ? sprintf(dst, "%.1f s", 0.3 * exp(log(60) * v))
  : (i == 195) ? sprintf(dst, "%.0f ms", v * 120)
  : (i == 201) ? sprintf(dst, "%.1f : 1", 1 + v * v * 19)
  : (i == 202) ? sprintf(dst, "%.1f ms", knob_time(v, 0.0002, 0.1) * 1000)
  : (i == 203) ? sprintf(dst, "%.0f ms", knob_time(v, 0.02, 2) * 1000)
  : (SMIN[i] < 0 && SMAX[i] > 0) ? sprintf(dst, "%+.0f %%", v * 100)
  : (SMAX[i] == 1 && SMIN[i] == 0 && SSTEP[i] < 1) ? sprintf(dst, "%.0f %%", v * 100)
  : sprintf(dst, "%g", v);
);

// ---- widgets ---------------------------------------------------------------
function knob(x, y, r, i, label) local(v, lo, hi, t, a0, a1, hit, dv, bip, px, py, ang)
(
  lo = SMIN[i]; hi = SMAX[i]; v = slider(i);
  bip = lo < 0 && hi > 0;
  hit = inside(x - r - 6, y - r - 6, 2 * r + 12, 2 * r + 24);
  hit && g_mdown && !g_menu_open ? (
    (g_now - g_click_t < 0.35 && g_click_id == i) ? ( sset(i, DEFAULTS[i]); g_drag = -1; g_click_t = 0; )
    : ( g_drag = i; g_dragy = ui_my; g_dragv = v; g_click_t = g_now; g_click_id = i; );
  );
  g_drag == i ? (
    dv = (g_dragy - ui_my) / ((mouse_cap & 8) ? 2500 : 220) * (hi - lo);
    sset(i, g_dragv + dv);
  );
  hit && g_wheel != 0 ? ( sset(i, v + g_wheel / 120 * (hi - lo) * ((mouse_cap & 8) ? 0.002 : 0.02)); g_wheel = 0; );
  v = slider(i);
  (hit || g_drag == i) ? ( strcpy(#hint, label); fmt_val(#hintv, i, v); g_hint_on = 1; );
  t = (hi > lo) ? (v - lo) / (hi - lo) : 0;
  // track
  col_knob_hi(); arc(x, y, r, -2.4, 2.4, 1); arc(x, y, r - 1, -2.4, 2.4, 1);
  // value arc
  (hit || g_drag == i) ? col_accent() : col_accent_dim();
  bip ? ( a0 = 0; a1 = (t - 0.5) * 4.8; a1 < a0 ? arc(x, y, r, a1, a0, 1) : arc(x, y, r, a0, a1, 1); a1 < a0 ? arc(x, y, r - 1, a1, a0, 1) : arc(x, y, r - 1, a0, a1, 1); )
      : ( arc(x, y, r, -2.4, -2.4 + t * 4.8, 1); arc(x, y, r - 1, -2.4, -2.4 + t * 4.8, 1); );
  // body
  col_knob(); circle(x, y, r - 4, 1, 1);
  col_line(); circle(x, y, r - 4, 0, 1);
  // pointer
  ang = -2.4 + t * 4.8;
  px = x + sin(ang) * (r - 6); py = y - cos(ang) * (r - 6);
  col_text(); line(x + sin(ang) * 3, y - cos(ang) * 3, px, py, 1);
  // label / value
  font_label();
  (hit || g_drag == i) ? ( col_accent(); text_c(#hintv, x - 40, y + r + 1, 80, 12); ) : ( col_dim(); text_c(label, x - 40, y + r + 1, 80, 12); );
);

function toggle(x, y, w, h, i, label) local(on, hit)
(
  on = slider(i) != 0;
  hit = inside(x, y, w, h);
  hit && g_mdown && !g_menu_open ? sset(i, on ? 0 : 1);
  on = slider(i) != 0;
  hit ? ( strcpy(#hint, label); strcpy(#hintv, on ? "On" : "Off"); g_hint_on = 1; );
  on ? col_accent_dim() : col_knob(); rect(x, y, w, h, 1);
  (hit ? col_accent() : col_line()); rect(x, y, w, h, 0);
  font_label(); on ? col_text() : col_dim();
  text_c(label, x, y, w, h);
);

// option label #k of a '|'-separated list into dst
function opt_label(dst, opts, k) local(i, n, c, cnt, start)
(
  n = strlen(opts); i = 0; cnt = 0; start = 0;
  while (i <= n) (
    c = i < n ? str_getchar(opts, i) : $'|';
    c == $'|' ? (
      cnt == k ? ( strcpy_substr(dst, opts, start, i - start); i = n + 1; ) : ( cnt += 1; start = i + 1; );
    );
    i += 1;
  );
);
function count_opts(opts) local(i, n, cnt) ( n = strlen(opts); i = 0; cnt = 1; loop(n, str_getchar(opts, i) == $'|' ? cnt += 1; i += 1;); cnt );

function menubtn(x, y, w, h, i, opts, label) local(cur, hit, r, k, n)
(
  cur = slider(i) - SMIN[i];
  hit = inside(x, y, w, h);
  opt_label(#tmp, opts, cur | 0);
  hit ? ( strcpy(#hint, label); strcpy(#hintv, #tmp); g_hint_on = 1; );
  col_knob(); rect(x, y, w, h, 1);
  (hit ? col_accent() : col_line()); rect(x, y, w, h, 0);
  font_label(); col_text(); text_l(#tmp, x + 6, y, w - 18, h);
  col_dim(); tri(x + w - 12, y + h * 0.5 - 2, x + w - 5, y + h * 0.5 - 2, x + w - 8.5, y + h * 0.5 + 2);
  hit && g_mdown && !g_menu_open ? (
    // build the menu with the current item checked
    n = count_opts(opts);
    strcpy(#menu, "");
    k = 0;
    loop(n,
      opt_label(#tmp, opts, k);
      k == (cur | 0) ? strcat(#menu, "!");
      strcat(#menu, #tmp);
      k < n - 1 ? strcat(#menu, "|");
      k += 1;
    );
    gfx_x = x * ui_s; gfx_y = (y + h) * ui_s;
    r = gfx_showmenu(#menu);
    r > 0 ? sset(i, SMIN[i] + r - 1);
    g_menu_open = 1;
  );
);

function tabbar(x, y, w, h, n, labels, cur) local(k, tw, hit)
(
  tw = w / n;
  k = 0;
  loop(n,
    opt_label(#tmp, labels, k);
    hit = inside(x + k * tw, y, tw, h);
    hit && g_mdown && !g_menu_open ? cur = k;
    k == cur ? col_panel2() : col_panel(); rect(x + k * tw, y, tw, h, 1);
    k == cur ? ( col_accent(); rect(x + k * tw, y + h - 2, tw, 2, 1); );
    font_title(); k == cur ? col_text() : col_dim(); text_c(#tmp, x + k * tw, y, tw, h);
    k += 1;
  );
  cur
);

// bipolar horizontal slider for matrix amounts
function hslider(x, y, w, h, i) local(v, t, hit, cx, dv)
(
  v = slider(i);
  hit = inside(x, y - 2, w, h + 4);
  hit && g_mdown && !g_menu_open ? (
    (g_now - g_click_t < 0.35 && g_click_id == i) ? ( sset(i, 0); g_drag = -1; g_click_t = 0; )
    : ( g_drag = i; g_dragy = ui_mx; g_dragv = v; g_click_t = g_now; g_click_id = i; );
  );
  g_drag == i ? ( dv = (ui_mx - g_dragy) / ((mouse_cap & 8) ? (w * 10) : w) * 2; sset(i, g_dragv + dv); );
  hit && g_wheel != 0 ? ( sset(i, v + g_wheel / 120 * 0.02); g_wheel = 0; );
  v = slider(i);
  (hit || g_drag == i) ? ( strcpy(#hint, "Mod amount"); sprintf(#hintv, "%+.1f %%", v * 100); g_hint_on = 1; );
  col_knob(); rect(x, y, w, h, 1);
  cx = x + w * 0.5; t = cx + v * w * 0.5;
  (hit || g_drag == i) ? col_mod() : col(0.22, 0.55, 0.52);
  v >= 0 ? rect(cx, y + 1, t - cx, h - 2, 1) : rect(t, y + 1, cx - t, h - 2, 1);
  col_line(); rect(x, y, w, h, 0); line(cx, y, cx, y + h - 1, 0);
  v != 0 ? ( font_small(); col_text(); sprintf(#tmp, "%+.0f", v * 100); text_c(#tmp, x, y, w, h); );
);

function panel(x, y, w, h, title)
(
  col_panel(); rect(x, y, w, h, 1);
  col_line(); rect(x, y, w, h, 0);
  font_title(); col_text(); text_l(title, x + 10, y + 2, w - 20, 20);
);
function divider(x, y, w) ( col_line(); line(x, y, x + w, y, 0); );

// ---- displays --------------------------------------------------------------
function warp_phase(mode, p, amt) local(b, q)
(
  mode == 0 ? p
  : mode == 1 ? ( b = 0.5 - 0.47 * amt; p < b ? p * 0.5 / b : 0.5 + (p - b) * 0.5 / (1 - b) )
  : mode == 2 ? frac(p * (1 + amt * 7))
  : mode == 3 ? (p < 0.5 ? p * 2 : 2 - p * 2) * amt + p * (1 - amt)
  : mode == 4 ? ( q = 2 + (1 - amt) * 62; floor(p * q) / q )
  : frac(p * (1 + amt * 7));
);

function draw_wave(x, y, w, h, bank, pos, mode, amt) local(i, n, p, pp, t0, t1, f, fr, s, idx, i0, fx, px, py, lx, ly, win)
(
  col(0.09, 0.092, 0.105); rect(x, y, w, h, 1);
  col_line(); rect(x, y, w, h, 0); line(x, y + h * 0.5, x + w, y + h * 0.5, 0);
  pos = clamp(pos, 0, 1) * (NFRAME - 1); f = pos | 0; fr = pos - f; f >= NFRAME - 1 ? ( f = NFRAME - 1; fr = 0; );
  t0 = frame_addr(bank, f, 0); t1 = frame_addr(bank, min(f + 1, NFRAME - 1), 0);
  n = ((w - 4) * ui_s) | 0;
  col_accent();
  i = 0;
  loop(n + 1,
    p = i / n;
    pp = warp_phase(mode, p, amt);
    idx = pp * TBL_N; i0 = idx | 0; fx = idx - i0; i0 > TBL_N - 1 ? i0 = TBL_N - 1;
    s = t0[i0] + fx * (t0[i0 + 1] - t0[i0]);
    fr > 0 ? s += fr * (t1[i0] + fx * (t1[i0 + 1] - t1[i0]) - s);
    mode == 5 ? ( win = sin($pi * p); s *= win * win; );
    px = x + 2 + i / ui_s; py = y + h * 0.5 - s * h * 0.42;
    i > 0 ? line(lx, ly, px, py, 1);
    lx = px; ly = py;
    i += 1;
  );
);

function draw_env(x, y, w, h, a, d, s, r, c) local(ta, td, tr, tot, x0, x1, x2, x3, x4, i, n, px, py, lx, ly, t, v)
(
  col(0.09, 0.092, 0.105); rect(x, y, w, h, 1);
  col_line(); rect(x, y, w, h, 0);
  // widths proportional to the knob positions (log times), sustain gets a fixed share
  ta = 0.05 + a * 0.6; td = 0.05 + d * 0.6; tr = 0.05 + r * 0.6;
  tot = ta + td + 0.5 + tr;
  x0 = x + 3; x1 = x0 + (w - 6) * ta / tot; x2 = x1 + (w - 6) * td / tot; x3 = x2 + (w - 6) * 0.5 / tot; x4 = x + w - 3;
  col_accent();
  n = 24; lx = x0; ly = y + h - 3;
  i = 1; loop(n, t = i / n; v = env_shape_att(t, c); px = x0 + (x1 - x0) * t; py = y + h - 3 - v * (h - 6); line(lx, ly, px, py, 1); lx = px; ly = py; i += 1;);
  i = 1; loop(n, t = i / n; v = s + (1 - s) * env_shape_fall(t, c); px = x1 + (x2 - x1) * t; py = y + h - 3 - v * (h - 6); line(lx, ly, px, py, 1); lx = px; ly = py; i += 1;);
  px = x3; py = y + h - 3 - s * (h - 6); line(lx, ly, px, py, 1); lx = px; ly = py;
  i = 1; loop(n, t = i / n; v = s * env_shape_fall(t, c); px = x3 + (x4 - x3) * t; py = y + h - 3 - v * (h - 6); line(lx, ly, px, py, 1); lx = px; ly = py; i += 1;);
  col_dim(); line(x3, y + 3, x3, y + h - 3, 0);
);

function draw_lfo(x, y, w, h, shape, phase, uni) local(i, n, p, v, px, py, lx, ly)
(
  col(0.09, 0.092, 0.105); rect(x, y, w, h, 1);
  col_line(); rect(x, y, w, h, 0); line(x, y + h * 0.5, x + w, y + h * 0.5, 0);
  n = ((w - 4) * ui_s) | 0;
  LFOGFX[2] = 0.6; LFOGFX[3] = -0.4;
  col_accent();
  i = 0;
  loop(n + 1,
    p = frac(i / n * 2 + phase);
    shape == 5 ? v = (p < 0.5 ? 0.6 : -0.5) : shape == 6 ? v = 0.6 * sin(TWOPI * p) * 0.5 + 0.3 * sin(TWOPI * p * 3) : v = lfo_shape(shape, p, LFOGFX);
    uni ? v = 0.5 * (v + 1);
    px = x + 2 + i / ui_s; py = y + h * 0.5 - v * h * 0.42;
    i > 0 ? line(lx, ly, px, py, 1);
    lx = px; ly = py;
    i += 1;
  );
);

// ---- preset browser --------------------------------------------------------
function preset_step(d) local(n)
(
  NPRESET > 0 ? ( n = preset_idx + d; n < 0 ? n = NPRESET - 1; n >= NPRESET ? n = 0; preset_pending = n; );
);

function preset_browser(x, y, w, h) local(hit, k, r, n, cat, cnt, i, cur, cnt2)
(
  col_knob(); rect(x, y, w, h, 1); col_line(); rect(x, y, w, h, 0);
  // prev / next
  hit = inside(x, y, 22, h); hit && g_mdown && !g_menu_open ? preset_step(-1);
  col_dim(); hit ? col_accent(); tri(x + 15, y + 6, x + 15, y + h - 6, x + 6, y + h * 0.5);
  hit = inside(x + w - 22, y, 22, h); hit && g_mdown && !g_menu_open ? preset_step(1);
  col_dim(); hit ? col_accent(); tri(x + w - 15, y + 6, x + w - 15, y + h - 6, x + w - 6, y + h * 0.5);
  line(x + 22, y, x + 22, y + h, 0); line(x + w - 22, y, x + w - 22, y + h, 0);
  // category button
  hit = inside(x + 22, y, 110, h);
  font_label(); col_dim(); hit ? col_accent();
  preset_idx >= 0 && preset_idx < NPRESET ? strcpy(#tmp, PSTR_CAT + preset_idx) : strcpy(#tmp, "-");
  text_c(#tmp, x + 22, y, 110, h);
  line(x + 132, y + 4, x + 132, y + h - 4, 0);
  hit && g_mdown && !g_menu_open ? (
    // menu of distinct categories; MENUMAP[k] = first preset of that category
    strcpy(#menu, ""); cnt = 0;
    i = 0;
    loop(NPRESET,
      // new category if no earlier preset has the same name
      k = 0; n = 0;
      loop(i, strcmp(PSTR_CAT + k, PSTR_CAT + i) == 0 ? n = 1; k += 1;);
      n == 0 ? (
        cnt > 0 ? strcat(#menu, "|");
        strcmp(PSTR_CAT + i, #tmp) == 0 ? strcat(#menu, "!");
        strcat(#menu, PSTR_CAT + i);
        MENUMAP[cnt] = i; cnt += 1;
      );
      i += 1;
    );
    gfx_x = (x + 22) * ui_s; gfx_y = (y + h) * ui_s;
    r = gfx_showmenu(#menu);
    r > 0 ? preset_pending = MENUMAP[r - 1];
    g_menu_open = 1;
  );
  // name button: presets of the current category
  hit = inside(x + 132, y, w - 154, h);
  font_big(); col_text(); hit ? col_accent();
  preset_idx >= 0 && preset_idx < NPRESET ? strcpy(#tmp2, PSTR_NAME + preset_idx) : strcpy(#tmp2, "-");
  preset_dirty ? strcat(#tmp2, " *");
  text_c(#tmp2, x + 132, y, w - 154, h);
  hit && g_mdown && !g_menu_open ? (
    strcpy(#menu, ""); cnt = 0;
    i = 0;
    loop(NPRESET,
      strcmp(PSTR_CAT + i, #tmp) == 0 ? (
        cnt > 0 ? strcat(#menu, "|");
        i == preset_idx ? strcat(#menu, "!");
        strcat(#menu, PSTR_NAME + i);
        MENUMAP[cnt] = i; cnt += 1;
      );
      i += 1;
    );
    gfx_x = (x + 132) * ui_s; gfx_y = (y + h) * ui_s;
    r = gfx_showmenu(#menu);
    r > 0 ? preset_pending = MENUMAP[r - 1];
    g_menu_open = 1;
  );
);

// ============================================================================
//  Frame
// ============================================================================
g_now = time_precise();
g_mdown = (mouse_cap & 1) && !(g_last_cap & 1);
g_last_cap = mouse_cap;
(mouse_cap & 1) == 0 ? g_drag = -1;
g_wheel = mouse_wheel; mouse_wheel = 0;
g_menu_open = 0;
g_hint_on = 0;
gfx_clear = -1;
col_bg(); gfx_rect(0, 0, gfx_w, gfx_h, 1);

// ---------------------------------------------------------------- header
font_logo(); col_accent(); text_l("SATYA", 14, 6, 120, 30);
font_small(); col_dim(); text_l("wavetable synthesizer", 96, 12, 200, 20);
preset_browser(330, 7, 460, 28);
// readouts
font_label(); col_dim();
nact_ui = 0; ui_vi = 0; loop(NVOICE, nact_ui += voice_addr(ui_vi)[V_STATE] != 0; ui_vi += 1;);
sprintf(#tmp, "voices %d", nact_ui); text_r(#tmp, 820, 7, 120, 14);
sprintf(#tmp, "cpu %.1f %%", srate > 0 ? cpu_us / (max(samplesblock, 1) / srate * 1000000) * 100 : 0); text_r(#tmp, 820, 21, 120, 14);
knob(985, 20, 14, 1, "Master");
knob(1040, 20, 14, 10, "Width");
knob(1092, 20, 14, 7, "Voices");

// ---------------------------------------------------------------- row 1: oscillators
osc_x = 10; osc_y = 46; osc_w = 362; osc_h = 202;
k = 0;
while (k < 2) (
  ox = osc_x + k * 370; ob = 11 + k * 15;
  panel(ox, osc_y, osc_w, osc_h, k == 0 ? "OSC A" : "OSC B");
  toggle(ox + 62, osc_y + 5, 30, 15, ob, "On");
  menubtn(ox + 100, osc_y + 4, 104, 17, ob + 1, "Basic|Warm|Pulse|FM One|FM Two|FM Even|Sync|Vowel|Organ|Bell|Digital|Fold|Grit|Air|OddEven|Decay", "Wavetable");
  menubtn(ox + 212, osc_y + 4, 94, 17, ob + 3, "Warp: Off|Bend|Sync|Mirror|Quantize|Formant", "Warp mode");
  toggle(ox + 314, osc_y + 5, 40, 15, ob + 14, "Key");
  draw_wave(ox + 10, osc_y + 28, 100, 76, slider(ob + 1) | 0, slider(ob + 2), slider(ob + 3) | 0, slider(ob + 4));
  knob(ox + 140, osc_y + 50, 16, ob + 2, "Position");
  knob(ox + 190, osc_y + 50, 16, ob + 4, "Warp");
  knob(ox + 240, osc_y + 50, 16, ob + 5, "Semi");
  knob(ox + 290, osc_y + 50, 16, ob + 6, "Fine");
  knob(ox + 340, osc_y + 50, 16, ob + 7, "Level");
  knob(ox + 140, osc_y + 122, 16, ob + 9, "Unison");
  knob(ox + 190, osc_y + 122, 16, ob + 10, "Detune");
  knob(ox + 240, osc_y + 122, 16, ob + 11, "Spread");
  knob(ox + 290, osc_y + 122, 16, ob + 12, "Blend");
  knob(ox + 340, osc_y + 122, 16, ob + 8, "Pan");
  toggle(ox + 10, osc_y + 112, 100, 16, ob + 13, slider(ob + 13) ? "Phase: reset" : "Phase: free");
  k == 1 ? (
    knob(ox + 40, osc_y + 168, 14, 41, "PM from A");
    knob(ox + 100, osc_y + 168, 14, 42, "Ring A x B");
  ) : (
    font_small(); col_dim(); text_l("A is the modulator for B's phase mod and ring mod", ox + 10, osc_y + 158, 300, 30);
  );
  k += 1;
);
// sub / noise / voice
px = 750; panel(px, osc_y, 360, osc_h, "SUB · NOISE");
knob(px + 40, osc_y + 50, 16, 43, "Sub Level");
menubtn(px + 70, osc_y + 40, 80, 17, 44, "Sine|Triangle|Square", "Sub shape");
menubtn(px + 70, osc_y + 62, 80, 17, 45, "-1 oct|-2 oct", "Sub octave");
knob(px + 200, osc_y + 50, 16, 46, "Noise Level");
knob(px + 260, osc_y + 50, 16, 47, "Noise Color");
divider(px + 10, osc_y + 96, 340);
font_title(); col_text(); text_l("VOICE", px + 10, osc_y + 98, 100, 16);
menubtn(px + 60, osc_y + 98, 80, 17, 3, "Poly|Mono|Legato", "Voice mode");
menubtn(px + 148, osc_y + 98, 96, 17, 5, "Glide always|Glide legato", "Glide mode");
knob(px + 40, osc_y + 150, 16, 4, "Glide");
knob(px + 100, osc_y + 150, 16, 6, "Bend Range");
knob(px + 160, osc_y + 150, 16, 8, "Vel Curve");
knob(px + 220, osc_y + 150, 16, 9, "Drift");
knob(px + 280, osc_y + 150, 16, 2, "Pan Spread");

// ---------------------------------------------------------------- row 2: filters, envelopes
fy = 256; fh = 160;
k = 0;
while (k < 2) (
  fx_ = 10 + k * 370; fb = 48 + k * 7;
  panel(fx_, fy, 362, fh, k == 0 ? "FILTER 1" : "FILTER 2");
  menubtn(fx_ + 84, fy + 4, 96, 17, fb, "Off|LP 12|LP 24|HP 12|HP 24|BP 12|BP 24|Notch|Ladder", "Filter type");
  knob(fx_ + 44, fy + 76, 24, fb + 1, "Cutoff");
  knob(fx_ + 102, fy + 76, 16, fb + 2, "Resonance");
  knob(fx_ + 152, fy + 76, 16, fb + 3, "Drive");
  knob(fx_ + 202, fy + 76, 16, fb + 4, "Key Track");
  knob(fx_ + 252, fy + 76, 16, fb + 5, "Env 2");
  knob(fx_ + 302, fy + 76, 16, fb + 6, "Env 3");
  k == 1 ? (
    menubtn(fx_ + 190, fy + 4, 104, 17, 62, "Series|Parallel|Split A/B", "Filter routing");
    // the mix knob only means something in Parallel (Series takes F2's output, Split sums both)
    slider(62) == 1 ? ( font_small(); col_dim(); text_l("mix", fx_ + 300, fy + 4, 28, 17); knob(fx_ + 340, fy + 12, 9, 63, ""); );
  ) : (
    font_small(); col_dim(); text_l("drive saturates before the filter", fx_ + 190, fy + 4, 170, 17);
  );
  k += 1;
);
px = 750; panel(px, fy, 360, fh, "ENVELOPES");
ui_envtab = tabbar(px + 100, fy + 3, 90, 18, 3, "1|2|3", ui_envtab);
font_small(); col_dim(); text_l(ui_envtab == 0 ? "amp" : ui_envtab == 1 ? "filter" : "free", px + 196, fy + 3, 60, 18);
eb = 64 + ui_envtab * 6;
draw_env(px + 10, fy + 28, 130, 70, slider(eb), slider(eb + 1), slider(eb + 2), slider(eb + 3), slider(eb + 4));
knob(px + 170, fy + 52, 15, eb, "Attack");
knob(px + 214, fy + 52, 15, eb + 1, "Decay");
knob(px + 258, fy + 52, 15, eb + 2, "Sustain");
knob(px + 302, fy + 52, 15, eb + 3, "Release");
knob(px + 214, fy + 116, 15, eb + 4, "Curve");
knob(px + 258, fy + 116, 15, eb + 5, "Velocity");
font_small(); col_dim(); text_l("Env 1 = amp · Env 2, 3 = filters", px + 10, fy + 102, 150, 14); text_l("(amounts on the filter panels)", px + 10, fy + 116, 150, 14);

// ---------------------------------------------------------------- row 3: LFOs, matrix, macros
ly_ = 424; lh = 192;
panel(10, ly_, 362, lh, "LFO");
ui_lfotab = tabbar(50, ly_ + 3, 90, 18, 3, "1|2|3", ui_lfotab);
lb = 82 + ui_lfotab * 8;
draw_lfo(10 + 10, ly_ + 28, 130, 60, slider(lb) | 0, slider(lb + 4), slider(lb + 7));
menubtn(160, ly_ + 28, 110, 17, lb, "Sine|Triangle|Saw Up|Saw Down|Square|Sample & Hold|Smooth Random|Pulse", "LFO shape");
toggle(278, ly_ + 28, 40, 17, lb + 2, "Sync");
menubtn(160, ly_ + 50, 110, 17, lb + 3, "4/1|2/1|1/1|1/2|1/2.|1/4|1/4.|1/4T|1/8|1/8.|1/8T|1/16|1/32", "Sync division");
toggle(278, ly_ + 50, 40, 17, lb + 6, slider(lb + 6) ? "Mono" : "Poly");
toggle(324, ly_ + 28, 40, 17, lb + 7, slider(lb + 7) ? "Uni" : "Bi");
knob(50, ly_ + 122, 16, lb + 1, "Rate");
knob(110, ly_ + 122, 16, lb + 4, "Phase");
knob(170, ly_ + 122, 16, lb + 5, "Fade In");
font_small(); col_dim(); text_l("synced: rate ignored", 210, ly_ + 108, 150, 14); text_l("mono: locked to the transport", 210, ly_ + 122, 150, 14);

panel(380, ly_, 362, lh, "MODULATION MATRIX");
font_small(); col_dim();
text_l("SOURCE", 400, ly_ + 20, 60, 12); text_l("DESTINATION", 480, ly_ + 20, 100, 12); text_l("AMOUNT", 588, ly_ + 20, 60, 12); text_l("VIA", 664, ly_ + 20, 40, 12);
k = 0;
while (k < NMOD) (
  mb = 110 + k * 4; my = ly_ + 34 + k * 13;
  font_small(); (slider(mb) > 0 && slider(mb + 1) > 0) ? col_text() : col_dim();
  sprintf(#tmp, "%d", k + 1); text_r(#tmp, 384, my, 12, 12);
  menubtn(398, my, 76, 12, mb, "-|Env 1|Env 2|Env 3|LFO 1|LFO 2|LFO 3|Velocity|Key Track|Mod Wheel|Aftertouch|Pitch Bend|Macro 1|Macro 2|Macro 3|Macro 4|Random|Constant", "Source");
  menubtn(478, my, 104, 12, mb + 1, "-|Pitch|Osc A Pitch|Osc B Pitch|Osc A Position|Osc B Position|Osc A Warp|Osc B Warp|Osc A Level|Osc B Level|Osc A Pan|Osc B Pan|Osc A Detune|Osc B Detune|PM Amount|Ring Mod|Sub Level|Noise Level|Filter 1 Cutoff|Filter 1 Reso|Filter 1 Drive|Filter 2 Cutoff|Filter 2 Reso|Filter 2 Drive|Amp|Pan|LFO 1 Rate|LFO 2 Rate|LFO 3 Rate|Drive Amount|Chorus Mix|Delay Mix|Delay Feedback|Reverb Mix|Phaser Mix|Osc A Fine|Osc B Fine|Glide|Env 1 Attack|Env 1 Decay|Env 1 Release", "Destination");
  hslider(586, my, 72, 12, mb + 2);
  menubtn(662, my, 74, 12, mb + 3, "-|Env 1|Env 2|Env 3|LFO 1|LFO 2|LFO 3|Velocity|Key Track|Mod Wheel|Aftertouch|Pitch Bend|Macro 1|Macro 2|Macro 3|Macro 4|Random|Constant", "Via (multiplies the source)");
  k += 1;
);

px = 750; panel(px, ly_, 360, lh, "MACROS");
knob(px + 50, ly_ + 60, 22, 106, "Macro 1");
knob(px + 136, ly_ + 60, 22, 107, "Macro 2");
knob(px + 222, ly_ + 60, 22, 108, "Macro 3");
knob(px + 308, ly_ + 60, 22, 109, "Macro 4");
font_small(); col_dim(); text_l("Macros reach any destination through the matrix.", px + 10, ly_ + 108, 340, 14);
text_l("Mod wheel = CC 1 · aftertouch = channel pressure", px + 10, ly_ + 122, 340, 14);
sprintf(#tmp, "wheel %.0f %%   pressure %.0f %%   bend %+.2f", wheel * 100, aftertouch * 100, bend); font_label(); col_dim(); text_l(#tmp, px + 10, ly_ + 160, 340, 16);

// ---------------------------------------------------------------- row 4: effects strip
ey = 624; eh = 80;
panel(10, ey, 1100, eh, "");
k = 0;
while (k < 8) (
  bx = 18 + k * 80; onidx = k == 0 ? 158 : k == 1 ? 163 : k == 2 ? 171 : k == 3 ? 176 : k == 4 ? 182 : k == 5 ? 191 : k == 6 ? 199 : 205;
  opt_label(#tmp, "DRIVE|EQ|CHORUS|PHASER|DELAY|REVERB|COMP|LIMIT", k);
  hit = inside(bx, ey + 8, 74, 64);
  hit && g_mdown && !g_menu_open && !inside(bx + 4, ey + 12, 14, 14) ? ui_fxtab = k;
  k == ui_fxtab ? col_panel2() : col_panel(); rect(bx, ey + 8, 74, 64, 1);
  k == ui_fxtab ? col_accent() : col_line(); rect(bx, ey + 8, 74, 64, 0);
  toggle(bx + 4, ey + 12, 14, 14, onidx, "");
  font_title(); k == ui_fxtab ? col_text() : col_dim(); text_c(#tmp, bx + 18, ey + 10, 52, 18);
  k += 1;
);
fx0 = 660;
ui_fxtab == 0 ? (
  menubtn(fx0, ey + 10, 80, 17, 159, "Soft|Hard|Fold|Tube", "Drive type");
  knob(fx0 + 130, ey + 40, 16, 160, "Amount"); knob(fx0 + 190, ey + 40, 16, 161, "Tone"); knob(fx0 + 250, ey + 40, 16, 162, "Mix");
) : ui_fxtab == 1 ? (
  knob(fx0 + 20, ey + 40, 16, 164, "Low Gain"); knob(fx0 + 76, ey + 40, 16, 165, "Low Freq");
  knob(fx0 + 150, ey + 40, 16, 166, "Mid Gain"); knob(fx0 + 206, ey + 40, 16, 167, "Mid Freq"); knob(fx0 + 262, ey + 40, 16, 168, "Mid Q");
  knob(fx0 + 336, ey + 40, 16, 169, "High Gain"); knob(fx0 + 392, ey + 40, 16, 170, "High Freq");
) : ui_fxtab == 2 ? (
  menubtn(fx0, ey + 10, 90, 17, 175, "Chorus|Ensemble", "Chorus mode");
  knob(fx0 + 130, ey + 40, 16, 172, "Rate"); knob(fx0 + 190, ey + 40, 16, 173, "Depth"); knob(fx0 + 250, ey + 40, 16, 174, "Mix");
) : ui_fxtab == 3 ? (
  knob(fx0 + 20, ey + 40, 16, 177, "Rate"); knob(fx0 + 80, ey + 40, 16, 178, "Depth"); knob(fx0 + 140, ey + 40, 16, 179, "Feedback");
  knob(fx0 + 200, ey + 40, 16, 180, "Center"); knob(fx0 + 260, ey + 40, 16, 181, "Blend");
  font_small(); col_dim(); text_l("blend 50 % = deepest notches", fx0 + 300, ey + 32, 200, 16);
) : ui_fxtab == 4 ? (
  toggle(fx0, ey + 10, 44, 17, 183, "Sync");
  menubtn(fx0 + 50, ey + 10, 70, 17, 184, "4/1|2/1|1/1|1/2|1/2.|1/4|1/4.|1/4T|1/8|1/8.|1/8T|1/16|1/32", "Delay division");
  toggle(fx0 + 128, ey + 10, 70, 17, 186, "Ping-pong");
  knob(fx0 + 20, ey + 46, 14, 190, "Time"); knob(fx0 + 80, ey + 46, 14, 185, "Feedback"); knob(fx0 + 140, ey + 46, 14, 187, "Tone");
  knob(fx0 + 200, ey + 46, 14, 188, "Low Cut"); knob(fx0 + 260, ey + 46, 14, 189, "Mix");
) : ui_fxtab == 5 ? (
  knob(fx0 + 20, ey + 40, 16, 192, "Size"); knob(fx0 + 80, ey + 40, 16, 193, "Decay"); knob(fx0 + 140, ey + 40, 16, 194, "Damping");
  knob(fx0 + 200, ey + 40, 16, 195, "Pre-delay"); knob(fx0 + 260, ey + 40, 16, 196, "Low Cut"); knob(fx0 + 320, ey + 40, 16, 198, "Mod");
  knob(fx0 + 380, ey + 40, 16, 197, "Mix");
) : ui_fxtab == 6 ? (
  knob(fx0 + 20, ey + 40, 16, 200, "Threshold"); knob(fx0 + 80, ey + 40, 16, 201, "Ratio"); knob(fx0 + 140, ey + 40, 16, 202, "Attack");
  knob(fx0 + 200, ey + 40, 16, 203, "Release"); knob(fx0 + 260, ey + 40, 16, 204, "Makeup");
  sprintf(#tmp, "GR %.1f dB", cmp_gr); font_label(); col_dim(); text_l(#tmp, fx0 + 320, ey + 32, 100, 16);
) : (
  knob(fx0 + 20, ey + 40, 16, 206, "Ceiling");
  sprintf(#tmp, "gain %.1f dB", 20 * log10(max(lim_gr, 0.0001))); font_label(); col_dim(); text_l(#tmp, fx0 + 70, ey + 32, 120, 16);
  font_small(); text_l("Peak-hold limiter, no lookahead: an output safety, always the last stage.", fx0 + 70, ey + 48, 400, 16);
);

// ---------------------------------------------------------------- status line
font_label();
g_hint_on ? ( col_text(); text_l(#hint, 14, 706, 300, 14); col_accent(); text_l(#hintv, 200, 706, 200, 14); )
          : ( col_dim(); text_l("Drag knobs vertically · Shift for fine · Double-click resets · Wheel nudges", 14, 706, 600, 14); );
sprintf(#tmp, "%s · %d presets", "Satya 1.0", NPRESET); col_dim(); text_r(#tmp, 900, 706, 206, 14);

@serialize
ser_ver = 1;
file_var(0, ser_ver);
file_var(0, preset_idx);
file_var(0, preset_dirty);
file_var(0, ui_fxtab);
file_var(0, ui_envtab);
file_var(0, ui_lfotab);

