slider134:m7_src=0<0,17,1>-Mod 7 Source
slider135:m7_dst=0<0,40,1>-Mod 7 Destination
slider136:m7_amt=0<-1,1,0.001>-Mod 7 Amount
slider137:m7_via=0<0,17,1>-Mod 7 Via
slider138:m8_src=0<0,17,1>-Mod 8 Source
slider139:m8_dst=0<0,40,1>-Mod 8 Destination
slider140:m8_amt=0<-1,1,0.001>-Mod 8 Amount
slider141:m8_via=0<0,17,1>-Mod 8 Via
slider142:m9_src=0<0,17,1>-Mod 9 Source
slider143:m9_dst=0<0,40,1>-Mod 9 Destination
slider144:m9_amt=0<-1,1,0.001>-Mod 9 Amount
slider145:m9_via=0<0,17,1>-Mod 9 Via
slider146:m10_src=0<0,17,1>-Mod 10 Source
slider147:m10_dst=0<0,40,1>-Mod 10 Destination
