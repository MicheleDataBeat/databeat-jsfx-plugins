slider199:fx_cmp_on=0<0,1,1>-Compressor On
slider200:fx_cmp_thr=-18<-48,0,0.1>-Compressor Threshold
slider201:fx_cmp_ratio=0.4<0,1,0.001>-Compressor Ratio
slider202:fx_cmp_att=0.3<0,1,0.001>-Compressor Attack
slider203:fx_cmp_rel=0.4<0,1,0.001>-Compressor Release
slider204:fx_cmp_gain=0<0,24,0.1>-Compressor Makeup
slider205:fx_lim_on=1<0,1,1>-Limiter On
slider206:fx_lim_ceil=-0.3<-12,0,0.1>-Limiter Ceiling

@init
ext_noinit = 1;
ext_nodenorm = 1;

// ============================================================================
//  Constants and memory map
// ============================================================================
TBL_N = 2048;            // wavetable frame length
TBL_S = TBL_N + 1;       // plus guard sample
NBANK = 16;
NFRAME = 8;
NLEVEL = 20;             // half-octave mip levels
NVOICE = 16;
NGHOST = 8;
NSLOT = NVOICE + NGHOST;
VSTRIDE = 128;
CTRL = 32;               // control chunk in samples
MAXBLOCK = 32768;
NMOD = 12;
NDST = 41;
NSRC = 18;

mp = 0;
function alloc(n) global(mp) local(r) ( r = mp; mp += n; r );

WT      = alloc(NBANK * NFRAME * NLEVEL * TBL_S);   // 5,245,440
SPEC    = alloc(TBL_N + 4);
WORK    = alloc(TBL_N + 4);
TD      = alloc(TBL_N + 4);
LVLH    = alloc(NLEVEL);                             // harmonics kept per level
VOICE   = alloc(NSLOT * VSTRIDE);
BUFL    = alloc(MAXBLOCK);
BUFR    = alloc(MAXBLOCK);
EVQ     = alloc(4096 * 4);
DST     = alloc(NDST);                               // per-voice destination accumulator
SRCV    = alloc(NSRC);                               // per-voice source values
MONOST  = alloc(64);                                 // mono note stack
PS      = alloc(256);                                // smoothed slider values
PSF     = alloc(256);                                // smoothing flags
UNIG    = alloc(64);                                 // unison gains scratch (L,R,inc per 8 voices x 2 oscs)
LFOMONO = alloc(16);   // [0..2] outputs; [4..7],[8..11],[12..15] the three mono LFO records
FXMEM   = alloc(4510000);                            // delay, reverb, chorus lines (FX_END is 4,509,696)

// voice slot layout
V_STATE = 0; V_NOTE = 1; V_VEL = 2; V_AGE = 3; V_GATE = 4;
V_PITCH = 5; V_PTGT = 6; V_GRATE = 7; V_RAND = 8; V_KEY = 9; V_FADE = 10;
V_ENV = 12;      // 3 x 4: stage, t, level, relstart
V_LFO = 24;      // 3 x 4: phase, value, sh, sh_prev (+fade counter at [3]? use 5)
V_LFOF = 40;     // 3 fade counters
V_PHA = 44;      // 8 unison phases osc A
V_PHB = 52;      // 8 unison phases osc B
V_F1 = 60;       // filter 1 state (8)
V_F2 = 68;       // filter 2 state (8)
V_SUBPH = 76; V_NZ1 = 77; V_NZ2 = 78;
V_PGL = 80; V_PGR = 81;      // previous chunk gains for interpolation
V_PG1 = 82; V_PG2 = 83;      // previous filter g
V_PK1 = 84; V_PK2 = 85;      // previous filter k
V_PDA = 86; V_PDB = 87;      // previous drive gains
V_PSUB = 88; V_PNZ = 89;     // previous sub/noise gains
V_PAL = 90; V_PAR = 91; V_PBL = 92; V_PBR = 93; // previous osc gains L/R
V_INIT = 94;                 // 1 once the previous-values are valid
V_DRIFT = 95;
V_PPM = 96; V_PRING = 97;
V_LFOV = 100;    // 3 transformed LFO values (fade, polarity applied)
V_MODE = 104;    // env 1 attack/decay/release modulation from the previous chunk
V_PAN = 108;     // per-voice pan offset (Voice Pan Spread)
V_EOUT = 112;    // the three envelope outputs after their velocity scaling (matrix sources)

// mod sources
S_ENV1 = 1; S_ENV2 = 2; S_ENV3 = 3; S_LFO1 = 4; S_LFO2 = 5; S_LFO3 = 6;
S_VEL = 7; S_KEY = 8; S_WHEEL = 9; S_AT = 10; S_BEND = 11; S_MAC1 = 12; S_MAC2 = 13;
S_MAC3 = 14; S_MAC4 = 15; S_RAND = 16; S_ONE = 17;
// mod destinations
D_PITCH = 1; D_APITCH = 2; D_BPITCH = 3; D_APOS = 4; D_BPOS = 5; D_AWARP = 6;
D_BWARP = 7; D_ALEV = 8; D_BLEV = 9; D_APAN = 10; D_BPAN = 11; D_ADET = 12; D_BDET = 13;
D_PM = 14; D_RING = 15; D_SUBLEV = 16; D_NZLEV = 17; D_F1CUT = 18; D_F1RES = 19; D_F1DRV = 20;
D_F2CUT = 21; D_F2RES = 22; D_F2DRV = 23; D_AMP = 24; D_PAN = 25; D_L1RATE = 26; D_L2RATE = 27;
D_L3RATE = 28; D_FXDRIVE = 29; D_FXCHO = 30; D_FXDLY = 31; D_FXDLYFB = 32; D_FXREV = 33;
D_FXPHA = 34; D_AFINE = 35; D_BFINE = 36; D_GLIDE = 37; D_E1ATT = 38; D_E1DEC = 39; D_E1REL = 40;
// D_L2RATE and D_L3RATE are reached as D_L1RATE + k in the LFO loop

TWOPI = 2 * $pi;
LN2 = log(2);

// ============================================================================
//  Small helpers
// ============================================================================
function clamp(v, lo, hi) ( v < lo ? lo : v > hi ? hi : v );
function db2lin(d) ( d <= -60 ? 0 : exp(d * 0.11512925464970229) );
// tanh approximation: x(27+x^2)/(27+9x^2), clamped where it would exceed +-1 (|x|>3)
function fast_tanh(x) local(x2) ( x > 3 ? 1 : x < -3 ? -1 : ( x2 = x * x; x * (27 + x2) / (27 + 9 * x2) ) );
function frac(x) ( x - floor(x) );
// Deterministic pseudo-random (32-bit LCG) so an offline render is reproducible
// bit for bit; seeded once per load. Used for unison phases, drift, S&H and noise.
rng_state = 12345;
function rnd01() ( rng_state = (rng_state * 1664525 + 1013904223) & $xFFFFFFFF; rng_state / 4294967296 );
// knob 0..1 -> time in seconds, exponential between lo and hi
function knob_time(v, lo, hi) ( lo * exp(log(hi / lo) * v) );
// cutoff knob 0..1 -> Hz, 20 Hz .. 20480 Hz (10 octaves)
function cut_hz(v) ( 20 * exp(LN2 * 10 * v) );

// ============================================================================
//  Wavetable generation
// ============================================================================
// SPEC holds harmonics 1..1023 as (re, im) pairs at SPEC[2k], SPEC[2k+1].
// With REAPER's ifft_real the time signal is  sum_k 2*im_k*sin(k th) - 2*re_k*cos(k th)
// (measured, tests/probes), so a harmonic A*sin(k th + phi) is
//   re = -0.5*A*sin(phi),  im = 0.5*A*cos(phi).
function spec_clear() ( memset(SPEC, 0, TBL_N + 4); );
function spec_set(k, a, phi) local(p)
(
  k >= 1 && k < 1024 ? (
    p = SPEC + 2 * k;
    p[0] = -0.5 * a * sin(phi);
    p[1] = 0.5 * a * cos(phi);
  );
);
function spec_add(k, a, phi) local(p)
(
  k >= 1 && k < 1024 ? (
    p = SPEC + 2 * k;
    p[0] += -0.5 * a * sin(phi);
    p[1] += 0.5 * a * cos(phi);
  );
);
// deterministic pseudo-random in [0,1) from an integer seed
function hash01(n) local(x) ( x = sin(n * 12.9898 + 78.233) * 43758.5453; x - floor(x) );

// Take the time-domain frame in TD (2048 samples) into SPEC via fft_real.
function spec_from_td() local(i, s)
(
  memcpy(WORK, TD, TBL_N);
  fft_real(WORK, TBL_N);
  fft_permute(WORK, TBL_N / 2);
  s = 1 / TBL_N;
  i = 0;
  loop(TBL_N, SPEC[i] = WORK[i] * s; i += 1;);
  SPEC[0] = 0; SPEC[1] = 0;   // no DC, no Nyquist
);

// Render SPEC band-limited to `nh` harmonics into dest (TBL_S samples), scaled by g.
function render_level(dest, nh, g) local(i)
(
  memset(WORK, 0, TBL_N + 4);
  memcpy(WORK, SPEC, 2 * (nh + 1));
  WORK[0] = 0; WORK[1] = 0;
  fft_ipermute(WORK, TBL_N / 2);
  ifft_real(WORK, TBL_N);
  i = 0;
  loop(TBL_N, dest[i] = WORK[i] * g; i += 1;);
  dest[TBL_N] = dest[0];
);

function frame_addr(bank, frame, level) ( WT + ((bank * NFRAME + frame) * NLEVEL + level) * TBL_S );

// Fill SPEC for (bank, frame). Frame f in 0..7, t = f/7 in 0..1.
function gen_spec(bank, f) local(t, k, a, ph, d, i, x, g, q, r, w, s, n, j, fr, bw, hz, sum, dens, y, lvl)
(
  spec_clear();
  t = f / (NFRAME - 1);
  bank == 0 ? (
    // Basic: sine, triangle, tri->saw, saw, saw+square, square, pulse 25, pulse 10
    f == 0 ? spec_set(1, 1, 0)
    : f == 1 ? ( k = 1; loop(511, spec_set(k, 8 / ($pi * $pi * k * k) * ((k & 3) == 1 ? 1 : -1), 0); k += 2;); )
    : f == 2 ? ( k = 1; loop(1023,
        a = 0.5 * (2 / ($pi * k)) * ((k & 1) ? 1 : -1);
        (k & 1) ? a += 0.5 * 8 / ($pi * $pi * k * k) * ((k & 3) == 1 ? 1 : -1);
        spec_set(k, a, 0); k += 1;); )
    : f == 3 ? ( k = 1; loop(1023, spec_set(k, (2 / ($pi * k)) * ((k & 1) ? 1 : -1), 0); k += 1;); )
    : f == 4 ? ( k = 1; loop(1023,
        a = 0.6 * (2 / ($pi * k)) * ((k & 1) ? 1 : -1);
        (k & 1) ? a += 0.6 * 4 / ($pi * k);
        spec_set(k, a, 0); k += 1;); )
    : f == 5 ? ( k = 1; loop(512, spec_set(k, 4 / ($pi * k), 0); k += 2;); )
    : ( d = f == 6 ? 0.25 : 0.1;
        k = 1; loop(1023, spec_set(k, 2 * sin($pi * k * d) / ($pi * k), $pi * 0.5); k += 1;); );
  ) : bank == 1 ? (
    // Warm: saw through a resonant-ish lowpass that closes across frames
    k = 1; loop(1023,
      x = k / (1 + 60 * exp(-4 * t));            // corner harmonic 61 -> ~1.1
      a = (2 / ($pi * k)) * ((k & 1) ? 1 : -1) / sqrt(1 + x * x * x * x);
      spec_set(k, a, 0); k += 1;);
  ) : bank == 2 ? (
    // Pulse: PWM 50% -> 5%
    d = 0.5 - 0.45 * t;
    k = 1; loop(1023, spec_set(k, 2 * sin($pi * k * d) / ($pi * k), $pi * 0.5); k += 1;);
  ) : bank == 3 || bank == 4 || bank == 5 ? (
    // FM: carrier:modulator ratios 1:1, 1:2, 2:1 with index rising across frames
    r = bank == 3 ? 1 : bank == 4 ? 2 : 1;
    q = bank == 5 ? 2 : 1;
    x = t * (bank == 4 ? 6 : 8);
    i = 0; loop(TBL_N, ph = TWOPI * i / TBL_N; TD[i] = sin(q * ph + x * sin(r * ph)); i += 1;);
    spec_from_td();
  ) : bank == 6 ? (
    // Sync: hard-synced saw, ratio 1 -> 4.5
    r = 1 + 3.5 * t;
    i = 0; loop(TBL_N, ph = i / TBL_N; x = frac(ph * r); TD[i] = (2 * x - 1) * (1 - 0.15 * ph); i += 1;);
    spec_from_td();
  ) : bank == 7 ? (
    // Vowel: three formants sweeping u -> o -> a -> e -> i over a 110 Hz fundamental
    j = t * 4;                                       // 0..4
    i = j | 0; fr = j - i; i > 3 ? ( i = 3; fr = 1; );
    // formant table F1,F2,F3 for u o a e i
    hz = 0; bw = 0;
    k = 1; loop(400,
      sum = 0;
      n = 0; loop(3,
        // formant frequencies (Hz) by vowel index (0 u,1 o,2 a,3 e,4 i)
        s = n == 0 ? (i == 0 ? 320 : i == 1 ? 500 : i == 2 ? 800 : 400)
          : n == 1 ? (i == 0 ? 800 : i == 1 ? 1000 : i == 2 ? 1200 : 2000)
          : (i == 0 ? 2600 : i == 1 ? 2600 : i == 2 ? 2800 : 2800);
        y = n == 0 ? (i + 1 == 1 ? 500 : i + 1 == 2 ? 800 : i + 1 == 3 ? 400 : 280)
          : n == 1 ? (i + 1 == 1 ? 1000 : i + 1 == 2 ? 1200 : i + 1 == 3 ? 2000 : 2300)
          : (i + 1 == 1 ? 2600 : i + 1 == 2 ? 2800 : i + 1 == 3 ? 2800 : 3100);
        hz = s + (y - s) * fr;
        bw = 60 + n * 40;
        w = (k * 110 - hz) / bw;
        sum += (n == 0 ? 1 : n == 1 ? 0.5 : 0.25) / (1 + w * w);
        n += 1;);
      spec_set(k, sum / k * 6 + 0.02 / k, hash01(k * 7 + 3) * TWOPI * 0.4);
      k += 1;);
  ) : bank == 8 ? (
    // Organ: drawbar sets that thicken across frames
    spec_set(1, 1, 0);
    spec_set(2, 0.2 + 0.6 * t, 0);
    spec_set(3, 0.1 + 0.6 * t, 0);
    spec_set(4, 0.5 * t, 0);
    spec_set(5, 0.05 + 0.35 * t, 0);
    spec_set(6, 0.3 * t * t, 0);
    spec_set(8, 0.4 * t * t, 0);
    spec_set(10, 0.25 * t * t * t, 0);
    spec_set(12, 0.2 * t * t * t, 0);
    spec_set(16, 0.15 * t * t * t, 0);
  ) : bank == 9 ? (
    // Bell: sparse partial sets, brighter and more inharmonic across frames
    spec_set(1, 1, 0);
    spec_set(2, 0.4 + 0.2 * t, 1.1);
    spec_set(3, 0.5 * t, 2.2);
    spec_set(5, 0.35 + 0.3 * t, 0.7);
    spec_set(7, 0.25 * (0.5 + t), 1.9);
    spec_set(9, 0.15 * t, 2.7);
    spec_set(11, 0.18 * (0.3 + t), 0.4);
    spec_set(13, 0.12 * t, 1.3);
    spec_set(17, 0.1 * t * t, 2.1);
    spec_set(19, 0.08 * t * t, 0.9);
    spec_set(23, 0.06 * t * t, 1.5);
    spec_set(29, 0.05 * t * t * t, 2.4);
  ) : bank == 10 ? (
    // Digital: sine quantized to fewer steps across frames, then sample-held saw
    n = f < 4 ? (f == 0 ? 64 : f == 1 ? 16 : f == 2 ? 8 : 4) : 0;
    i = 0; loop(TBL_N,
      ph = i / TBL_N;
      f < 4 ? (
        x = sin(TWOPI * ph);
        TD[i] = floor(x * n + 0.5) / n;
      ) : (
        q = f == 4 ? 32 : f == 5 ? 16 : f == 6 ? 8 : 5;
        x = floor(ph * q) / q;
        TD[i] = 2 * x - 1;
      );
      i += 1;);
    spec_from_td();
  ) : bank == 11 ? (
    // Fold: sine through a triangle wavefolder, gain 1 -> 9
    g = 1 + 8 * t;
    i = 0; loop(TBL_N,
      x = g * sin(TWOPI * i / TBL_N);
      // triangle fold into [-1,1]
      y = (x + 1) * 0.25; y = y - floor(y); y = abs(y * 4 - 2) - 1;
      TD[i] = y;
      i += 1;);
    spec_from_td();
  ) : bank == 12 ? (
    // Grit: comb-filtered saw, notch spacing widens across frames
    n = 2 + 6 * t;
    k = 1; loop(1023,
      a = (2 / ($pi * k)) * ((k & 1) ? 1 : -1) * (0.55 + 0.45 * cos(TWOPI * k / n));
      spec_set(k, a, 0); k += 1;);
  ) : bank == 13 ? (
    // Air: random-phase harmonics under a soft formant, density rising across frames
    dens = 0.15 + 0.85 * t;
    k = 1; loop(300,
      hash01(k * 31 + f * 101) < dens ? (
        a = (1 / sqrt(k)) * (0.4 + 0.6 * exp(-sqr((k - 12 - 30 * t) / (10 + 20 * t))));
        spec_set(k, a * 0.5, hash01(k * 17 + f * 3) * TWOPI);
      );
      k += 1;);
    spec_add(1, 0.6, 0);
  ) : bank == 14 ? (
    // OddEven: odd-harmonic square-ish (t=0) to even-emphasised (t=1)
    k = 1; loop(1023,
      a = (k & 1) ? (1 - 0.7 * t) / k : (t * 1.4) / k;
      spec_set(k, a, ((k & 3) == 3) ? $pi : 0); k += 1;);
  ) : (
    // Decay: saw with spectral decay, frame 0 bright, frame 7 near-sine
    k = 1; loop(1023,
      a = (2 / ($pi * k)) * ((k & 1) ? 1 : -1) * exp(-(k - 1) * (0.002 + 0.5 * t * t));
      spec_set(k, a, 0); k += 1;);
  );
);

function build_wavetables() local(b, f, l, addr, pk, i, g)
(
  // harmonic limits per half-octave level
  l = 0; loop(NLEVEL, LVLH[l] = max(1, floor(1023 * exp(-LN2 * 0.5 * l) + 0.5)); l += 1;);
  LVLH[0] = 1023;
  b = 0;
  loop(NBANK,
    f = 0;
    loop(NFRAME,
      gen_spec(b, f);
      // normalise: render the full-band level, measure its peak
      addr = frame_addr(b, f, 0);
      render_level(addr, LVLH[0], 1);
      pk = 0; i = 0; loop(TBL_N, pk = max(pk, abs(addr[i])); i += 1;);
      g = pk > 0.000001 ? 1 / pk : 1;
      i = 0; loop(TBL_S, addr[i] *= g; i += 1;);
      l = 1;
      loop(NLEVEL - 1,
        render_level(frame_addr(b, f, l), LVLH[l], g);
        l += 1;
      );
      f += 1;
    );
    b += 1;
  );
);

// mip level for a phase increment (cycles/sample): keep harmonics below 0.475 of srate
function mip_level(inc) local(hmax, l)
(
  inc <= 0 ? 0 : (
    hmax = 0.475 / inc;
    hmax >= 1023 ? 0 : (
      l = ceil(2 * log(1023 / hmax) / LN2);
      l < 0 ? 0 : l >= NLEVEL ? NLEVEL - 1 : l
    )
  );
);

// ============================================================================
//  Envelope / LFO helpers (per voice, control rate)
// ============================================================================
// envelope slot: e[0] stage (0 idle,1 att,2 dec,3 sus,4 rel), e[1] t (0..1 within stage),
// e[2] current level, e[3] level at release start
function env_trigger(e) ( e[0] = 1; e[1] = 0; e[3] = 0; );
function env_release(e) ( e[0] != 0 && e[0] != 4 ? ( e[3] = e[2]; e[0] = 4; e[1] = 0; ); );
function env_shape_att(t, c) ( c >= 0 ? 1 - pow(1 - t, 1 + 3 * c) : pow(t, 1 - 3 * c) );
function env_shape_fall(t, c) ( pow(1 - t, exp(LN2 * (1.585 + 2 * c))) );

// advance envelope by n samples; params in seconds
function env_step(e, n, att, dec, sus, rel, curve) local(st, t)
(
  st = e[0];
  st == 1 ? (
    t = e[1] + n / max(att * srate, 1);
    t >= 1 ? ( e[2] = 1; e[0] = 2; e[1] = 0; ) : ( e[1] = t; e[2] = env_shape_att(t, curve); );
  ) : st == 2 ? (
    t = e[1] + n / max(dec * srate, 1);
    t >= 1 ? ( e[2] = sus; e[0] = 3; e[1] = 0; ) : ( e[1] = t; e[2] = sus + (1 - sus) * env_shape_fall(t, curve); );
  ) : st == 3 ? (
    e[2] = sus;
  ) : st == 4 ? (
    t = e[1] + n / max(rel * srate, 1);
    t >= 1 ? ( e[2] = 0; e[0] = 0; e[1] = 0; ) : ( e[1] = t; e[2] = e[3] * env_shape_fall(t, curve); );
  ) : ( e[2] = 0; );
  e[2]
);

// LFO shape evaluation for phase p in [0,1); returns bipolar -1..1
function lfo_shape(shape, p, lf) local(v)
(
  shape == 0 ? sin(TWOPI * p)
  : shape == 1 ? 1 - 4 * abs(p - 0.5)
  : shape == 2 ? 2 * p - 1
  : shape == 3 ? 1 - 2 * p
  : shape == 4 ? (p < 0.5 ? 1 : -1)
  : shape == 5 ? lf[2]
  : shape == 6 ? ( v = p * p * (3 - 2 * p); lf[3] + (lf[2] - lf[3]) * v )
  : (p < 0.1 ? 1 : -1);
);

// advance one LFO slot lf (phase, value, sh, sh_prev) by n samples at rate hz
function lfo_step(lf, n, hz, shape) local(p)
(
  p = lf[0] + n * hz / srate;
  p >= 1 ? ( p -= floor(p); lf[3] = lf[2]; lf[2] = 2 * rnd01() - 1; );
  lf[0] = p;
  lf[1] = lfo_shape(shape, p, lf);
  lf[1]
);

// musical divisions, in quarter-note beats: 4/1 2/1 1/1 1/2 1/2. 1/4 1/4. 1/4T 1/8 1/8. 1/8T 1/16 1/32
function div_beats(div)
(
  div == 0 ? 16 : div == 1 ? 8 : div == 2 ? 4 : div == 3 ? 2 : div == 4 ? 3 : div == 5 ? 1 : div == 6 ? 1.5
  : div == 7 ? 0.6666667 : div == 8 ? 0.5 : div == 9 ? 0.75 : div == 10 ? 0.3333333 : div == 11 ? 0.25 : 0.125
);
function lfo_rate_hz(v, sync, div, ratemod) local(beats, hz)
(
  sync ? (
    beats = div_beats(div);
    hz = tempo / 60 / beats;
  ) : (
    hz = 0.01 * exp(log(5000) * v);
  );
  hz * exp(LN2 * 3 * ratemod)
);

// ============================================================================
//  Voice allocation
// ============================================================================
age_counter = 0;
function voice_addr(i) ( VOICE + i * VSTRIDE );

function voice_clear(v)
(
  memset(v, 0, VSTRIDE);
);

// copy a playing voice into a ghost slot so it can fade while its slot restarts
function make_ghost(v) local(i, g, best, bestage)
(
  best = -1; bestage = 1000;
  i = NVOICE;
  loop(NGHOST,
    g = voice_addr(i);
    g[V_STATE] == 0 ? ( bestage >= 0 ? ( best = i; bestage = -1; ); ) : (bestage >= 0 && (best < 0 || g[V_FADE] < bestage)) ? ( best = i; bestage = g[V_FADE]; );
    i += 1;
  );
  best >= 0 ? (
    g = voice_addr(best);
    memcpy(g, v, VSTRIDE);
    g[V_STATE] = 3;
    g[V_FADE] = 1;      // linear fade multiplier, ramps to 0
  );
);

// choose a slot for a new note; returns slot index
function find_voice(note) local(i, v, best, bestscore, score, cnt, lim)
(
  lim = polymax | 0;
  // count active
  cnt = 0; i = 0; loop(NVOICE, cnt += voice_addr(i)[V_STATE] != 0; i += 1;);
  best = -1; bestscore = 1000000000;
  i = 0;
  loop(NVOICE,
    v = voice_addr(i);
    v[V_STATE] == 0 ? (
      cnt < lim ? ( score = -1000000 + i; ) : ( score = 1000000000; );
    ) : (
      // prefer released voices, quietest first, then the oldest
      score = (v[V_STATE] == 2 ? 0 : 500000) + v[V_ENV + 2] * 100000 + v[V_AGE];
      // same note retrigger: prefer re-using it once the polyphony limit is reached (a free slot still wins)
      v[V_NOTE] == note && vmode == 0 ? score = -500000;
    );
    score < bestscore ? ( bestscore = score; best = i; );
    i += 1;
  );
  best
);

function glide_active(legato) ( glide + DSTG[D_GLIDE] > 0.001 && (glide_leg == 0 || legato) );

function voice_start(slot, note, vel, legato) local(v, k, r, pitch)
(
  v = voice_addr(slot);
  v[V_STATE] != 0 && !legato ? ( make_ghost(v); );
  !legato ? (
    // keep filter state warm? no: fresh start
    voice_clear(v);
    v[V_RAND] = rnd01();
    v[V_DRIFT] = rnd01() * 2 - 1;
    pan_flip = !pan_flip;   // alternate sides per note (the slot is fixed in Mono/Legato)
    v[V_PAN] = (0.5 + 0.5 * rnd01()) * (pan_flip ? 1 : -1) * PS[2];
    // unison phases
    k = 0;
    loop(8,
      v[V_PHA + k] = a_retrig ? (k * 0.125) : rnd01();
      v[V_PHB + k] = b_retrig ? (k * 0.125) : rnd01();
      k += 1;
    );
    v[V_SUBPH] = 0;
    env_trigger(v + V_ENV); env_trigger(v + V_ENV + 4); env_trigger(v + V_ENV + 8);
    // LFO poly phases
    k = 0; loop(3,
      v[V_LFO + k * 4] = slider(86 + k * 8);
      v[V_LFO + k * 4 + 2] = 2 * rnd01() - 1; v[V_LFO + k * 4 + 3] = 2 * rnd01() - 1;
      v[V_LFOF + k] = 0;
      k += 1;);
    v[V_PITCH] = last_pitch;
  );
  v[V_STATE] = 1;
  v[V_GATE] = 1;
  v[V_NOTE] = note;
  v[V_VEL] = vel;
  v[V_KEY] = (note - 60) / 60;
  age_counter += 1; v[V_AGE] = age_counter;
  pitch = note;
  v[V_PTGT] = pitch;
  // glide
  r = glide_active(legato) ? knob_time(clamp(glide + DSTG[D_GLIDE], 0, 1), 0.005, 5) : 0;
  r > 0 && last_pitch_valid ? (
    (!legato) ? v[V_PITCH] = last_pitch;
    v[V_GRATE] = abs(pitch - v[V_PITCH]) / (r * srate);
    v[V_GRATE] <= 0 ? v[V_PITCH] = pitch;
  ) : ( v[V_GRATE] = 0; v[V_PITCH] = pitch; );
  last_pitch = pitch; last_pitch_valid = 1;
);

function voice_release(slot) local(v)
(
  v = voice_addr(slot);
  v[V_STATE] == 1 ? (
    v[V_GATE] = 0;
    v[V_STATE] = 2;
    env_release(v + V_ENV); env_release(v + V_ENV + 4); env_release(v + V_ENV + 8);
  );
);

// ---- mono note stack
mono_n = 0;
function mono_push(note) local(i)
(
  // remove if present, then append
  i = 0; loop(mono_n, MONOST[i] == note ? ( memcpy(MONOST + i, MONOST + i + 1, mono_n - i - 1); mono_n -= 1; ); i += 1;);
  mono_n < 60 ? ( MONOST[mono_n] = note; mono_n += 1; );
);
function mono_remove(note) local(i, found)
(
  found = 0;
  i = 0; loop(mono_n, (!found && MONOST[i] == note) ? ( memcpy(MONOST + i, MONOST + i + 1, mono_n - i - 1); mono_n -= 1; found = 1; ); i += 1;);
);

// ============================================================================
//  MIDI event handling
// ============================================================================
sustain = 0;
function note_on(note, vel) local(slot, v, legato)
(
  vel = clamp(vel / 127, 0.001, 1);
  // velocity curve
  vel = velcurve >= 0 ? pow(vel, 1 / (1 + 3 * velcurve)) : pow(vel, 1 - 3 * velcurve);
  vmode == 0 ? (
    slot = find_voice(note);
    slot >= 0 ? voice_start(slot, note, vel, 0);
  ) : (
    // mono / legato: voice 0 only
    v = voice_addr(0);
    legato = (vmode == 2) && v[V_STATE] == 1;
    mono_push(note);
    voice_start(0, note, vel, legato);
  );
  SUS_HELD[note] = 0;
);

function note_off(note) local(i, v)
(
  vmode == 0 ? (
    sustain ? SUS_HELD[note] = 1 : (
      i = 0; loop(NVOICE, v = voice_addr(i); (v[V_STATE] == 1 && v[V_NOTE] == note) ? voice_release(i); i += 1;);
    );
  ) : (
    mono_remove(note);
    v = voice_addr(0);
    v[V_NOTE] == note && v[V_STATE] == 1 ? (
      mono_n > 0 ? (
        // return to the previously held note
        voice_start(0, MONOST[mono_n - 1], v[V_VEL], vmode == 2);
      ) : (
        sustain ? SUS_HELD[note] = 1 : voice_release(0);
      );
    );
  );
);

function all_notes_off() local(i)
(
  i = 0; loop(NVOICE, voice_release(i); i += 1;);
  mono_n = 0;
  memset(SUS_HELD, 0, 128);
);

function sustain_release() local(n, i, v)
(
  n = 0;
  loop(128,
    SUS_HELD[n] ? (
      SUS_HELD[n] = 0;
      vmode == 0 ? (
        i = 0; loop(NVOICE, v = voice_addr(i); (v[V_STATE] == 1 && v[V_NOTE] == n) ? voice_release(i); i += 1;);
      ) : ( mono_n == 0 ? voice_release(0); );
    );
    n += 1;
  );
);

SUS_HELD = alloc(128);
wheel = 0; aftertouch = 0; bend = 0;

function handle_event(m1, m2, m3) local(st)
(
  st = m1 & $xF0;
  st == $x90 && m3 > 0 ? note_on(m2, m3)
  : (st == $x80 || (st == $x90 && m3 == 0)) ? note_off(m2)
  : st == $xB0 ? (
      m2 == 1 ? wheel = m3 / 127
      : m2 == 64 ? ( sustain = m3 >= 64; !sustain ? sustain_release(); )
      : (m2 == 120 || m2 == 123) ? all_notes_off()
      : m2 == 121 ? ( wheel = 0; aftertouch = 0; bend = 0; )
      : (m2 == 0 || m2 == 32) ? midi_bank = m3;   // bank select (MSB or LSB): presets past 127 live in bank 1
    )
  : st == $xC0 ? ( midi_bank * 128 + m2 < NPRESET ? preset_pending = midi_bank * 128 + m2; )
  : st == $xD0 ? aftertouch = m2 / 127
  : st == $xE0 ? bend = (((m3 << 7) | m2) - 8192) / 8192;
);

// ============================================================================
//  Modulation
// ============================================================================
// compute all source values for voice v into SRCV, then run the matrix into DST
function run_matrix(v) local(i, s, d, amt, via, x, m)
(
  SRCV[S_ENV1] = v[V_EOUT]; SRCV[S_ENV2] = v[V_EOUT + 1]; SRCV[S_ENV3] = v[V_EOUT + 2];
  SRCV[S_LFO1] = v[V_LFOV]; SRCV[S_LFO2] = v[V_LFOV + 1]; SRCV[S_LFO3] = v[V_LFOV + 2];
  SRCV[S_VEL] = v[V_VEL]; SRCV[S_KEY] = v[V_KEY]; SRCV[S_WHEEL] = wheel_s; SRCV[S_AT] = at_s;
  SRCV[S_BEND] = bend; SRCV[S_MAC1] = PS[106]; SRCV[S_MAC2] = PS[107]; SRCV[S_MAC3] = PS[108];
  SRCV[S_MAC4] = PS[109]; SRCV[S_RAND] = v[V_RAND] * 2 - 1; SRCV[S_ONE] = 1;
  memset(DST, 0, NDST);
  i = 0;
  loop(NMOD,
    m = 110 + i * 4;
    s = slider(m) | 0; d = slider(m + 1) | 0;
    s > 0 && d > 0 ? (
      amt = PS[m + 2];
      x = SRCV[s] * amt;
      via = slider(m + 3) | 0;
      via > 0 ? x *= SRCV[via];
      DST[d] += x;
    );
    i += 1;
  );
  v[V_MODE] = DST[D_E1ATT]; v[V_MODE + 1] = DST[D_E1DEC]; v[V_MODE + 2] = DST[D_E1REL];
);

// ============================================================================
//  Per-voice control update + render of one chunk (n samples at buffer pos)
// ============================================================================
function unison_setup(base, nuni, det, spread, blend, pan, inc) local(k, d, w, norm, pl, pr, p, g)
(
  // fills UNIG[base + k*3 + 0..2] = gainL, gainR, increment
  nuni <= 1 ? (
    p = clamp(pan, -1, 1);
    UNIG[base] = cos((p + 1) * $pi * 0.25);
    UNIG[base + 1] = sin((p + 1) * $pi * 0.25);
    UNIG[base + 2] = inc;
    1
  ) : (
    norm = 0;
    k = 0;
    loop(nuni,
      d = 2 * k / (nuni - 1) - 1;                    // -1 .. 1
      g = blend + (1 - blend) * (1 - abs(d));
      norm += g * g;
      p = clamp(pan + spread * d, -1, 1);
      UNIG[base + k * 3] = g * cos((p + 1) * $pi * 0.25);
      UNIG[base + k * 3 + 1] = g * sin((p + 1) * $pi * 0.25);
      // slightly non-linear detune curve keeps the centre dense and the edges wide
      w = d * (0.7 + 0.3 * abs(d));
      UNIG[base + k * 3 + 2] = inc * exp(LN2 * det * 2 * w / 12);
      k += 1;
    );
    norm = 1 / sqrt(max(norm, 0.5));   // Unison 2 at low Blend fades out instead of dividing by zero
    k = 0; loop(nuni, UNIG[base + k * 3] *= norm; UNIG[base + k * 3 + 1] *= norm; k += 1;);
    nuni
  );
);

// filter coefficient helpers ---------------------------------------------
function svf_g(hz) ( tan($pi * clamp(hz, 10, 0.49 * srate) / srate) );

// render a voice slot for n samples starting at buffer position pos
function voice_render(slot, pos, n)
local(v, st, gl, gr, pitch, pbend, keyoff, p, i, k, x, y, s, s0, s1, idx, i0, fr, pp, aon, bon, nua, nub, incA, incB, incAmax, incBmax, lvA, lvB, lvlA, lvlB, a_l, a_r, b_l, b_r, sA, sB, sAm, sBm, subg, nzg, e1, e2, e3, rate, fade, cut1, cut2, res1, res2, drv1, drv2, g1, g2, k1, k2, t1, t2, keyf1, keyf2, ftype1, ftype2, posA, posB, fA, fB, frA, frB, tA0, tA1, tB0, tB1, warpA, warpB, wamtA, wamtB, bendA, bendB, syncA, syncB, quantA, quantB, fastA, fastB, pm, ring, amp, pan, driftA, driftB, sub, nz, subinc, subph, nzs1, nzs2, nzmix, nzc1, nzc2, subsh, subtbl, blepA, blepB, dA1, dB1, xb, dgl, dgr, dg1, dg2, dk1, dk2, ddA, ddB, dsub, dnz, dal, dbl, dpm, dring, pgl, pgr, pal, pbl, pg1, pg2, pk1, pk2, pda, pdb, psub, pnz, ppm, pring, n_inv, a1, a2, a3, b1, b2, b3, v1, v2, v3, G, GG, S, u, yl, yr, route, fmixl, fmixr, ghost, fadestep, fadeval, fm_a, fa0_a, fa1_a, fa2_a, fb0_a, fb1_a, fb2_a, cg_a, ck_a, pd_a, xl_a, xr_a, yl_a, yr_a, l1_a, l2_a, l3_a, l4_a, r1_a, r2_a, r3_a, r4_a, fm_b, fa0_b, fa1_b, fa2_b, fb0_b, fb1_b, fb2_b, cg_b, ck_b, pd_b, xl_b, xr_b, yl_b, yr_b, l1_b, l2_b, l3_b, l4_b, r1_b, r2_b, r3_b, r4_b, <?loop(k=0;8, printf("pa%d, ia%d, la%d, ra%d, pb%d, ib%d, lb%d, rb%d, ", k, k, k, k, k, k, k, k); k += 1;)?> uend)
(
  v = voice_addr(slot);
  st = v[V_STATE];
  ghost = st == 3;
  // ---------------------------------------------------------------- control
  // glide
  // glide: V_GRATE is semitones per sample, set at note start so the whole
  // interval takes the glide time whatever its size
  v[V_GRATE] > 0 ? (
    p = v[V_PITCH]; pp = v[V_PTGT];
    p < pp ? ( p = min(pp, p + n * v[V_GRATE]); ) : ( p = max(pp, p - n * v[V_GRATE]); );
    p == pp ? v[V_GRATE] = 0;
    v[V_PITCH] = p;
  );
  pitch = v[V_PITCH];

  // modulation matrix first, from the sources as they stood at the end of the previous
  // chunk (one 32-sample lag), so envelope times and LFO rates can be modulated
  run_matrix(v);
  // envelopes; env 1 times are scaled by their matrix destinations (+-1 = x4 / x0.25)
  e1 = env_step(v + V_ENV, n, knob_time(PS[64], 0.0005, 20) * exp(LN2 * 2 * v[V_MODE]), knob_time(PS[65], 0.001, 20) * exp(LN2 * 2 * v[V_MODE + 1]), PS[66], knob_time(PS[67], 0.001, 20) * exp(LN2 * 2 * v[V_MODE + 2]), PS[68]);
  e2 = env_step(v + V_ENV + 4, n, knob_time(PS[70], 0.0005, 20), knob_time(PS[71], 0.001, 20), PS[72], knob_time(PS[73], 0.001, 20), PS[74]);
  e3 = env_step(v + V_ENV + 8, n, knob_time(PS[76], 0.0005, 20), knob_time(PS[77], 0.001, 20), PS[78], knob_time(PS[79], 0.001, 20), PS[80]);
  // velocity scaling of envelope outputs
  e1 *= 1 - PS[69] * (1 - v[V_VEL]);
  e2 *= 1 - PS[75] * (1 - v[V_VEL]);
  e3 *= 1 - PS[81] * (1 - v[V_VEL]);
  v[V_EOUT] = e1; v[V_EOUT + 1] = e2; v[V_EOUT + 2] = e3;

  // poly LFOs (mono ones are computed globally and stored in LFOMONO)
  k = 0;
  loop(3,
    slider(88 + k * 8) == 1 ? (
      x = LFOMONO[k];
      fade = knob_time(PS[87 + k * 8], 0.001, 10);
      PS[87 + k * 8] > 0.001 ? ( v[V_LFOF + k] = min(1, v[V_LFOF + k] + n / (fade * srate)); x *= v[V_LFOF + k]; );
      SRCV[S_LFO1 + k] = x;
    ) : (
      rate = lfo_rate_hz(PS[83 + k * 8], slider(84 + k * 8), slider(85 + k * 8) | 0, DST[D_L1RATE + k]);
      x = lfo_step(v + V_LFO + k * 4, n, rate, slider(82 + k * 8) | 0);
      fade = knob_time(PS[87 + k * 8], 0.001, 10);
      PS[87 + k * 8] > 0.001 ? ( v[V_LFOF + k] = min(1, v[V_LFOF + k] + n / (fade * srate)); x *= v[V_LFOF + k]; );
      slider(89 + k * 8) ? x = 0.5 * (x + 1);
      SRCV[S_LFO1 + k] = x;
    );
    v[V_LFOV + k] = SRCV[S_LFO1 + k];
    k += 1;
  );

  // ---- pitch
  pbend = bend * bendrange;
  driftA = PS[9] * v[V_DRIFT] * 0.06;
  driftB = PS[9] * (v[V_DRIFT] * -0.7 + 0.3) * 0.06;
  keyoff = pitch - 60;
  p = (a_key ? keyoff : 0) + 60 + pbend + PS[16] + PS[17] * 0.01 + DST[D_PITCH] * 24 + DST[D_APITCH] * 24 + DST[D_AFINE] + driftA;
  incA = 440 * exp(LN2 * (p - 69) / 12) / srate;
  p = (b_key ? keyoff : 0) + 60 + pbend + PS[31] + PS[32] * 0.01 + DST[D_PITCH] * 24 + DST[D_BPITCH] * 24 + DST[D_BFINE] + driftB;
  incB = 440 * exp(LN2 * (p - 69) / 12) / srate;
  subinc = 440 * exp(LN2 * (pitch + pbend + DST[D_PITCH] * 24 - 69 - 12 - 12 * sub_oct) / 12) / srate;

  // ---- oscillator setup
  pm = clamp(PS[41] + DST[D_PM], 0, 1) * 2;
  ring = clamp(PS[42] + DST[D_RING], 0, 1);
  aon = a_on && (PS[18] > -60 || pm > 0 || ring > 0); bon = b_on && PS[33] > -60;
  nua = aon ? unison_setup(0, a_uni | 0, clamp(PS[21] + DST[D_ADET], 0, 1), PS[22], PS[23], PS[19] + DST[D_APAN], incA) : 0;
  nub = bon ? unison_setup(24, b_uni | 0, clamp(PS[36] + DST[D_BDET], 0, 1), PS[37], PS[38], PS[34] + DST[D_BPAN], incB) : 0;
  warpA = a_warp | 0; warpB = b_warp | 0;
  wamtA = clamp(PS[15] + DST[D_AWARP], 0, 1); wamtB = clamp(PS[30] + DST[D_BWARP], 0, 1);
  // mip level: use the highest unison increment; sync/formant warp multiplies the harmonic density
  incAmax = incA * exp(LN2 * clamp(PS[21] + DST[D_ADET], 0, 1) * 2 / 12) * ((warpA == 2 || warpA == 5) ? 1 + wamtA * 7 : warpA == 3 ? 2 : 1);
  incBmax = incB * exp(LN2 * clamp(PS[36] + DST[D_BDET], 0, 1) * 2 / 12) * ((warpB == 2 || warpB == 5) ? 1 + wamtB * 7 : warpB == 3 ? 2 : 1);
  lvlA = mip_level(incAmax); lvlB = mip_level(incBmax);
  posA = clamp(PS[13] + DST[D_APOS], 0, 1) * (NFRAME - 1); fA = posA | 0; frA = posA - fA; fA >= NFRAME - 1 ? ( fA = NFRAME - 1; frA = 0; );
  posB = clamp(PS[28] + DST[D_BPOS], 0, 1) * (NFRAME - 1); fB = posB | 0; frB = posB - fB; fB >= NFRAME - 1 ? ( fB = NFRAME - 1; frB = 0; );
  tA0 = frame_addr(a_bank | 0, fA, lvlA); tA1 = frA > 0.0005 ? frame_addr(a_bank | 0, fA + 1, lvlA) : 0;
  tB0 = frame_addr(b_bank | 0, fB, lvlB); tB1 = frB > 0.0005 ? frame_addr(b_bank | 0, fB + 1, lvlB) : 0;
  fastA = warpA == 0 && tA1 == 0;
  fastB = warpB == 0 && tB1 == 0 && v[V_PPM] == 0;
  // warp precomputation
  bendA = 0.5 - 0.47 * wamtA; bendB = 0.5 - 0.47 * wamtB;
  syncA = 1 + wamtA * 7; syncB = 1 + wamtB * 7;
  // band-limited step (polyBLEP) for the hard-sync family: dX1 = the step when the master resets
  // the slave from phase frac(ratio). The slave's own wrap is continuous (guard sample at TBL_N).
  blepA = warpA == 2 || warpA == 5; blepB = warpB == 2 || warpB == 5;
  blepA ? (
    idx = frac(syncA) * TBL_N; i0 = idx | 0; fr = idx - i0;
    dA1 = tA0[0] - (tA0[i0] + fr * (tA0[i0 + 1] - tA0[i0]));
    tA1 ? dA1 += frA * (tA1[0] - (tA1[i0] + fr * (tA1[i0 + 1] - tA1[i0])) - dA1);
    warpA == 5 ? dA1 = 0;    // the formant window is zero at the master reset
  ) : dA1 = 0;
  blepB ? (
    idx = frac(syncB) * TBL_N; i0 = idx | 0; fr = idx - i0;
    dB1 = tB0[0] - (tB0[i0] + fr * (tB0[i0 + 1] - tB0[i0]));
    tB1 ? dB1 += frB * (tB1[0] - (tB1[i0] + fr * (tB1[i0 + 1] - tB1[i0])) - dB1);
    warpB == 5 ? dB1 = 0;
  ) : dB1 = 0;
  quantA = 2 + (1 - wamtA) * 62; quantB = 2 + (1 - wamtB) * 62;

  // ---- gains for this chunk (targets)
  amp = e1 * (1 + DST[D_AMP]); amp < 0 ? amp = 0;
  pan = clamp(DST[D_PAN] + v[V_PAN], -1, 1);
  gl = amp * cos((pan + 1) * $pi * 0.25) * 1.4142;
  gr = amp * sin((pan + 1) * $pi * 0.25) * 1.4142;
  lvA = aon ? db2lin(PS[18]) * max(0, 1 + DST[D_ALEV]) : 0;
  lvB = bon ? db2lin(PS[33]) * max(0, 1 + DST[D_BLEV]) : 0;
  subg = db2lin(PS[43]) * max(0, 1 + DST[D_SUBLEV]);
  nzg = db2lin(PS[46]) * max(0, 1 + DST[D_NZLEV]) * 0.5;
  fastB = fastB && pm == 0;

  // ---- filters
  ftype1 = f1_type | 0; ftype2 = f2_type | 0;
  keyf1 = PS[52] * keyoff / 120; keyf2 = PS[59] * keyoff / 120;
  cut1 = clamp(PS[49] + keyf1 + PS[53] * e2 * 0.5 + PS[54] * e3 * 0.5 + DST[D_F1CUT] * 0.5, 0, 1);
  cut2 = clamp(PS[56] + keyf2 + PS[60] * e2 * 0.5 + PS[61] * e3 * 0.5 + DST[D_F2CUT] * 0.5, 0, 1);
  res1 = clamp(PS[50] + DST[D_F1RES], 0, 1); res2 = clamp(PS[57] + DST[D_F2RES], 0, 1);
  drv1 = clamp(PS[51] + DST[D_F1DRV], 0, 1); drv2 = clamp(PS[58] + DST[D_F2DRV], 0, 1);
  g1 = svf_g(cut_hz(cut1)); g2 = svf_g(cut_hz(cut2));
  // SVF damping: 12 dB modes start at Q 0.707 (k 1.414); 24 dB modes are two stages,
  // Butterworth-staged at zero resonance (k 1.848 then 0.765), resonance lowering the
  // second stage's damping toward self-oscillation. The ladder uses k as feedback 0..4.2.
  ftype1 == 8 ? ( k1 = res1 * 4.2; ) : (ftype1 == 2 || ftype1 == 4 || ftype1 == 6) ? ( k1 = 0.765 - 0.745 * res1; ) : ( k1 = 1.414 - 1.39 * res1; );
  ftype2 == 8 ? ( k2 = res2 * 4.2; ) : (ftype2 == 2 || ftype2 == 4 || ftype2 == 6) ? ( k2 = 0.765 - 0.745 * res2; ) : ( k2 = 1.414 - 1.39 * res2; );
  // the ladder's corner is capped at 0.45 sr (tan(pi f/sr) <= 6.3): the TPT loop is stable for any g,
  // the cap keeps the resonance peak below Nyquist at every rate instead of at a fixed 12 kHz
  ftype1 == 8 ? ( g1 = min(g1, 6.3); );
  ftype2 == 8 ? ( g2 = min(g2, 6.3); );
  t1 = 1 + drv1 * 9; t2 = 1 + drv2 * 9;   // drive input gains
  // filter mode: 0 off, 1 one SVF stage, 2 two stages (24 dB), 3 ladder; output = fa0*x + fa1*k*v1 + fa2*v2
  fm_a = ftype1 == 0 ? 0 : ftype1 == 8 ? 3 : (ftype1 == 2 || ftype1 == 4 || ftype1 == 6) ? 2 : 1;
  (ftype1 == 1 || ftype1 == 2) ? ( fa0_a = 0; fa1_a = 0; fa2_a = 1; )
  : (ftype1 == 3 || ftype1 == 4) ? ( fa0_a = 1; fa1_a = -1; fa2_a = -1; )
  : (ftype1 == 5 || ftype1 == 6) ? ( fa0_a = 0; fa1_a = 1; fa2_a = 0; )
  : ( fa0_a = 1; fa1_a = -1; fa2_a = 0; );
  fb0_a = fa0_a; fb1_a = fa1_a * 1.848; fb2_a = fa2_a;
  fm_b = ftype2 == 0 ? 0 : ftype2 == 8 ? 3 : (ftype2 == 2 || ftype2 == 4 || ftype2 == 6) ? 2 : 1;
  (ftype2 == 1 || ftype2 == 2) ? ( fa0_b = 0; fa1_b = 0; fa2_b = 1; )
  : (ftype2 == 3 || ftype2 == 4) ? ( fa0_b = 1; fa1_b = -1; fa2_b = -1; )
  : (ftype2 == 5 || ftype2 == 6) ? ( fa0_b = 0; fa1_b = 1; fa2_b = 0; )
  : ( fa0_b = 1; fa1_b = -1; fa2_b = 0; );
  fb0_b = fa0_b; fb1_b = fa1_b * 1.848; fb2_b = fa2_b;

  // ---- previous chunk values for interpolation
  v[V_INIT] == 0 ? (
    v[V_PGL] = 0; v[V_PGR] = 0; v[V_PG1] = g1; v[V_PG2] = g2; v[V_PK1] = k1; v[V_PK2] = k2;
    v[V_PDA] = t1; v[V_PDB] = t2; v[V_PSUB] = subg; v[V_PNZ] = nzg;
    v[V_PAL] = lvA; v[V_PAR] = lvA; v[V_PBL] = lvB; v[V_PBR] = lvB; v[V_PPM] = pm; v[V_PRING] = ring;
    v[V_INIT] = 1;
  );
  n_inv = 1 / n;
  pgl = v[V_PGL]; dgl = (gl - pgl) * n_inv;
  pgr = v[V_PGR]; dgr = (gr - pgr) * n_inv;
  pg1 = v[V_PG1]; dg1 = (g1 - pg1) * n_inv;
  pg2 = v[V_PG2]; dg2 = (g2 - pg2) * n_inv;
  pk1 = v[V_PK1]; dk1 = (k1 - pk1) * n_inv;
  pk2 = v[V_PK2]; dk2 = (k2 - pk2) * n_inv;
  pda = v[V_PDA]; ddA = (t1 - pda) * n_inv;
  pdb = v[V_PDB]; ddB = (t2 - pdb) * n_inv;
  psub = v[V_PSUB]; dsub = (subg - psub) * n_inv;
  pnz = v[V_PNZ]; dnz = (nzg - pnz) * n_inv;
  pal = v[V_PAL]; dal = (lvA - pal) * n_inv;
  pbl = v[V_PBL]; dbl = (lvB - pbl) * n_inv;
  ppm = v[V_PPM]; dpm = (pm - ppm) * n_inv;
  pring = v[V_PRING]; dring = (ring - pring) * n_inv;
  v[V_PGL] = gl; v[V_PGR] = gr; v[V_PG1] = g1; v[V_PG2] = g2; v[V_PK1] = k1; v[V_PK2] = k2;
  v[V_PDA] = t1; v[V_PDB] = t2; v[V_PSUB] = subg; v[V_PNZ] = nzg; v[V_PAL] = lvA; v[V_PBL] = lvB;
  v[V_PPM] = pm; v[V_PRING] = ring;

  // ghost fade: linear ramp over 64 samples
  ghost ? ( fadeval = v[V_FADE]; fadestep = 1 / (0.0013 * srate); ) : ( fadeval = 1; fadestep = 0; );   // 1.3 ms fade

  // sub / noise setup
  subsh = sub_shape | 0;
  subtbl = frame_addr(0, subsh == 0 ? 0 : subsh == 1 ? 1 : 5, mip_level(subinc));
  subph = v[V_SUBPH];
  nzs1 = v[V_NZ1]; nzs2 = v[V_NZ2];
  nzc1 = 1 - exp(-TWOPI * 150 / srate); nzc2 = 1 - exp(-TWOPI * 3300 / srate);
  // noise colour: negative = darker (more one-pole lowpass), positive = brighter (highpassed)
  nzmix = PS[47];

  // filter states (l1..l4 left, r1..r4 right; the ladder uses all four per side)
  l1_a = v[V_F1]; l2_a = v[V_F1 + 1]; l3_a = v[V_F1 + 2]; l4_a = v[V_F1 + 3];
  r1_a = v[V_F1 + 4]; r2_a = v[V_F1 + 5]; r3_a = v[V_F1 + 6]; r4_a = v[V_F1 + 7];
  l1_b = v[V_F2]; l2_b = v[V_F2 + 1]; l3_b = v[V_F2 + 2]; l4_b = v[V_F2 + 3];
  r1_b = v[V_F2 + 4]; r2_b = v[V_F2 + 5]; r3_b = v[V_F2 + 6]; r4_b = v[V_F2 + 7];
  route = froute | 0;
  fmixl = 0.5 - 0.5 * PS[63]; fmixr = 0.5 + 0.5 * PS[63];

  // unison state into locals (memory access per sample is the dominant cost in EEL2)
  <?loop(k=0;8, printf("pa%d = v[V_PHA + %d]; ia%d = UNIG[%d]; la%d = UNIG[%d]; ra%d = UNIG[%d];\n", k, k, k, k*3+2, k, k*3, k, k*3+1); k += 1;)?>
  <?loop(k=0;8, printf("pb%d = v[V_PHB + %d]; ib%d = UNIG[%d]; lb%d = UNIG[%d]; rb%d = UNIG[%d];\n", k, k, k, 24+k*3+2, k, 24+k*3, k, 24+k*3+1); k += 1;)?>
  // ---------------------------------------------------------------- render
  i = 0;
  loop(n,
    // ---- osc A (unrolled unison; each voice guarded by its count). Fast path: no warp, no morph.
    sA = 0; a_l = 0; a_r = 0;
    fastA ? (
    <?loop(k=0;8, printf("
    nua > %d ? (
      pa%d += ia%d; pa%d >= 1 ? pa%d -= 1;
      idx = pa%d * TBL_N; i0 = idx | 0; fr = idx - i0;
      s0 = tA0[i0]; s = s0 + fr * (tA0[i0 + 1] - s0);
      a_l += s * la%d; a_r += s * ra%d; sA += s;\n", k, k, k, k, k, k, k, k); k += 1;)?>
    <?loop(k=0;8, printf(");"); k += 1;)?>
    ) : (
    <?loop(k=0;8, printf("
    nua > %d ? (
      pa%d += ia%d; pa%d >= 1 ? pa%d -= 1;
      pp = warpA == 0 ? pa%d
         : warpA == 1 ? (pa%d < bendA ? pa%d * 0.5 / bendA : 0.5 + (pa%d - bendA) * 0.5 / (1 - bendA))
         : warpA == 2 ? frac(pa%d * syncA)
         : warpA == 3 ? (pa%d < 0.5 ? pa%d * 2 : 2 - pa%d * 2) * wamtA + pa%d * (1 - wamtA)
         : warpA == 4 ? floor(pa%d * quantA) / quantA
         : frac(pa%d * syncA);
      idx = pp * TBL_N; i0 = idx | 0; fr = idx - i0;
      s0 = tA0[i0]; s = s0 + fr * (tA0[i0 + 1] - s0);
      tA1 ? ( s0 = tA1[i0]; s += frA * (s0 + fr * (tA1[i0 + 1] - s0) - s); );
      warpA == 5 ? ( s0 = SINTBL[(pa%d * 1024) | 0]; s *= s0 * s0; );
