slider115:m2_dst=0<0,40,1>-Mod 2 Destination
slider116:m2_amt=0<-1,1,0.001>-Mod 2 Amount
slider117:m2_via=0<0,17,1>-Mod 2 Via
slider118:m3_src=0<0,17,1>-Mod 3 Source
slider119:m3_dst=0<0,40,1>-Mod 3 Destination
slider120:m3_amt=0<-1,1,0.001>-Mod 3 Amount
slider121:m3_via=0<0,17,1>-Mod 3 Via
slider122:m4_src=0<0,17,1>-Mod 4 Source
slider123:m4_dst=0<0,40,1>-Mod 4 Destination
slider124:m4_amt=0<-1,1,0.001>-Mod 4 Amount
slider125:m4_via=0<0,17,1>-Mod 4 Via
slider126:m5_src=0<0,17,1>-Mod 5 Source
slider127:m5_dst=0<0,40,1>-Mod 5 Destination
slider128:m5_amt=0<-1,1,0.001>-Mod 5 Amount
slider129:m5_via=0<0,17,1>-Mod 5 Via
slider130:m6_src=0<0,17,1>-Mod 6 Source
slider131:m6_dst=0<0,40,1>-Mod 6 Destination
slider132:m6_amt=0<-1,1,0.001>-Mod 6 Amount
