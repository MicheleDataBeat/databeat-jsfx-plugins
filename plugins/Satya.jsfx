  v[V_F1] = l1_a; v[V_F1 + 1] = l2_a; v[V_F1 + 2] = l3_a; v[V_F1 + 3] = l4_a;
  v[V_F1 + 4] = r1_a; v[V_F1 + 5] = r2_a; v[V_F1 + 6] = r3_a; v[V_F1 + 7] = r4_a;
  v[V_F2] = l1_b; v[V_F2 + 1] = l2_b; v[V_F2 + 2] = l3_b; v[V_F2 + 3] = l4_b;
  v[V_F2 + 4] = r1_b; v[V_F2 + 5] = r2_b; v[V_F2 + 6] = r3_b; v[V_F2 + 7] = r4_b;
  v[V_SUBPH] = subph; v[V_NZ1] = nzs1; v[V_NZ2] = nzs2;
  ghost ? ( v[V_FADE] = fadeval; fadeval <= 0 ? v[V_STATE] = 0; );
  // voice end: envelope 1 finished in release
  (!ghost) && st == 2 && v[V_ENV] == 0 ? v[V_STATE] = 0;
);

// ============================================================================
//  Parameter smoothing
// ============================================================================
function ps_init() local(i)
(
  i = 1; loop(206, PS[i] = slider(i); PSF[i] = 0; i += 1;);
  // continuous parameters get smoothed
  PSF[1] = 1; PSF[9] = 1; PSF[10] = 1;
  i = 13; loop(2, PSF[i] = 1; PSF[i + 2] = 1; PSF[i + 3] = 1; PSF[i + 4] = 1; PSF[i + 5] = 1; PSF[i + 6] = 1; PSF[i + 8] = 1; PSF[i + 9] = 1; PSF[i + 10] = 1; i += 15;);
  PSF[41] = 1; PSF[42] = 1; PSF[43] = 1; PSF[46] = 1; PSF[47] = 1;
  PSF[49] = 1; PSF[50] = 1; PSF[51] = 1; PSF[52] = 1; PSF[53] = 1;
  PSF[56] = 1; PSF[57] = 1; PSF[58] = 1; PSF[59] = 1; PSF[60] = 1; PSF[63] = 1;
  i = 64; loop(18, PSF[i] = 1; i += 1;);
  i = 82; loop(3, PSF[i + 1] = 1; PSF[i + 4] = 1; PSF[i + 5] = 1; i += 8;);
  i = 106; loop(4, PSF[i] = 1; i += 1;);
  i = 110; loop(12, PSF[i + 2] = 1; i += 4;);
  i = 158; loop(49, PSF[i] = 1; i += 1;);
  // discrete FX params: on/off, types, sync, division, ping-pong
  PSF[158] = 0; PSF[159] = 0; PSF[163] = 0; PSF[171] = 0; PSF[175] = 0; PSF[176] = 0;
  PSF[182] = 0; PSF[183] = 0; PSF[184] = 0; PSF[186] = 0; PSF[191] = 0; PSF[199] = 0; PSF[205] = 0;
);

function ps_step(n) local(i, c, s)
(
  c = 1 - exp(-n / (0.008 * srate));    // ~8 ms
  i = 1;
  loop(206,
    s = slider(i);
    PSF[i] ? ( PS[i] += c * (s - PS[i]); abs(s - PS[i]) < 0.00001 ? PS[i] = s; ) : PS[i] = s;
    i += 1;
  );
);

// ============================================================================
//  Global control step (mono LFOs, wheel smoothing)
// ============================================================================
wheel_s = 0; at_s = 0;
function global_control(n) local(k, rate, x, c)
(
  ps_step(n);
  c = 1 - exp(-n / (0.004 * srate));    // ~4 ms, independent of chunk length
  wheel_s += c * (wheel - wheel_s);
  at_s += c * (aftertouch - at_s);
  k = 0;
  loop(3,
    slider(88 + k * 8) == 1 ? (
      slider(84 + k * 8) && play_state & 1 ? (
        // host-locked phase
        rate = lfo_rate_hz(PS[83 + k * 8], 1, slider(85 + k * 8) | 0, DSTG[D_L1RATE + k]);
        x = frac(beat_position / (tempo / 60 / rate) + PS[86 + k * 8]);
        // a wrap (new cycle) draws the next sample-and-hold / random value
        x < LFOMONO[4 + k * 4] ? ( LFOMONO[7 + k * 4] = LFOMONO[6 + k * 4]; LFOMONO[6 + k * 4] = 2 * rnd01() - 1; );
        LFOMONO[4 + k * 4] = x;   // phase
        x = lfo_shape(slider(82 + k * 8) | 0, x, LFOMONO + 4 + k * 4);
      ) : (
        // free-running: the phase is integrated per chunk, so a rate change or rate modulation
        // sweeps the LFO instead of jumping it; the Phase knob offsets the read
        rate = lfo_rate_hz(PS[83 + k * 8], slider(84 + k * 8), slider(85 + k * 8) | 0, DSTG[D_L1RATE + k]);
        x = LFOMONO[4 + k * 4] + n * rate / srate;
        x >= 1 ? ( x -= floor(x); LFOMONO[7 + k * 4] = LFOMONO[6 + k * 4]; LFOMONO[6 + k * 4] = 2 * rnd01() - 1; );
        LFOMONO[4 + k * 4] = x;
        x = lfo_shape(slider(82 + k * 8) | 0, frac(x + PS[86 + k * 8]), LFOMONO + 4 + k * 4);
      );
      slider(89 + k * 8) ? x = 0.5 * (x + 1);
      LFOMONO[k] = x;
    );
    k += 1;
  );
);


// ============================================================================
//  Effects (global, stereo, run stage-major over the block buffer)
// ============================================================================
// memory layout inside FXMEM
DLY_N = 2097152;                      // max delay line: 21.8 s at 96 kHz, so 4/1 at 60 BPM (16 s) fits at every rate
DLY_L = FXMEM; DLY_R = DLY_L + DLY_N;
RV_N = 32768;                         // per reverb line (83.3 ms x size 2 at 192 kHz = 32,000 samples)
RV_BASE = DLY_R + DLY_N;              // 8 lines
RV_PRE = RV_BASE + 8 * RV_N;          // pre-delay line (RV_N)
RV_AP = RV_PRE + RV_N;                // 4 input diffusers x 1024
CHO_N = 8192;
CHO_L = RV_AP + 4 * 1024; CHO_R = CHO_L + CHO_N;
FX_END = CHO_R + CHO_N;

function fx_reset() local(i)
(
  memset(FXMEM, 0, FX_END - FXMEM);
  dly_w = 0; rv_w = 0; cho_w = 0;
  i = 0; loop(8, RVLEN[i] = 0; i += 1;);
  dly_tl = 0;
  eq_lz1 = eq_lz2 = eq_lz3 = eq_lz4 = 0; eq_mz1 = eq_mz2 = eq_mz3 = eq_mz4 = 0; eq_hz1 = eq_hz2 = eq_hz3 = eq_hz4 = 0;
  rv_lp0 = rv_lp1 = rv_lp2 = rv_lp3 = rv_lp4 = rv_lp5 = rv_lp6 = rv_lp7 = 0;
  cmp_env = 0; lim_env = 0;
  drv_dc0 = drv_dc1 = 0; drv_t0 = drv_t1 = 0;
  <?loop(ch=0;2, printf("dup%dx0 = dup%dz0 = dup%dx1 = dup%dz1 = dup%dx2 = dup%dz2 = dup%dx3 = dup%dz3 = dup%dx4 = dup%dz4 = dup%dx5 = dup%dz5 = 0;\n", ch, ch, ch, ch, ch, ch, ch, ch, ch, ch, ch, ch); ch += 1;)?>
  <?loop(ch=0;2, printf("ddn%dx0 = ddn%dz0 = ddn%dx1 = ddn%dz1 = ddn%dx2 = ddn%dz2 = ddn%dx3 = ddn%dz3 = ddn%dx4 = ddn%dz4 = ddn%dx5 = ddn%dz5 = 0;\n", ch, ch, ch, ch, ch, ch, ch, ch, ch, ch, ch, ch); ch += 1;)?>
  <?loop(ch=0;2, printf("up%dx0 = up%dz0 = up%dx1 = up%dz1 = up%dx2 = up%dz2 = up%dx3 = up%dz3 = up%dx4 = up%dz4 = up%dx5 = up%dz5 = 0;\n", ch, ch, ch, ch, ch, ch, ch, ch, ch, ch, ch, ch); ch += 1;)?>
  <?loop(ch=0;2, printf("dn%dx0 = dn%dz0 = dn%dx1 = dn%dz1 = dn%dx2 = dn%dz2 = dn%dx3 = dn%dz3 = dn%dx4 = dn%dz4 = dn%dx5 = dn%dz5 = 0;\n", ch, ch, ch, ch, ch, ch, ch, ch, ch, ch, ch, ch); ch += 1;)?>
  pha_lfo = 0; cho_lfo = 0; cho_lfo2 = 0; rv_lfo = 0;
  memset(PHS, 0, 32);
  rv_hp_l = rv_hp_r = 0; dly_lp_l = dly_lp_r = 0; dly_hp_l = dly_hp_r = 0; dc_l = dc_r = 0; lim_gr = 1; cmp_gr = 0;
);
RVLEN = alloc(8);
RVG = alloc(8);
PHS = alloc(32);       // phaser allpass states (8 stages x 2 ch)

// Kaiser-windowed half-band taps: h[j] = sinc(j/2)/2 * kaiser(j), j odd; h[0] = 0.5
// polyphase IIR half-band all-pass coefficients: branch 0 = HB0..HB2, branch 1 = HB3..HB5
HB0 = 0.1037552877; HB1 = 0.4073257231; HB2 = 0.6474462103;
HB3 = 0.3229718961; HB4 = 0.8807666735; HB5 = 0.4514438094;

// RBJ-style biquad coefficient helpers (cookbook formulas), stored into 5 consecutive slots
function eq_shelf(dest, hz, gain_db, high) local(A, w0, cw, sw, alpha, b0, b1, b2, a0, a1, a2, sqA)
(
  A = exp(gain_db * 0.05756462732485114);   // 10^(dB/40)
  w0 = TWOPI * clamp(hz, 10, 0.45 * srate) / srate; cw = cos(w0); sw = sin(w0);
  alpha = sw * 0.5 * sqrt(2);               // shelf slope 1
  sqA = 2 * sqrt(A) * alpha;
  high ? (
    b0 = A * ((A + 1) + (A - 1) * cw + sqA); b1 = -2 * A * ((A - 1) + (A + 1) * cw); b2 = A * ((A + 1) + (A - 1) * cw - sqA);
    a0 = (A + 1) - (A - 1) * cw + sqA; a1 = 2 * ((A - 1) - (A + 1) * cw); a2 = (A + 1) - (A - 1) * cw - sqA;
  ) : (
    b0 = A * ((A + 1) - (A - 1) * cw + sqA); b1 = 2 * A * ((A - 1) - (A + 1) * cw); b2 = A * ((A + 1) - (A - 1) * cw - sqA);
    a0 = (A + 1) + (A - 1) * cw + sqA; a1 = -2 * ((A - 1) + (A + 1) * cw); a2 = (A + 1) + (A - 1) * cw - sqA;
  );
  dest[0] = b0 / a0; dest[1] = b1 / a0; dest[2] = b2 / a0; dest[3] = a1 / a0; dest[4] = a2 / a0;
);
function eq_peak(dest, hz, gain_db, q) local(A, w0, cw, sw, alpha, a0)
(
  A = exp(gain_db * 0.05756462732485114);
  w0 = TWOPI * clamp(hz, 10, 0.45 * srate) / srate; cw = cos(w0); sw = sin(w0);
  alpha = sw / (2 * q);
  a0 = 1 + alpha / A;
  dest[0] = (1 + alpha * A) / a0; dest[1] = -2 * cw / a0; dest[2] = (1 - alpha * A) / a0;
  dest[3] = -2 * cw / a0; dest[4] = (1 - alpha / A) / a0;
);
EQC = alloc(16);   // 3 biquads x 5

function fx_init()
(
  fx_reset();
  fx_srate = srate;
);

// global-source matrix pass for FX destinations (per block); per-voice sources come from the newest voice
function run_matrix_global() local(i, s, d, m, x, via, v, best, bi)
(
  best = 0; bi = -1;
  i = 0; loop(NVOICE, v = voice_addr(i); v[V_STATE] == 1 && v[V_AGE] > best ? ( best = v[V_AGE]; bi = i; ); i += 1;);
  bi < 0 ? ( i = 0; loop(NVOICE, v = voice_addr(i); v[V_STATE] == 2 && v[V_AGE] > best ? ( best = v[V_AGE]; bi = i; ); i += 1;); );
  bi >= 0 ? (
    v = voice_addr(bi);
    SRCV[S_ENV1] = v[V_EOUT]; SRCV[S_ENV2] = v[V_EOUT + 1]; SRCV[S_ENV3] = v[V_EOUT + 2];
    SRCV[S_VEL] = v[V_VEL]; SRCV[S_KEY] = v[V_KEY]; SRCV[S_RAND] = v[V_RAND] * 2 - 1;
    SRCV[S_LFO1] = v[V_LFOV]; SRCV[S_LFO2] = v[V_LFOV + 1]; SRCV[S_LFO3] = v[V_LFOV + 2];
  ) : (
    SRCV[S_ENV1] = 0; SRCV[S_ENV2] = 0; SRCV[S_ENV3] = 0; SRCV[S_VEL] = 0; SRCV[S_KEY] = 0; SRCV[S_RAND] = 0;
    SRCV[S_LFO1] = 0; SRCV[S_LFO2] = 0; SRCV[S_LFO3] = 0;
  );
  i = 0; loop(3, slider(88 + i * 8) == 1 ? SRCV[S_LFO1 + i] = LFOMONO[i]; i += 1;);
  SRCV[S_WHEEL] = wheel_s; SRCV[S_AT] = at_s; SRCV[S_BEND] = bend;
  SRCV[S_MAC1] = PS[106]; SRCV[S_MAC2] = PS[107]; SRCV[S_MAC3] = PS[108]; SRCV[S_MAC4] = PS[109]; SRCV[S_ONE] = 1;
  memset(DSTG, 0, NDST);
  i = 0;
  loop(NMOD,
    m = 110 + i * 4;
    s = slider(m) | 0; d = slider(m + 1) | 0;
    s > 0 && ((d >= D_FXDRIVE && d <= D_FXPHA) || d == D_GLIDE || (d >= D_L1RATE && d <= D_L3RATE)) ? (
      x = SRCV[s] * PS[m + 2];
      via = slider(m + 3) | 0;
      via > 0 ? x *= SRCV[via];
      DSTG[d] += x;
    );
    i += 1;
  );
);
DSTG = alloc(NDST);
LFOGFX = alloc(8);      // @gfx scratch: allocated once here, never from the UI thread
MENUMAP = alloc(512);

function fx_process(pos, nblk)
local(dcb, i, l, r, x, y, t, g, amt, tone, mix, dtype, tl, tr, u0, u1, w0, w1, k, dc, gl, gr, apl0, apl1, apl2, apl3, rl0, rl1, rl2, rl3, rl4, rl5, rl6, rl7, rg0, rg1, rg2, rg3, rg4, rg5, rg6, rg7, pd, mask,
      lf, mf, mq, hf, c, z1, z2, z3, z4, o,
      rate, depth, ph, ph2, d1, d2, d3, wl, wr, rd, ri, fr, s0, s1, cn, mode, cmix,
      pfb, pcenter, pdepth, pmix, ap, apg, fmin, fmax, f, ap_l, ap_r, st, pl, pr,
      dly_t, dfb, dpp, dlp, dhp, dmix, tsec, beats, div, dl, dr, fbl, fbr, wl2, wr2, rl, rr,
      size, decay, damp, pre, lc, rmix, rmod, inl, inr, wet_l, wet_r, a0, a1, a2, a3, a4, a5, a6, a7, b0, b1, b2, b3, b4, b5, b6, b7,
      ln, rt60, gain, lpc, predelay, apc, xin, dif, m0, m1, ptr, hpc,
      thr, ratio, att, rel, mk, env, over, gr_db, cmp_g, ac, rc,
      ceil, lim_g, width, mid, side, mg, dryg, wetg)
(
  lim_g = 1; gr_db = 0;
  // ---------------------------------------------------------------- drive
  // 2x oversampled waveshaper. The half-band filters are polyphase IIR: two all-pass
  // branches of three first-order (in z^-2) sections each, coefficients designed
  // numerically (tools, 2026-09-05): stopband -58 dB, passband flat. Upsampling
  // interleaves the branch outputs; downsampling averages them. All state lives in
  // globals (drv_*), no memory shifting per sample.
  fx_drive_on ? (
    dtype = fx_drive_type | 0;
    amt = clamp(PS[160] + DSTG[D_FXDRIVE], 0, 1);
    g = exp(LN2 * amt * 5);                              // 0..30 dB
    tone = 800 * exp(LN2 * PS[161] * 4.6);
    c = 1 - exp(-TWOPI * tone / srate);
    mix = PS[162];
    dc = 1 - exp(-TWOPI * 8 / srate);
    gl = 1 / sqrt(g);              // small signals gain +3 dB per 6 dB of drive, loud ones do not collapse
    i = 0;
    loop(nblk,
      l = BUFL[pos + i]; r = BUFR[pos + i];
      <?loop(ch=0;2, printf("
      x = %s;
      // --- upsample: branch 0 -> even sample u0, branch 1 -> odd sample u1
      y = x;
      t = HB0 * (y - up%dz0) + up%dx0; up%dx0 = y; up%dz0 = t; y = t;
      t = HB1 * (y - up%dz1) + up%dx1; up%dx1 = y; up%dz1 = t; y = t;
      t = HB2 * (y - up%dz2) + up%dx2; up%dx2 = y; up%dz2 = t; u0 = t;
      y = x;
      t = HB3 * (y - up%dz3) + up%dx3; up%dx3 = y; up%dz3 = t; y = t;
      t = HB4 * (y - up%dz4) + up%dx4; up%dx4 = y; up%dz4 = t; y = t;
      t = HB5 * (y - up%dz5) + up%dx5; up%dx5 = y; up%dz5 = t; u1 = t;
      // --- shape both 2x samples
      x = u0 * g;
      w0 = dtype == 0 ? fast_tanh(x) : dtype == 1 ? clamp(x, -1, 1) : dtype == 2 ? ( x = (x + 1) * 0.25; x = x - floor(x); abs(x * 4 - 2) - 1 ) : fast_tanh(x + 0.35 * x * x * (x > 0 ? 1 : 0.3));
      x = u1 * g;
      w1 = dtype == 0 ? fast_tanh(x) : dtype == 1 ? clamp(x, -1, 1) : dtype == 2 ? ( x = (x + 1) * 0.25; x = x - floor(x); abs(x * 4 - 2) - 1 ) : fast_tanh(x + 0.35 * x * x * (x > 0 ? 1 : 0.3));
      // --- downsample: the branches swap phases relative to the interpolator (even sample
      //     through branch 1, odd through branch 0), which is what cancels the half-sample offset
      y = w0;
      t = HB3 * (y - dn%dz3) + dn%dx3; dn%dx3 = y; dn%dz3 = t; y = t;
      t = HB4 * (y - dn%dz4) + dn%dx4; dn%dx4 = y; dn%dz4 = t; y = t;
      t = HB5 * (y - dn%dz5) + dn%dx5; dn%dx5 = y; dn%dz5 = t; u0 = t;
      y = w1;
      t = HB0 * (y - dn%dz0) + dn%dx0; dn%dx0 = y; dn%dz0 = t; y = t;
      t = HB1 * (y - dn%dz1) + dn%dx1; dn%dx1 = y; dn%dz1 = t; y = t;
      t = HB2 * (y - dn%dz2) + dn%dx2; dn%dx2 = y; dn%dz2 = t; u1 = t;
      y = 0.5 * (u0 + u1);
      // --- tone and dc block
      drv_t%d += c * (y - drv_t%d); y = drv_t%d;
      drv_dc%d += dc * (y - drv_dc%d); y -= drv_dc%d;
      %s = y;
\n", ch == 0 ? "l" : "r", ch, ch, ch, ch, ch, ch, ch, ch, ch, ch, ch, ch, ch, ch, ch, ch, ch, ch, ch, ch, ch, ch, ch, ch, ch, ch, ch, ch, ch, ch, ch, ch, ch, ch, ch, ch, ch, ch, ch, ch, ch, ch, ch, ch, ch, ch, ch, ch, ch, ch, ch, ch, ch, ch, ch == 0 ? "tl" : "tr"); ch += 1;)?>
      <?loop(ch=0;2, printf("
      // --- dry path: the same 2x round trip without shaping, so dry and wet stay phase-aligned
      //     at every frequency (a fixed delay only matched the group delay at low frequencies)
      x = %s; y = x;
      t = HB0 * (y - dup%dz0) + dup%dx0; dup%dx0 = y; dup%dz0 = t; y = t;
      t = HB1 * (y - dup%dz1) + dup%dx1; dup%dx1 = y; dup%dz1 = t; y = t;
      t = HB2 * (y - dup%dz2) + dup%dx2; dup%dx2 = y; dup%dz2 = t; u0 = t;
      y = x;
      t = HB3 * (y - dup%dz3) + dup%dx3; dup%dx3 = y; dup%dz3 = t; y = t;
      t = HB4 * (y - dup%dz4) + dup%dx4; dup%dx4 = y; dup%dz4 = t; y = t;
      t = HB5 * (y - dup%dz5) + dup%dx5; dup%dx5 = y; dup%dz5 = t; u1 = t;
      y = u0;
      t = HB3 * (y - ddn%dz3) + ddn%dx3; ddn%dx3 = y; ddn%dz3 = t; y = t;
      t = HB4 * (y - ddn%dz4) + ddn%dx4; ddn%dx4 = y; ddn%dz4 = t; y = t;
      t = HB5 * (y - ddn%dz5) + ddn%dx5; ddn%dx5 = y; ddn%dz5 = t; u0 = t;
      y = u1;
      t = HB0 * (y - ddn%dz0) + ddn%dx0; ddn%dx0 = y; ddn%dz0 = t; y = t;
      t = HB1 * (y - ddn%dz1) + ddn%dx1; ddn%dx1 = y; ddn%dz1 = t; y = t;
      t = HB2 * (y - ddn%dz2) + ddn%dx2; ddn%dx2 = y; ddn%dz2 = t; u1 = t;
      %s = 0.5 * (u0 + u1);
\n", ch == 0 ? "l" : "r", ch, ch, ch, ch, ch, ch, ch, ch, ch, ch, ch, ch, ch, ch, ch, ch, ch, ch, ch, ch, ch, ch, ch, ch, ch, ch, ch, ch, ch, ch, ch, ch, ch, ch, ch, ch, ch, ch, ch, ch, ch, ch, ch, ch, ch, ch, ch, ch, ch == 0 ? "l" : "r"); ch += 1;)?>
      // --- dry/wet blend
      BUFL[pos + i] = l + mix * (tl * gl - l);
      BUFR[pos + i] = r + mix * (tr * gl - r);
      i += 1;
    );
  );
  // ---------------------------------------------------------------- EQ
  fx_eq_on ? (
    lf = 40 * exp(LN2 * PS[165] * 4);              // 40 .. 640 Hz
    mf = 200 * exp(LN2 * PS[167] * 5.3);           // 200 .. 8 kHz
    hf = 1500 * exp(LN2 * PS[170] * 3.4);          // 1.5 .. 16 kHz
    mq = 0.4 * exp(LN2 * PS[168] * 4);             // 0.4 .. 6.4
    eq_shelf(EQC, lf, PS[164], 0);
    eq_peak(EQC + 5, mf, PS[166], mq);
    eq_shelf(EQC + 10, hf, PS[169], 1);
    i = 0;
    loop(nblk,
      l = BUFL[pos + i]; r = BUFR[pos + i];
      // low shelf
      c = EQC;
      o = c[0] * l + eq_lz1; eq_lz1 = c[1] * l - c[3] * o + eq_lz2; eq_lz2 = c[2] * l - c[4] * o; l = o;
      o = c[0] * r + eq_lz3; eq_lz3 = c[1] * r - c[3] * o + eq_lz4; eq_lz4 = c[2] * r - c[4] * o; r = o;
      c = EQC + 5;
      o = c[0] * l + eq_mz1; eq_mz1 = c[1] * l - c[3] * o + eq_mz2; eq_mz2 = c[2] * l - c[4] * o; l = o;
      o = c[0] * r + eq_mz3; eq_mz3 = c[1] * r - c[3] * o + eq_mz4; eq_mz4 = c[2] * r - c[4] * o; r = o;
      c = EQC + 10;
      o = c[0] * l + eq_hz1; eq_hz1 = c[1] * l - c[3] * o + eq_hz2; eq_hz2 = c[2] * l - c[4] * o; l = o;
      o = c[0] * r + eq_hz3; eq_hz3 = c[1] * r - c[3] * o + eq_hz4; eq_hz4 = c[2] * r - c[4] * o; r = o;
      BUFL[pos + i] = l; BUFR[pos + i] = r;
      i += 1;
    );
  );
  // ---------------------------------------------------------------- chorus / ensemble
  fx_cho_on ? (
    mode = fx_cho_mode | 0;
    rate = 0.05 * exp(LN2 * PS[172] * 6.6);          // 0.05 .. 5 Hz
    depth = PS[173];
    cmix = clamp(PS[174] + DSTG[D_FXCHO], 0, 1);
    // equal-power dry/wet: 0 = dry, 1 = fully wet
    dryg = cos(cmix * $pi * 0.5); wetg = sin(cmix * $pi * 0.5);
    cn = 0.001 * srate;                              // 1 ms in samples
    i = 0;
    loop(nblk,
      l = BUFL[pos + i]; r = BUFR[pos + i];
      CHO_L[cho_w] = l; CHO_R[cho_w] = r;
      // phases are integrated per sample: a rate change sweeps the LFO instead of jumping its phase
      cho_lfo += rate / srate; cho_lfo >= 1 ? cho_lfo -= 1;
      cho_lfo2 += rate * 0.37 / srate; cho_lfo2 >= 1 ? cho_lfo2 -= 1;   // ensemble's slow second LFO
      mode == 0 ? (
        // classic: two voices, quadrature LFOs, 7..25 ms
        d1 = cn * (12 + depth * 8 * sin(TWOPI * cho_lfo));
        d2 = cn * (12 + depth * 8 * sin(TWOPI * cho_lfo + 1.5708));
        rd = cho_w - d1; rd < 0 ? rd += CHO_N; ri = rd | 0; fr = rd - ri;
        s0 = CHO_L[ri]; wl = s0 + fr * (CHO_L[(ri + 1) & (CHO_N - 1)] - s0);
        rd = cho_w - d2; rd < 0 ? rd += CHO_N; ri = rd | 0; fr = rd - ri;
        s0 = CHO_R[ri]; wr = s0 + fr * (CHO_R[(ri + 1) & (CHO_N - 1)] - s0);
        BUFL[pos + i] = l * dryg + wl * wetg;
        BUFR[pos + i] = r * dryg + wr * wetg;
      ) : (
        // ensemble: three taps per side at 120 degrees, fast+slow modulation, cross-mixed
        ph = TWOPI * cho_lfo; ph2 = TWOPI * cho_lfo2;
        d1 = cn * (10 + depth * (3 * sin(ph) + 4 * sin(ph2)));
        d2 = cn * (10 + depth * (3 * sin(ph + 2.0944) + 4 * sin(ph2 + 2.0944)));
        d3 = cn * (10 + depth * (3 * sin(ph + 4.1888) + 4 * sin(ph2 + 4.1888)));
        rd = cho_w - d1; rd < 0 ? rd += CHO_N; ri = rd | 0; fr = rd - ri;
        s0 = CHO_L[ri]; wl = s0 + fr * (CHO_L[(ri + 1) & (CHO_N - 1)] - s0);
        rd = cho_w - d2; rd < 0 ? rd += CHO_N; ri = rd | 0; fr = rd - ri;
        s0 = CHO_R[ri]; wr = s0 + fr * (CHO_R[(ri + 1) & (CHO_N - 1)] - s0);
        rd = cho_w - d3; rd < 0 ? rd += CHO_N; ri = rd | 0; fr = rd - ri;
        s0 = CHO_L[ri]; s1 = s0 + fr * (CHO_L[(ri + 1) & (CHO_N - 1)] - s0);
        s0 = CHO_R[ri]; s1 = 0.5 * (s1 + s0 + fr * (CHO_R[(ri + 1) & (CHO_N - 1)] - s0));
        BUFL[pos + i] = l * dryg + (0.7 * wl + 0.5 * s1) * wetg;
        BUFR[pos + i] = r * dryg + (0.7 * wr + 0.5 * s1) * wetg;
      );
      cho_w = (cho_w + 1) & (CHO_N - 1);
      i += 1;
    );
  );
  // ---------------------------------------------------------------- phaser (6 first-order allpass stages, TPT)
  fx_pha_on ? (
    rate = 0.02 * exp(LN2 * PS[177] * 8);            // 0.02 .. 5 Hz
    pdepth = PS[178]; pfb = PS[179] * 0.9; pmix = clamp(PS[181] + DSTG[D_FXPHA], 0, 1);
    pcenter = 200 * exp(LN2 * PS[180] * 5);          // 200 .. 6400 Hz centre
    i = 0;
    loop(nblk,
      l = BUFL[pos + i]; r = BUFR[pos + i];
      pha_lfo += rate / srate; pha_lfo >= 1 ? pha_lfo -= 1;
      // triangle-ish sweep in octaves, L and R offset by a quarter cycle
      f = pcenter * exp(LN2 * pdepth * 2 * sin(TWOPI * pha_lfo));
      apg = tan($pi * clamp(f, 30, 0.45 * srate) / srate); apc = (apg - 1) / (apg + 1);
      f = pcenter * exp(LN2 * pdepth * 2 * sin(TWOPI * pha_lfo + 1.2));
      apg = tan($pi * clamp(f, 30, 0.45 * srate) / srate); ap = (apg - 1) / (apg + 1);
      xin = l + pfb * PHS[16];
      k = 0; loop(6, st = PHS + k; y = apc * xin + st[0]; st[0] = xin - apc * y; xin = y; k += 1;);
      PHS[16] = xin;
      BUFL[pos + i] = l * (1 - 0.5 * pmix) + 0.5 * pmix * xin;
      xin = r + pfb * PHS[17];
      k = 8; loop(6, st = PHS + k; y = ap * xin + st[0]; st[0] = xin - ap * y; xin = y; k += 1;);
      PHS[17] = xin;
      BUFR[pos + i] = r * (1 - 0.5 * pmix) + 0.5 * pmix * xin;
      i += 1;
    );
  );
  // ---------------------------------------------------------------- delay
  fx_dly_on ? (
    fx_dly_sync ? (
      beats = div_beats(fx_dly_time | 0);
      tsec = beats * 60 / max(tempo, 20);
    ) : (
      tsec = 0.001 * exp(log(2000) * PS[190]);       // 1 ms .. 2 s
    );
    dly_t = clamp(tsec * srate, 1, DLY_N - 4);
    dfb = clamp(PS[185] + DSTG[D_FXDLYFB], 0, 1.05) * 0.95;
    dpp = fx_dly_pp;
    dlp = 1 - exp(-TWOPI * 400 * exp(LN2 * PS[187] * 5.6) / srate);   // 400 Hz .. 20 kHz one-pole
    dhp = 1 - exp(-TWOPI * 20 * exp(LN2 * PS[188] * 5.3) / srate);    // 20 .. 800 Hz
    dmix = clamp(PS[189] + DSTG[D_FXDLY], 0, 1);
    dryg = cos(dmix * $pi * 0.5); wetg = sin(dmix * $pi * 0.5);
    // smooth time changes (~80 ms) so automation glides instead of clicking
    c = 1 - exp(-1 / (0.08 * srate));
    dly_tl == 0 ? dly_tl = dly_t;
    i = 0;
    loop(nblk,
      dly_tl += c * (dly_t - dly_tl);
      l = BUFL[pos + i]; r = BUFR[pos + i];
      rd = dly_w - dly_tl; rd < 0 ? rd += DLY_N; ri = rd | 0; fr = rd - ri;
      s0 = DLY_L[ri]; dl = s0 + fr * (DLY_L[(ri + 1) & (DLY_N - 1)] - s0);
      s0 = DLY_R[ri]; dr = s0 + fr * (DLY_R[(ri + 1) & (DLY_N - 1)] - s0);
      // feedback tone: lowpass then highpass, in the loop
      dly_lp_l += dlp * (dl - dly_lp_l); dly_lp_r += dlp * (dr - dly_lp_r);
      dly_hp_l += dhp * (dly_lp_l - dly_hp_l); dly_hp_r += dhp * (dly_lp_r - dly_hp_r);
      fbl = dly_lp_l - dly_hp_l; fbr = dly_lp_r - dly_hp_r;
      dpp ? (
        DLY_L[dly_w] = 0.5 * (l + r) + dfb * fbr;
        DLY_R[dly_w] = dfb * fbl;
      ) : (
        DLY_L[dly_w] = l + dfb * fbl;
        DLY_R[dly_w] = r + dfb * fbr;
      );
      dly_w = (dly_w + 1) & (DLY_N - 1);
      BUFL[pos + i] = l * dryg + dl * wetg;
      BUFR[pos + i] = r * dryg + dr * wetg;
      i += 1;
    );
  );
  // ---------------------------------------------------------------- reverb (8-line FDN, Hadamard feedback)
  fx_rev_on ? (
    size = 0.5 + PS[192] * 1.5;                       // 0.5 .. 2 x base lengths
    rt60 = 0.3 * exp(log(60) * PS[193]);             // 0.3 .. 18 s
    damp = 1 - exp(-TWOPI * 1500 * exp(LN2 * (1 - PS[194]) * 3.5) / srate);  // damping one-pole 1.5 .. 17 kHz
    predelay = clamp(PS[195] * 0.12 * srate, 1, RV_N - 4);
    hpc = 1 - exp(-TWOPI * 20 * exp(LN2 * PS[196] * 4.3) / srate);          // 20 .. 400 Hz low cut
    rmix = clamp(PS[197] + DSTG[D_FXREV], 0, 1);
    dryg = cos(rmix * $pi * 0.5); wetg = sin(rmix * $pi * 0.5) * 0.25;
    rmod = PS[198];
    // line lengths (ms) and per-line gains for the decay time
    k = 0;
    loop(8,
      ln = (k == 0 ? 29.7 : k == 1 ? 37.1 : k == 2 ? 41.1 : k == 3 ? 47.3 : k == 4 ? 53.9 : k == 5 ? 61.3 : k == 6 ? 71.9 : 83.3) * 0.001 * srate * size;
      ln = clamp(ln, 16, RV_N - 64);
      RVLEN[k] = ln;
      RVG[k] = exp(-6.907755 * ln / (rt60 * srate));
      k += 1;
    );
    apl0 = clamp((4.7 * 0.001 * srate * 0.5 * (size + 0.5)) | 0, 4, 1000);
    apl1 = clamp((3.1 * 0.001 * srate * 0.5 * (size + 0.5)) | 0, 4, 1000);
    apl2 = clamp((6.9 * 0.001 * srate * 0.5 * (size + 0.5)) | 0, 4, 1000);
    apl3 = clamp((8.7 * 0.001 * srate * 0.5 * (size + 0.5)) | 0, 4, 1000);
    rl0 = RVLEN[0]; rl1 = RVLEN[1]; rl2 = RVLEN[2]; rl3 = RVLEN[3]; rl4 = RVLEN[4]; rl5 = RVLEN[5]; rl6 = RVLEN[6]; rl7 = RVLEN[7];
    rg0 = RVG[0]; rg1 = RVG[1]; rg2 = RVG[2]; rg3 = RVG[3]; rg4 = RVG[4]; rg5 = RVG[5]; rg6 = RVG[6]; rg7 = RVG[7];
    pd = predelay | 0; mask = RV_N - 1;
    i = 0;
    loop(nblk,
      l = BUFL[pos + i]; r = BUFR[pos + i];
      // input: low cut, pre-delay, 4 stages of diffusion (allpass, 1..8 ms)
      rv_hp_l += hpc * (l - rv_hp_l); rv_hp_r += hpc * (r - rv_hp_r);
      inl = l - rv_hp_l; inr = r - rv_hp_r;
      RV_PRE[rv_w & mask] = 0.5 * (inl + inr);
      xin = RV_PRE[(rv_w - pd) & mask];
      s0 = RV_AP[(rv_w - apl0) & 1023]; dif = xin + 0.62 * s0; RV_AP[rv_w & 1023] = dif; xin = s0 - 0.62 * dif;
      ptr = RV_AP + 1024; s0 = ptr[(rv_w - apl1) & 1023]; dif = xin + 0.62 * s0; ptr[rv_w & 1023] = dif; xin = s0 - 0.62 * dif;
      ptr = RV_AP + 2048; s0 = ptr[(rv_w - apl2) & 1023]; dif = xin + 0.62 * s0; ptr[rv_w & 1023] = dif; xin = s0 - 0.62 * dif;
      ptr = RV_AP + 3072; s0 = ptr[(rv_w - apl3) & 1023]; dif = xin + 0.62 * s0; ptr[rv_w & 1023] = dif; xin = s0 - 0.62 * dif;
      // slow modulation of two line read positions, for a smoother tail
      rv_lfo += 0.31 / srate; rv_lfo >= 1 ? rv_lfo -= 1;
      m0 = rmod * 12 * sin(TWOPI * rv_lfo); m1 = rmod * 12 * cos(TWOPI * rv_lfo * 1.13);
      // read the 8 lines (linear interpolation on the modulated ones)
      ptr = RV_BASE;
      rd = rv_w - rl0 + m0; ri = rd | 0; fr = rd - ri; s0 = ptr[ri & mask]; a0 = s0 + fr * (ptr[(ri + 1) & mask] - s0);
      ptr += RV_N; a1 = ptr[(rv_w - rl1) & mask];
      ptr += RV_N; a2 = ptr[(rv_w - rl2) & mask];
      ptr += RV_N; rd = rv_w - rl3 + m1; ri = rd | 0; fr = rd - ri; s0 = ptr[ri & mask]; a3 = s0 + fr * (ptr[(ri + 1) & mask] - s0);
      ptr += RV_N; a4 = ptr[(rv_w - rl4) & mask];
      ptr += RV_N; a5 = ptr[(rv_w - rl5) & mask];
      ptr += RV_N; a6 = ptr[(rv_w - rl6) & mask];
      ptr += RV_N; a7 = ptr[(rv_w - rl7) & mask];
      // damping (one-pole lowpass per line) and decay gain
      rv_lp0 += damp * (a0 - rv_lp0); a0 = rv_lp0 * rg0;
      rv_lp1 += damp * (a1 - rv_lp1); a1 = rv_lp1 * rg1;
      rv_lp2 += damp * (a2 - rv_lp2); a2 = rv_lp2 * rg2;
      rv_lp3 += damp * (a3 - rv_lp3); a3 = rv_lp3 * rg3;
      rv_lp4 += damp * (a4 - rv_lp4); a4 = rv_lp4 * rg4;
      rv_lp5 += damp * (a5 - rv_lp5); a5 = rv_lp5 * rg5;
      rv_lp6 += damp * (a6 - rv_lp6); a6 = rv_lp6 * rg6;
      rv_lp7 += damp * (a7 - rv_lp7); a7 = rv_lp7 * rg7;
      // stereo output taps before mixing (alternating signs give a decorrelated pair)
      wet_l = a0 - a1 + a2 - a3 + a4 - a5 + a6 - a7;
      wet_r = a0 + a1 - a2 - a3 + a4 + a5 - a6 - a7;
      // Hadamard 8x8 (butterflies), scaled by 1/sqrt(8)
      b0 = a0 + a1; b1 = a0 - a1; b2 = a2 + a3; b3 = a2 - a3; b4 = a4 + a5; b5 = a4 - a5; b6 = a6 + a7; b7 = a6 - a7;
      a0 = b0 + b2; a1 = b1 + b3; a2 = b0 - b2; a3 = b1 - b3; a4 = b4 + b6; a5 = b5 + b7; a6 = b4 - b6; a7 = b5 - b7;
      b0 = (a0 + a4) * 0.35355339; b1 = (a1 + a5) * 0.35355339; b2 = (a2 + a6) * 0.35355339; b3 = (a3 + a7) * 0.35355339;
      b4 = (a0 - a4) * 0.35355339; b5 = (a1 - a5) * 0.35355339; b6 = (a2 - a6) * 0.35355339; b7 = (a3 - a7) * 0.35355339;
      // write back with the diffused input injected on every line
      k = rv_w & mask;
      ptr = RV_BASE; ptr[k] = b0 + xin;
      ptr += RV_N; ptr[k] = b1 + xin;
      ptr += RV_N; ptr[k] = b2 - xin;
      ptr += RV_N; ptr[k] = b3 + xin;
      ptr += RV_N; ptr[k] = b4 - xin;
      ptr += RV_N; ptr[k] = b5 + xin;
      ptr += RV_N; ptr[k] = b6 + xin;
      ptr += RV_N; ptr[k] = b7 - xin;
      rv_w += 1;
      BUFL[pos + i] = l * dryg + wet_l * wetg;
      BUFR[pos + i] = r * dryg + wet_r * wetg;
      i += 1;
    );
  );
  // ---------------------------------------------------------------- compressor (peak, soft knee, stereo linked)
  fx_cmp_on ? (
    thr = PS[200];
    ratio = 1 + PS[201] * PS[201] * 19;                  // 1 .. 20
    att = 1 - exp(-1 / (knob_time(PS[202], 0.0002, 0.1) * srate));
    rel = 1 - exp(-1 / (knob_time(PS[203], 0.02, 2) * srate));
    mk = db2lin(PS[204]);
    i = 0;
    loop(nblk,
      l = BUFL[pos + i]; r = BUFR[pos + i];
      x = max(abs(l), abs(r));
      x > cmp_env ? cmp_env += att * (x - cmp_env) : cmp_env += rel * (x - cmp_env);
      over = 20 * log10(max(cmp_env, 0.000001)) - thr;
      // 6 dB soft knee
      gr_db = over <= -3 ? 0 : over >= 3 ? over * (1 - 1 / ratio) : (over + 3) * (over + 3) / 12 * (1 - 1 / ratio);
      cmp_g = exp(-gr_db * 0.11512925464970229) * mk;
      BUFL[pos + i] = l * cmp_g; BUFR[pos + i] = r * cmp_g;
      i += 1;
    );
    cmp_gr = gr_db;
  ) : cmp_gr = 0;
  // ---------------------------------------------------------------- width + master + limiter
  width = PS[10];
  mg = db2lin(PS[1]);
  dcb = 1 - exp(-TWOPI * 8 / srate);
  ceil = db2lin(PS[206]);
  rc = exp(-1 / (0.08 * srate));
  i = 0;
  loop(nblk,
    l = BUFL[pos + i]; r = BUFR[pos + i];
    width != 1 ? ( mid = 0.5 * (l + r); side = 0.5 * (l - r) * width; l = mid + side; r = mid - side; );
    l *= mg; r *= mg;
    // 8 Hz DC blocker: asymmetric warps, folding and ring modulation can carry a mean
    dc_l += dcb * (l - dc_l); l -= dc_l;
    dc_r += dcb * (r - dc_r); r -= dc_r;
    fx_lim_on ? (
      // peak-hold envelope with instant attack and ~80 ms release: gain never lets a peak past the ceiling
      x = max(abs(l), abs(r));
      lim_env = max(x, lim_env * rc);
      lim_g = lim_env > ceil ? ceil / lim_env : 1;
      lim_g < lim_gmin ? lim_gmin = lim_g;
      l *= lim_g; r *= lim_g;
    );
    BUFL[pos + i] = l; BUFR[pos + i] = r;
    i += 1;
  );
);


// ============================================================================
//  Presets
//  Each preset is one string of "index=value" pairs for the sliders that differ
//  from the defaults (see preset_defaults). Strings live in the numbered string
//  slots: name in PSTR_NAME+i, category in PSTR_CAT+i, data in PSTR_DATA+i.
// ============================================================================
PSTR_NAME = 0; PSTR_CAT = 300; PSTR_DATA = 600;
NPRESET = 0;
DEFAULTS = alloc(256);
SMIN = alloc(256); SMAX = alloc(256); SSTEP = alloc(256); SDEF = alloc(256);

function preset_defaults() local(i)
(
  i = 1; loop(206, DEFAULTS[i] = SDEF[i]; i += 1;);   // header defaults, not whatever the host restored
);

function preset_add(name, cat, data)
(
  NPRESET < 300 ? (
    strcpy(PSTR_NAME + NPRESET, name);
    strcpy(PSTR_CAT + NPRESET, cat);
    strcpy(PSTR_DATA + NPRESET, data);
    NPRESET += 1;
  );
);

// parse "12=0.5 13=3 ..." into the sliders (after resetting every slider to its default)
function preset_load(idx) local(str, n, i, ch, state, num, sign, frac, scale, key)
(
  idx >= 0 && idx < NPRESET ? (
    i = 1; loop(206, slider(i) = DEFAULTS[i]; i += 1;);
    str = PSTR_DATA + idx;
    n = strlen(str);
    i = 0; state = 0; key = 0; num = 0; sign = 1; frac = 0; scale = 1;
    while (i <= n) (
      ch = i < n ? str_getchar(str, i) : 32;
      ch == $'=' ? ( key = num * sign; num = 0; sign = 1; frac = 0; scale = 1; state = 1; )
      : ch == $'-' ? sign = -1
      : ch == $'.' ? frac = 1
      : (ch >= $'0' && ch <= $'9') ? ( frac ? ( scale *= 0.1; num += (ch - $'0') * scale; ) : num = num * 10 + (ch - $'0'); )
      : (ch == 32 || ch == 10 || ch == 13 || ch == 9 || ch == $',') ? (
        state == 1 && key >= 1 && key <= 206 ? slider(key) = num * sign;
        num = 0; sign = 1; frac = 0; scale = 1; state = 0;
      );
      i += 1;
    );
    preset_idx = idx;
    sliderchange(-1);
    i = 1; loop(206, PS[i] = slider(i); i += 1;);   // snap smoothing to the new values
    all_notes_off();
    preset_dirty = 0;   // last: if the host re-enters @slider from sliderchange, the flag it sets is cleared
    1
  ) : 0;
);


// ============================================================================
//  Init
// ============================================================================
last_pitch = 60; last_pitch_valid = 0;
// preset_idx is not reset here: @init re-runs on a sample-rate change and the loaded preset stays loaded
memset(VOICE, 0, NSLOT * VSTRIDE);
memset(LFOMONO, 0, 16);
tables_ready != 1 ? build_wavetables();   // @init re-runs on a sample-rate change; the tables do not depend on it
ps_init();
SINTBL = frame_addr(0, 0, 0);   // unit sine, used as the formant window
fx_init();
preset_dirty = 0;
// ---- slider ranges (generated by tools/build.py between the markers)
//@RANGES_BEGIN
SMIN[1] = -60; SMAX[1] = 12; SSTEP[1] = 0.1; SDEF[1] = 0;
SMIN[2] = 0; SMAX[2] = 1; SSTEP[2] = 0.01; SDEF[2] = 0;
SMIN[3] = 0; SMAX[3] = 2; SSTEP[3] = 1; SDEF[3] = 0;
SMIN[4] = 0; SMAX[4] = 1; SSTEP[4] = 0.001; SDEF[4] = 0;
SMIN[5] = 0; SMAX[5] = 1; SSTEP[5] = 1; SDEF[5] = 0;
SMIN[6] = 0; SMAX[6] = 24; SSTEP[6] = 1; SDEF[6] = 2;
SMIN[7] = 1; SMAX[7] = 16; SSTEP[7] = 1; SDEF[7] = 16;
SMIN[8] = -1; SMAX[8] = 1; SSTEP[8] = 0.01; SDEF[8] = 0;
SMIN[9] = 0; SMAX[9] = 1; SSTEP[9] = 0.01; SDEF[9] = 0;
SMIN[10] = 0; SMAX[10] = 2; SSTEP[10] = 0.01; SDEF[10] = 1;
SMIN[11] = 0; SMAX[11] = 1; SSTEP[11] = 1; SDEF[11] = 1;
SMIN[12] = 0; SMAX[12] = 15; SSTEP[12] = 1; SDEF[12] = 0;
SMIN[13] = 0; SMAX[13] = 1; SSTEP[13] = 0.001; SDEF[13] = 0.4;
SMIN[14] = 0; SMAX[14] = 5; SSTEP[14] = 1; SDEF[14] = 0;
SMIN[15] = 0; SMAX[15] = 1; SSTEP[15] = 0.001; SDEF[15] = 0;
SMIN[16] = -36; SMAX[16] = 36; SSTEP[16] = 1; SDEF[16] = 0;
SMIN[17] = -100; SMAX[17] = 100; SSTEP[17] = 0.1; SDEF[17] = 0;
SMIN[18] = -60; SMAX[18] = 12; SSTEP[18] = 0.1; SDEF[18] = -6;
SMIN[19] = -1; SMAX[19] = 1; SSTEP[19] = 0.01; SDEF[19] = 0;
SMIN[20] = 1; SMAX[20] = 8; SSTEP[20] = 1; SDEF[20] = 1;
SMIN[21] = 0; SMAX[21] = 1; SSTEP[21] = 0.001; SDEF[21] = 0.25;
SMIN[22] = 0; SMAX[22] = 1; SSTEP[22] = 0.001; SDEF[22] = 0.5;
SMIN[23] = 0; SMAX[23] = 1; SSTEP[23] = 0.001; SDEF[23] = 0.7;
SMIN[24] = 0; SMAX[24] = 1; SSTEP[24] = 1; SDEF[24] = 0;
SMIN[25] = 0; SMAX[25] = 1; SSTEP[25] = 1; SDEF[25] = 1;
SMIN[26] = 0; SMAX[26] = 1; SSTEP[26] = 1; SDEF[26] = 0;
