slider188:fx_dly_hp=0.2<0,1,0.001>-Delay Low Cut
slider189:fx_dly_mix=0.3<0,1,0.001>-Delay Mix
slider190:fx_dly_ms=0.4<0,1,0.001>-Delay Time (free)
slider191:fx_rev_on=0<0,1,1>-Reverb On
slider192:fx_rev_size=0.5<0,1,0.001>-Reverb Size
slider193:fx_rev_decay=0.5<0,1,0.001>-Reverb Decay
slider194:fx_rev_damp=0.5<0,1,0.001>-Reverb Damping
slider195:fx_rev_pre=0.1<0,1,0.001>-Reverb Pre-delay
slider196:fx_rev_lc=0.2<0,1,0.001>-Reverb Low Cut
slider197:fx_rev_mix=0.3<0,1,0.001>-Reverb Mix
