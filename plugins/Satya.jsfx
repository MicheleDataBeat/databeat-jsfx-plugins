slider184:fx_dly_time=9<0,12,1{4/1,2/1,1/1,1/2,1/2.,1/4,1/4.,1/4T,1/8,1/8.,1/8T,1/16,1/32}>-Delay Time
slider185:fx_dly_fb=0.4<0,1,0.001>-Delay Feedback
