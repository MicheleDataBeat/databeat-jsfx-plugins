// ---------------------------------------------------------------- effects
slider158:fx_drive_on=0<0,1,1>-Drive On
slider159:fx_drive_type=0<0,3,1{Soft,Hard,Fold,Tube}>-Drive Type
slider160:fx_drive_amt=0.2<0,1,0.001>-Drive Amount
slider161:fx_drive_tone=0.5<0,1,0.001>-Drive Tone
slider162:fx_drive_mix=1<0,1,0.001>-Drive Mix
slider163:fx_eq_on=0<0,1,1>-EQ On
slider164:fx_eq_lg=0<-18,18,0.1>-EQ Low Gain
slider165:fx_eq_lf=0.25<0,1,0.001>-EQ Low Freq
slider166:fx_eq_mg=0<-18,18,0.1>-EQ Mid Gain
slider167:fx_eq_mf=0.5<0,1,0.001>-EQ Mid Freq
slider168:fx_eq_mq=0.5<0,1,0.001>-EQ Mid Q
slider169:fx_eq_hg=0<-18,18,0.1>-EQ High Gain
slider170:fx_eq_hf=0.75<0,1,0.001>-EQ High Freq
slider171:fx_cho_on=0<0,1,1>-Chorus On
slider172:fx_cho_rate=0.3<0,1,0.001>-Chorus Rate
slider173:fx_cho_depth=0.5<0,1,0.001>-Chorus Depth
slider174:fx_cho_mix=0.5<0,1,0.001>-Chorus Mix
