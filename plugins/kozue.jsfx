last_patch=patch;last_bank=bank;instance_ready=1;

@gfx 1100 690
// KOZUE user interface. Design units are the original 1100x690 layout; everything is drawn
// through ui_s (1 on plain displays, 2 on Retina via gfx_ext_retina) so lines and text stay
// crisp. Control positions, hit areas, drag law and the ui_patch_request handshake are the
// original ones. No variable written here is read by the audio sections except the sliders,
// ui_patch_request and the peak_meter decay, exactly as before.
gfx_ext_retina < 1 ? gfx_ext_retina = 1;
ui_s = gfx_ext_retina > 1 ? gfx_ext_retina : 1;
ui_mx = mouse_x / ui_s; ui_my = mouse_y / ui_s;
gfx_clear = -1;

// ---------- palette ----------
function col_bg() ( gfx_set(0.071,0.078,0.090,1); );
function col_bar() ( gfx_set(0.047,0.053,0.063,1); );
function col_panel() ( gfx_set(0.106,0.117,0.133,1); );
function col_panel_top() ( gfx_set(0.125,0.137,0.155,1); );
function col_edge() ( gfx_set(0.196,0.216,0.243,1); );
function col_edge_hi() ( gfx_set(0.30,0.33,0.37,1); );
function col_well() ( gfx_set(0.040,0.045,0.053,1); );
function col_text() ( gfx_set(0.90,0.92,0.94,1); );
function col_dim() ( gfx_set(0.55,0.59,0.65,1); );
function col_faint() ( gfx_set(0.36,0.40,0.45,1); );
function col_accent() ( gfx_set(0.24,0.58,0.98,1); );
function col_accent_dim() ( gfx_set(0.18,0.36,0.58,1); );
function col_on() ( gfx_set(0.22,0.78,0.52,1); );
function col_on_dim() ( gfx_set(0.10,0.30,0.20,1); );

// ---------- scaled primitives ----------
function ui_font(sz flags) ( gfx_setfont(1,"Helvetica Neue",floor(sz*ui_s+0.5),flags); );
function ui_rect(x y w h) ( gfx_rect(x*ui_s,y*ui_s,w*ui_s,h*ui_s,1); );
function ui_frame(x y w h) local(t) ( t=max(1,floor(ui_s)); gfx_rect(x*ui_s,y*ui_s,w*ui_s,t,1); gfx_rect(x*ui_s,(y+h)*ui_s-t,w*ui_s,t,1); gfx_rect(x*ui_s,y*ui_s,t,h*ui_s,1); gfx_rect((x+w)*ui_s-t,y*ui_s,t,h*ui_s,1); );
function ui_line(x1 y1 x2 y2) ( gfx_line(x1*ui_s,y1*ui_s,x2*ui_s,y2*ui_s,1); );
function ui_circle(x y r fill) ( gfx_circle(x*ui_s,y*ui_s,r*ui_s,fill,1); );
function ui_arc(x y r a1 a2) ( gfx_arc(x*ui_s,y*ui_s,r*ui_s,a1,a2,1); );
function ui_ring(x y r a1 a2 w) local(k) ( k=0; while(k<w*ui_s) ( gfx_arc(x*ui_s,y*ui_s,r*ui_s-k,a1,a2,1); k+=1; ); );
function ui_rrect(x y w h r) (
  gfx_rect((x+r)*ui_s,y*ui_s,(w-2*r)*ui_s,h*ui_s,1);
  gfx_rect(x*ui_s,(y+r)*ui_s,w*ui_s,(h-2*r)*ui_s,1);
  gfx_circle((x+r)*ui_s,(y+r)*ui_s,r*ui_s,1,1); gfx_circle((x+w-r)*ui_s,(y+r)*ui_s,r*ui_s,1,1);
  gfx_circle((x+r)*ui_s,(y+h-r)*ui_s,r*ui_s,1,1); gfx_circle((x+w-r)*ui_s,(y+h-r)*ui_s,r*ui_s,1,1);
);
function ui_rrect_edge(x y w h r) ( gfx_roundrect(x*ui_s,y*ui_s,w*ui_s-1,h*ui_s-1,r*ui_s,1); );
function ui_text(x y s) ( gfx_x=x*ui_s; gfx_y=y*ui_s; gfx_drawstr(s); );
function ui_text_box(x y w h s flags) ( gfx_x=x*ui_s; gfx_y=y*ui_s; gfx_drawstr(s,flags,(x+w)*ui_s,(y+h)*ui_s); );
function hit(x y w h) ( ui_mx>=x && ui_mx<=x+w && ui_my>=y && ui_my<=y+h; );

// ---------- value formatting (display only) ----------
function set_val_text(sl v) (
  sl==2 ? sprintf(#val,"%.0f %%",v*100)
  : sl==3 || sl==7 || sl==12 ? sprintf(#val,"%+.0f ct",v)
  : sl==5 || sl==10 ? sprintf(#val,"%+.0f oct",v)
  : sl==6 || sl==11 ? sprintf(#val,"%+.0f st",v)
  : sl==17 ? (v>=1000 ? sprintf(#val,"%.2f kHz",v/1000) : sprintf(#val,"%.0f Hz",v))
  : sl==19 || sl==35 || sl==38 || sl==41 || sl==44 || sl==52 ? sprintf(#val,"%+.0f %%",v*100)
  : sl==21 || sl==22 || sl==24 || sl==25 || sl==26 || sl==28 ? (v<1 ? sprintf(#val,"%.0f ms",v*1000) : sprintf(#val,"%.2f s",v))
  : sl==29 || sl==31 || sl==46 || sl==50 ? sprintf(#val,"%.2f Hz",v)
  : sl==55 || sl==66 ? sprintf(#val,"%.0f ms",v)
  : sl==65 ? sprintf(#val,"%.1f ms",v)
  : sl==63 || sl==68 ? sprintf(#val,"%.1f dB",v)
  : sl==64 ? sprintf(#val,"%.1f : 1",v)
  : sprintf(#val,"%.0f %%",v*100);
);

// ---------- widgets (same signatures, hit areas and edit law as the original) ----------
function panel(x y w h name) (
  col_panel(); ui_rrect(x,y,w,h,5);
  col_panel_top(); ui_rrect(x,y,w,30,5); ui_rect(x,y+22,w,8);
  col_edge(); ui_rrect_edge(x,y,w,h,5);
  col_accent_dim(); ui_rect(x+10,y+29,w-20,1);
  col_dim(); ui_font(11,'b'); ui_text(x+11,y+9,name);
);

function knob(sl x y r name lo hi) local(v n ang ax ay pressed nv hov a0 a1) (
  v=slider(sl); n=clamp((v-lo)/(hi-lo),0,1);
  pressed=(mouse_cap&1) && !(last_mouse_cap&1);
  pressed && hit(x-r,y-r,r*2,r*2) ? (
    active_slider=sl; drag_y=ui_my; drag_v=v;
  );
  active_slider==sl && (mouse_cap&1) ? (
    nv=clamp(drag_v + (drag_y-ui_my)*(hi-lo)/170,lo,hi);
    sl==5 || sl==6 || sl==10 || sl==11 ? nv=floor(nv+0.5);
    slider(sl)=nv; slider_automate(slider(sl)); v=nv; n=clamp((v-lo)/(hi-lo),0,1);
  );
  active_slider==sl && !(mouse_cap&1) ? (active_slider=-1; sliderchange(slider(sl)););
  hov=hit(x-r,y-r,r*2,r*2) || active_slider==sl;
  // track and value arc, 270 degrees from 7:30 clockwise (gfx_arc: 0 = up)
  a0=-0.75*$pi; a1=a0+1.5*$pi*n;
  col_well(); ui_circle(x,y,r,1);
  col_edge_hi(); ui_ring(x,y,r,a0,a0+1.5*$pi,2);
  hov ? col_accent() : col_accent_dim(); n>0.002 ? ui_ring(x,y,r,a0,a1,2);
  gfx_set(0.27,0.29,0.33,1); ui_circle(x,y,r-4,1);
  gfx_set(0.17,0.185,0.21,1); ui_circle(x,y+1,r-5,1);
  gfx_set(0.13,0.14,0.16,1); ui_circle(x,y+2,r-7,1);
  ang=0.75*$pi+1.5*$pi*n;
  ax=x+cos(ang)*(r-8); ay=y+sin(ang)*(r-8);
  hov ? col_text() : col_accent(); ui_line(x+cos(ang)*3,y+sin(ang)*3,ax,ay);
  set_val_text(sl,v);
  r>12 ? (
    hov ? col_text() : col_dim(); ui_font(10,'b'); ui_text_box(x-r-14,y+r+3,r*2+28,12,name,1);
    hov ? col_accent() : col_faint(); ui_font(9,0); ui_text_box(x-r-14,y+r+15,r*2+28,11,#val,1);
  ) : (
    // compact knob (modulation matrix): the column header names it, the value sits at its right
    hov ? col_accent() : col_faint(); ui_font(9,0); ui_text_box(x+r+6,y-6,60,12,#val,4);
  );
);

function toggle(sl x y w name) local(on pressed hov) (
  on=slider(sl)>0.5; pressed=(mouse_cap&1) && !(last_mouse_cap&1);
  pressed && hit(x,y,w,22) ? (slider(sl)=1-slider(sl);slider_automate(slider(sl));sliderchange(slider(sl)););
  hov=hit(x,y,w,22);
  on ? col_on_dim() : col_well(); ui_rrect(x,y,w,22,4);
  on ? col_on() : (hov ? col_edge_hi() : col_edge()); ui_rrect_edge(x,y,w,22,4);
  on ? col_on() : col_faint(); ui_circle(x+11,y+11,3.5,1);
  on ? col_text() : col_dim(); ui_font(10,'b'); ui_text(x+20,y+6,name);
);

function cycle(sl x y w name maxv) local(pressed v hov) (
  pressed=(mouse_cap&1) && !(last_mouse_cap&1);
  pressed && hit(x,y,w,22) ? (v=slider(sl)+1; v>maxv?v=0; slider(sl)=v;slider_automate(slider(sl));sliderchange(slider(sl)););
  hov=hit(x,y,w,22);
  col_well(); ui_rrect(x,y,w,22,4);
  hov ? col_edge_hi() : col_edge(); ui_rrect_edge(x,y,w,22,4);
  col_text(); ui_font(10,'b'); ui_text(x+8,y+6,name);
  hov ? col_accent() : col_faint(); gfx_triangle((x+w-13)*ui_s,(y+8)*ui_s,(x+w-7)*ui_s,(y+8)*ui_s,(x+w-10)*ui_s,(y+13)*ui_s);
);

function set_wave_name(v) (
  v==0?sprintf(#tmp,"SINE"):v==1?sprintf(#tmp,"SAW"):v==2?sprintf(#tmp,"SQUARE"):v==3?sprintf(#tmp,"TRI"):sprintf(#tmp,"PULSE");
);
function set_filter_name(v) ( v==0?sprintf(#tmp,"LOWPASS"):v==1?sprintf(#tmp,"BANDPASS"):sprintf(#tmp,"HIGHPASS"); );
function set_lfo_name(v) ( v==0?sprintf(#tmp,"SINE"):v==1?sprintf(#tmp,"SAW"):v==2?sprintf(#tmp,"SQUARE"):sprintf(#tmp,"TRI"); );
function set_src_name(v) ( v==0?sprintf(#tmp,"OFF"):v==1?sprintf(#tmp,"LFO 1"):v==2?sprintf(#tmp,"LFO 2"):sprintf(#tmp,"MODWHL"); );
function set_dst_name(v) (
  v==0?sprintf(#tmp,"OFF"):v==1?sprintf(#tmp,"PITCH"):v==2?sprintf(#tmp,"OSC MIX"):v==3?sprintf(#tmp,"CUTOFF"):
  v==4?sprintf(#tmp,"RESONANCE"):v==5?sprintf(#tmp,"AMP"):v==6?sprintf(#tmp,"PAN"):v==7?sprintf(#tmp,"CHOR DEPTH"):
  v==8?sprintf(#tmp,"CHOR MIX"):v==9?sprintf(#tmp,"FLNG DEPTH"):v==10?sprintf(#tmp,"FLNG MIX"):v==11?sprintf(#tmp,"DLY TIME"):
  v==12?sprintf(#tmp,"DLY FEED"):v==13?sprintf(#tmp,"DLY MIX"):v==14?sprintf(#tmp,"REV SIZE"):v==15?sprintf(#tmp,"REV MIX"):
  v==16?sprintf(#tmp,"COMP THR"):sprintf(#tmp,"LIM CEIL");
);

function modrow(y srcsl dstsl amtsl) (
  set_src_name(slider(srcsl)); cycle(srcsl,690,y,80,#tmp,3);
  set_dst_name(slider(dstsl)); cycle(dstsl,775,y,120,#tmp,17);
  knob(amtsl,930,y+11,11,"AMT",-1,1);
);

