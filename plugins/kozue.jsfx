);

@block
dsp_rate!=srate ? update_rate();
// Deserialized values are applied here, not in @serialize: the host pushes its own copy of
// the slider values before each block, so a restore must be followed by sliderchange().
restore_pending ? (
  restore_pending=0;patch=saved_patch;bank=saved_bank;last_patch=patch;last_bank=bank;
  // Only sliders the factory reload clobbered are rewritten; matching ones keep host precision.
  si=2;loop(67,abs(slider(si)-SAVEBUF[si])>0.000001*max(1,abs(SAVEBUF[si])) ? (slider(si)=SAVEBUF[si];sliderchange(slider(si)););si+=1;);
  sliderchange(slider1);sliderchange(slider69);
