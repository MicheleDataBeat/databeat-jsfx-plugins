desc:kozue
// SPDX-License-Identifier: MIT
// Copyright (c) 2026 Michele Ibba
// kozue — the thesin_bis.jsfx instrument in a redesigned interface. Audio sections, sliders,
// MIDI handling and the 128-preset library are byte-identical to thesin_bis.jsfx; only desc: and @gfx differ.
// Architecture: dual oscillator + noise -> multimode SVF -> amp, two ADSRs, two LFOs,
// 4-slot modulation matrix, chorus, flanger, delay, reverb, compressor, limiter.
// 10-note polyphony. Zero look-ahead / zero declared PDC latency.
tags:instrument synthesizer MIDI
options:gfx_hz=30 want_all_kb
in_pin:none
out_pin:Left
out_pin:Right

slider1:patch=0<0,79,1>-Patch
slider2:master=0.72<0,1,0.001>-Master
slider3:tune=0<-100,100,1>-Master tune (cent)
slider4:osc1_wave=1<0,4,1>-Osc 1 wave
slider5:osc1_oct=0<-2,2,1>-Osc 1 octave
slider6:osc1_semi=0<-12,12,1>-Osc 1 semitone
slider7:osc1_fine=0<-50,50,1>-Osc 1 fine
slider8:osc1_pw=0.5<0.05,0.95,0.001>-Osc 1 pulse width
slider9:osc2_wave=2<0,4,1>-Osc 2 wave
slider10:osc2_oct=0<-2,2,1>-Osc 2 octave
slider11:osc2_semi=0<-12,12,1>-Osc 2 semitone
slider12:osc2_fine=-7<-50,50,1>-Osc 2 fine
slider13:osc2_pw=0.5<0.05,0.95,0.001>-Osc 2 pulse width
slider14:osc_mix=0.48<0,1,0.001>-Oscillator mix
slider15:noise_amt=0<0,1,0.001>-Noise
slider16:filter_type=0<0,2,1>-Filter type
slider17:cutoff=3200<30,18000,1>-Filter cutoff
slider18:resonance=0.20<0,0.95,0.001>-Filter resonance
slider19:filter_env_amt=0.35<-1,1,0.001>-Filter envelope amount
slider20:keytrack=0.35<0,1,0.001>-Filter key tracking
slider21:amp_a=0.01<0,5,0.001>-Amp attack
slider22:amp_d=0.20<0,5,0.001>-Amp decay
slider23:amp_s=0.80<0,1,0.001>-Amp sustain
slider24:amp_r=0.30<0.005,8,0.001>-Amp release
slider25:filt_a=0.005<0,5,0.001>-Filter attack
slider26:filt_d=0.35<0,5,0.001>-Filter decay
slider27:filt_s=0.25<0,1,0.001>-Filter sustain
slider28:filt_r=0.35<0.005,8,0.001>-Filter release
slider29:lfo1_rate=0.75<0.03,20,0.001>-LFO 1 rate
slider30:lfo1_shape=0<0,3,1>-LFO 1 shape
slider31:lfo2_rate=0.18<0.03,20,0.001>-LFO 2 rate
slider32:lfo2_shape=1<0,3,1>-LFO 2 shape
slider33:m1src=1<0,3,1>-Matrix 1 source
slider34:m1dst=3<0,17,1>-Matrix 1 destination
slider35:m1amt=0.18<-1,1,0.001>-Matrix 1 amount
slider36:m2src=2<0,3,1>-Matrix 2 source
slider37:m2dst=15<0,17,1>-Matrix 2 destination
slider38:m2amt=0.12<-1,1,0.001>-Matrix 2 amount
slider39:m3src=0<0,3,1>-Matrix 3 source
slider40:m3dst=0<0,17,1>-Matrix 3 destination
slider41:m3amt=0<-1,1,0.001>-Matrix 3 amount
slider42:m4src=0<0,3,1>-Matrix 4 source
slider43:m4dst=0<0,17,1>-Matrix 4 destination
slider44:m4amt=0<-1,1,0.001>-Matrix 4 amount
slider45:chorus_on=0<0,1,1>-Chorus on
slider46:chorus_rate=0.28<0.03,5,0.001>-Chorus rate
slider47:chorus_depth=0.45<0,1,0.001>-Chorus depth
slider48:chorus_mix=0.20<0,1,0.001>-Chorus mix
slider49:flanger_on=0<0,1,1>-Flanger on
slider50:flanger_rate=0.16<0.03,5,0.001>-Flanger rate
slider51:flanger_depth=0.40<0,1,0.001>-Flanger depth
slider52:flanger_fb=0.25<-0.9,0.9,0.001>-Flanger feedback
slider53:flanger_mix=0.18<0,1,0.001>-Flanger mix
slider54:delay_on=0<0,1,1>-Delay on
slider55:delay_time=330<20,1000,1>-Delay time ms
slider56:delay_fb=0.32<0,0.92,0.001>-Delay feedback
slider57:delay_mix=0.18<0,1,0.001>-Delay mix
slider58:reverb_on=0<0,1,1>-Reverb on
slider59:reverb_size=0.55<0,1,0.001>-Reverb size
slider60:reverb_damp=0.45<0,1,0.001>-Reverb damping
slider61:reverb_mix=0.16<0,1,0.001>-Reverb mix
slider62:comp_on=1<0,1,1>-Compressor on
slider63:comp_thresh=-10<-36,0,0.1>-Compressor threshold dB
slider64:comp_ratio=2.5<1,12,0.1>-Compressor ratio
slider65:comp_attack=8<0.2,100,0.1>-Compressor attack ms
slider66:comp_release=90<10,500,1>-Compressor release ms
slider67:limiter_on=1<0,1,1>-Limiter on
slider68:limiter_ceiling=-0.8<-12,0,0.1>-Limiter ceiling dB
slider69:bank=0<0,1,1{Original,Extended}>-Library bank

@init
ext_noinit = 1;
ext_nodenorm = 1;
ext_tail_size = -1;
pdc_delay = 0;
pdc_bot_ch = 0;
pdc_top_ch = 2;

VOICE_COUNT = 10;
VOICE_STRIDE = 32;
CHANNELS = 5000; MIDIQ = 2000000; QCAP = 65536;
SMOOTH = 6000; MODSM = 6200; SAVEBUF = 7000;
VBASE = 0;

// fixed memory regions — deliberately separated for readability and safety
CHL = 10000; CHR = 30000; CHSIZE = 16384;
FLL = 50000; FLR = 70000; FLSIZE = 16384;
DLL = 100000; DLR = 650000; DLSIZE = 524288;
RVL = 1200000; RVR = 1400000; RVSIZE = 131072;

age_counter = 1;
pitchbend = 0;
modwheel = 0;
lfo1_phase = 0;
lfo2_phase = 0;
chor_phase = 0;
fl_phase = 0;
chpos = 0;
flpos = 0;
dlpos = 0;
rvpos = 0;
rev_damp_l = 0;
rev_damp_r = 0;
comp_env = 0;
!instance_ready ? (last_patch=-1;last_bank=-1;instance_ready=1;);
smooth_ready = 0; dsp_rate = 0;
limit_gain=1;
active_slider = -1;
last_mouse_cap = 0;
peak_meter = 0;

function clamp(v lo hi) ( max(lo,min(hi,v)); );
function db2lin(db) ( 10^(db/20); );
function hz_from_note(n) ( 440 * 2^((n-69)/12); );

// Independent integrated BLEP residual: smooth triangle derivative corners.
function polyblamp(t dt) local(u z) (
  u=abs(t-floor(t+0.5));
  u<dt ? (z=1-u/dt; dt*z*z*z/3;) : 0;
);

function polyblep(t dt) local(x) (
  x = 0;
  t < dt ? (
    t /= dt;
    x = t+t-t*t-1;
  ) : t > 1-dt ? (
    t = (t-1)/dt;
    x = t*t+t+t+1;
  );
  x;
);

function oscwave(ph wave pw dt) local(y t2) (
  wave == 0 ? y = sin(2*$pi*ph)
  : wave == 1 ? (
    y = 2*ph-1;
    y -= polyblep(ph,dt);
  )
  : wave == 2 ? (
    y = ph < 0.5 ? 1 : -1;
    y += polyblep(ph,dt);
    t2 = ph + 0.5;
    t2 >= 1 ? t2 -= 1;
    y -= polyblep(t2,dt);
  )
  : wave == 3 ? (
    y = 1 - 4*abs(ph-0.5) + 4*polyblamp(ph,dt) - 4*polyblamp(ph-0.5,dt);
  )
  : (
    y = (ph < pw ? 1 : -1) - (2*pw-1); // remove duty-cycle DC before resonance
    y += polyblep(ph,dt);
    t2 = ph - pw;
    t2 < 0 ? t2 += 1;
    y -= polyblep(t2,dt);
  );
  y;
);

function lfowave(ph shape) local(y) (
  shape == 0 ? y = sin(2*$pi*ph)
  : shape == 1 ? y = 2*ph-1
  : shape == 2 ? y = ph < 0.5 ? 1 : -1
  : y = 1 - 4*abs(ph-0.5);
  y;
);

function modsrc(src) (
  src == 1 ? lfo1v : src == 2 ? lfo2v : src == 3 ? modwheel*2-1 : 0;
);

function modsum(dst) local(v) (
  v=0;
  m1dst == dst ? v += modsrc(m1src)*m1amt;
  m2dst == dst ? v += modsrc(m2src)*m2amt;
  m3dst == dst ? v += modsrc(m3src)*m3amt;
  m4dst == dst ? v += modsrc(m4src)*m4amt;
  v;
);

function read_delay(base size wpos ds) local(rp i0 i1 frac) (
  rp = wpos - ds;
  rp < 0 ? rp += size * (1 + floor((-rp)/size));
  rp >= size ? rp -= size * floor(rp/size);
  i0 = floor(rp);
  i1 = i0 + 1; i1 >= size ? i1 = 0;
  frac = rp-i0;
  base[i0]*(1-frac) + base[i1]*frac;
);

function reset_patch_defaults() (
  master=0.72; tune=0;
  osc1_wave=1; osc1_oct=0; osc1_semi=0; osc1_fine=0; osc1_pw=0.5;
  osc2_wave=2; osc2_oct=0; osc2_semi=0; osc2_fine=-7; osc2_pw=0.5;
  osc_mix=0.48; noise_amt=0;
  filter_type=0; cutoff=3200; resonance=0.20; filter_env_amt=0.35; keytrack=0.35;
  amp_a=0.01; amp_d=0.20; amp_s=0.80; amp_r=0.30;
  filt_a=0.005; filt_d=0.35; filt_s=0.25; filt_r=0.35;
  lfo1_rate=0.75; lfo1_shape=0; lfo2_rate=0.18; lfo2_shape=1;
  m1src=1; m1dst=3; m1amt=0.18;
  m2src=2; m2dst=15; m2amt=0.12;
  m3src=0; m3dst=0; m3amt=0;
  m4src=0; m4dst=0; m4amt=0;
  chorus_on=0; chorus_rate=0.28; chorus_depth=0.45; chorus_mix=0.20;
  flanger_on=0; flanger_rate=0.16; flanger_depth=0.40; flanger_fb=0.25; flanger_mix=0.18;
  delay_on=0; delay_time=330; delay_fb=0.32; delay_mix=0.18;
  reverb_on=0; reverb_size=0.55; reverb_damp=0.45; reverb_mix=0.16;
  comp_on=1; comp_thresh=-10; comp_ratio=2.5; comp_attack=8; comp_release=90;
  limiter_on=1; limiter_ceiling=-0.8;
);

function load_original_patch(idx) local(cat v) (
  reset_patch_defaults();
  cat=floor(idx/16); v=idx-cat*16;

  // BASS — short envelopes, controlled low end, mostly dry
  cat == 0 ? (
    master=0.76; cutoff=520 + v*115; resonance=0.12 + (v%4)*0.10;
    filter_env_amt=0.25 + (v%5)*0.11; keytrack=0.22;
    amp_a=0.002; amp_d=0.10+(v%4)*0.055; amp_s=0.72-(v%3)*0.10; amp_r=0.09+(v%4)*0.045;
    filt_a=0.001; filt_d=0.12+(v%5)*0.07; filt_s=0.08+(v%3)*0.09; filt_r=0.12;
    osc1_wave = v%5; osc2_wave=(v+2)%5; osc2_oct = v==0 ? -1 : 0;
    osc2_semi = (v==4 || v==11) ? 7 : 0; osc2_fine=-5-(v%4)*2; osc_mix=0.38+(v%5)*0.08;
    noise_amt=(v==6 || v==13) ? 0.08 : 0;
    v==0 ? (osc1_wave=0; osc2_wave=0; osc1_oct=-1; osc2_oct=-1; cutoff=420; filter_env_amt=0; amp_s=0.92;)
    : v==2 ? (osc1_wave=4; osc1_pw=0.27; osc2_wave=1; cutoff=780; resonance=0.72; filter_env_amt=0.80; filt_d=0.22;)
    : v==7 ? (chorus_on=1; chorus_mix=0.16; chorus_depth=0.35; osc2_semi=12; osc_mix=0.28;)
    : v==9 ? (amp_d=0.08; amp_s=0.18; amp_r=0.08; filter_env_amt=0.65; filt_d=0.09;)
    : v==10 ? (resonance=0.78; cutoff=900; m1amt=0.10;)
    : v==13 ? (osc1_wave=4; osc1_pw=0.16; osc2_wave=4; osc2_pw=0.66; resonance=0.42;)
    : 0;
  )
  // LEAD — brighter, more modulation, selected ambience
  : cat == 1 ? (
    master=0.68; cutoff=3100+v*430; resonance=0.18+(v%4)*0.08; filter_env_amt=0.18+(v%4)*0.08; keytrack=0.45;
    amp_a=0.004+(v%4)*0.006; amp_d=0.16; amp_s=0.82; amp_r=0.20+(v%3)*0.08;
    osc1_wave=(v+1)%5; osc2_wave=(v+3)%5; osc2_semi=(v%4==1)?7:0; osc2_fine=-8+(v%3)*3; osc_mix=0.48;
    lfo1_rate=4.2+(v%5)*0.65; m1src=1; m1dst=1; m1amt=0.018+(v%3)*0.012;
    v==4 ? (osc1_wave=0; osc2_wave=3; cutoff=7600; amp_a=0.018; chorus_on=1; chorus_mix=0.16;)
    : v==7 ? (chorus_on=1; chorus_mix=0.24; chorus_depth=0.42; delay_on=1; delay_time=280; delay_mix=0.10;)
    : v==8 ? (cutoff=1900; resonance=0.72; filter_env_amt=0.52;)
    : v==9 ? (noise_amt=0.025; cutoff=10000; reverb_on=1; reverb_mix=0.12;)
    : v==10 ? (chorus_on=1; chorus_rate=0.38; chorus_mix=0.25;)
    : v==11 ? (delay_on=1; delay_time=375; delay_fb=0.38; delay_mix=0.25;)
    : v==12 ? (osc1_wave=4; osc1_pw=0.22; osc2_wave=4; osc2_pw=0.34;)
    : v==13 ? (osc2_semi=12; chorus_on=1; chorus_mix=0.20; reverb_on=1; reverb_mix=0.10;)
    : 0;
  )
  // KEYS — percussive to sustained, modest effects
  : cat == 2 ? (
    master=0.70; cutoff=4200+v*300; resonance=0.12+(v%4)*0.06; filter_env_amt=0.15+(v%4)*0.12; keytrack=0.55;
    amp_a=0.003+(v%3)*0.004; amp_d=0.34+(v%4)*0.11; amp_s=0.42+(v%3)*0.12; amp_r=0.28+(v%4)*0.10;
    filt_a=0.002; filt_d=0.22+(v%5)*0.08; filt_s=0.20; filt_r=0.32;
    osc1_wave=(v%2)?3:1; osc2_wave=(v%3==0)?0:2; osc2_semi=(v==2 || v==7 || v==14)?12:0; osc2_fine=-4; osc_mix=0.42;
    v==1 ? (osc1_wave=3; osc2_wave=0; cutoff=5200; amp_d=0.75; amp_s=0.30; chorus_on=1; chorus_mix=0.18;)
    : v==2 ? (osc1_wave=0; osc2_wave=3; amp_d=0.65; amp_s=0.28; chorus_on=1; chorus_mix=0.23;)
    : v==3 ? (amp_d=0.16; amp_s=0.12; amp_r=0.14; filter_env_amt=0.45;)
    : v==6 ? (chorus_on=1; chorus_mix=0.30; chorus_depth=0.55;)
    : v==7 ? (osc1_wave=0; osc2_wave=0; osc2_semi=12; amp_d=0.85; amp_s=0.12; reverb_on=1; reverb_mix=0.18;)
    : v==8 ? (cutoff=2600; noise_amt=0.025;)
    : v==9 ? (osc1_wave=2; osc2_wave=2; amp_a=0.008; amp_s=0.90; filter_env_amt=0.05;)
    : v==10 ? (amp_d=0.12; amp_s=0.18; filter_env_amt=0.55; filt_d=0.10;)
    : v==11 ? (chorus_on=1; reverb_on=1; chorus_mix=0.18; reverb_mix=0.14;)
    : v==13 ? (osc1_wave=4; osc1_pw=0.31; amp_d=0.10; amp_s=0.22;)
    : 0;
  )
  // PADS — long envelopes and richer modulation/space
  : cat == 3 ? (
    master=0.57; cutoff=2100+v*340; resonance=0.13+(v%3)*0.07; filter_env_amt=0.10+(v%4)*0.09; keytrack=0.30;
    amp_a=0.55+(v%5)*0.28; amp_d=0.80+(v%3)*0.35; amp_s=0.76+(v%3)*0.06; amp_r=1.25+(v%5)*0.45;
    filt_a=0.65+(v%4)*0.25; filt_d=1.10; filt_s=0.40+(v%3)*0.12; filt_r=1.50;
    osc1_wave=(v%3==0)?1:3; osc2_wave=(v%2)?1:2; osc2_semi=(v%4==1)?12:0; osc2_fine=-9-(v%3)*3; osc_mix=0.50;
    chorus_on=1; chorus_rate=0.16+(v%4)*0.045; chorus_depth=0.48+(v%3)*0.10; chorus_mix=0.22+(v%3)*0.05;
    reverb_on=1; reverb_size=0.62+(v%4)*0.08; reverb_mix=0.18+(v%4)*0.035;
    lfo1_rate=0.08+(v%5)*0.045; m1src=1; m1dst=3; m1amt=0.14+(v%3)*0.05;
    lfo2_rate=0.05+(v%4)*0.035; m2src=2; m2dst=7; m2amt=0.20;
    v==1 ? (noise_amt=0.06; cutoff=4600; amp_a=1.4;)
    : v==4 ? (osc2_semi=12; chorus_mix=0.34; reverb_mix=0.23;)
    : v==6 ? (m2dst=8; m2amt=0.25;)
    : v==7 ? (cutoff=1150; resonance=0.34; amp_a=1.7;)
    : v==8 ? (noise_amt=0.035; cutoff=5200; reverb_mix=0.30;)
    : v==9 ? (m3src=1; m3dst=2; m3amt=0.15; m4src=2; m4dst=15; m4amt=0.18;)
    : v==11 ? (delay_on=1; delay_time=460; delay_fb=0.42; delay_mix=0.16; reverb_mix=0.32;)
    : v==13 ? (cutoff=7800; resonance=0.25; amp_a=2.0; reverb_mix=0.36;)
    : 0;
  )
  // FX — evolving/noisy/textural but still MIDI playable
  : (
    master=0.50; cutoff=900+v*620; resonance=0.30+(v%5)*0.11; filter_env_amt=(v%2)?0.62:-0.28; keytrack=0.16;
    amp_a=0.12+(v%4)*0.32; amp_d=0.70+(v%4)*0.40; amp_s=0.45+(v%3)*0.18; amp_r=1.0+(v%5)*0.55;
    filt_a=0.10+(v%4)*0.25; filt_d=0.65+(v%5)*0.32; filt_s=0.18+(v%4)*0.12; filt_r=1.2;
    osc1_wave=(v+1)%5; osc2_wave=(v+2)%5; osc2_semi=(v%3==0)?12:(v%3==1?7:-5); osc2_fine=-12; osc_mix=0.52;
    noise_amt=0.08+(v%5)*0.055;
    lfo1_rate=0.08+(v%6)*0.13; lfo2_rate=0.05+(v%5)*0.09;
    m1src=1; m1dst=(v%2)?3:1; m1amt=0.30+(v%3)*0.12;
    m2src=2; m2dst=15; m2amt=0.22+(v%4)*0.08;
    reverb_on=1; reverb_size=0.72; reverb_mix=0.28+(v%3)*0.06;
    delay_on=(v%3==0 || v==5 || v==10); delay_time=190+v*31; delay_fb=0.35; delay_mix=delay_on?0.20:0.12;
    v==0 ? (noise_amt=0.42; amp_a=1.8; cutoff=700; filter_env_amt=0.92; filt_a=2.2; m1dst=3; m1amt=0.55;)
    : v==2 ? (osc1_wave=4; osc1_pw=0.18; osc2_wave=2; lfo1_shape=2; lfo1_rate=5.5; m1dst=1; m1amt=0.08;)
    : v==3 ? (noise_amt=0.62; osc_mix=0.30; cutoff=5800; m1dst=3; m1amt=0.42;)
    : v==4 ? (cutoff=520; resonance=0.62; amp_a=2.2; amp_r=4.5; delay_on=1; delay_time=620; delay_mix=0.18;)
    : v==5 ? (amp_a=0.001; amp_d=0.12; amp_s=0.06; amp_r=0.20; osc1_wave=0; osc2_wave=0; reverb_mix=0.42;)
    : v==6 ? (noise_amt=0.35; reverb_mix=0.48; m2dst=15; m2amt=0.40;)
    : v==7 ? (resonance=0.86; cutoff=1200; m1dst=3; m1amt=0.60;)
    : v==8 ? (flanger_on=1; flanger_mix=0.35; flanger_fb=0.60; noise_amt=0.22;)
    : v==9 ? (osc1_wave=0; osc2_wave=3; amp_a=1.3; reverb_mix=0.44;)
    : v==10 ? (delay_on=1; delay_time=510; delay_fb=0.58; delay_mix=0.32; m2dst=11; m2amt=0.22;)
    : v==11 ? (filter_type=2; cutoff=680; noise_amt=0.30; chorus_on=1; chorus_mix=0.22;)
    : v==12 ? (noise_amt=0.55; amp_a=1.1; m1dst=15; m1amt=0.35;)
    : v==13 ? (lfo1_shape=2; lfo1_rate=2.2; m1dst=1; m1amt=0.16; resonance=0.72;)
    : v==14 ? (filter_type=1; cutoff=3400; filter_env_amt=-0.85; amp_a=0.7; amp_r=3.8;)
    : v==15 ? (cutoff=420; resonance=0.76; noise_amt=0.20; amp_a=2.6; amp_r=5.2; reverb_mix=0.50;)
    : 0;
  );
);

// PRESET_LIBRARY_INTEGRATED: explicit extension; original identities retained.
function load_patch(idx) (
  idx=floor(clamp(idx,0,127));
  idx<80 ? (
    load_original_patch(idx);
    idx==0 ? (comp_on=0; master=0.74; m2src=0; m2dst=0; m2amt=0; amp_a=0.008; m1src=0; m1dst=0; m1amt=0; osc2_fine=0;);
