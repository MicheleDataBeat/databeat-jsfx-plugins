// Voice layout retains slots 0..12; 13 channel,14 key held,15 last output,
// 16 steal residual,17 residual time,18 deterministic noise,19 velocity tone.
function clear_audio() (
  memset(VBASE,0,VOICE_COUNT*VOICE_STRIDE);
  memset(CHL,0,CHSIZE);memset(CHR,0,CHSIZE);memset(FLL,0,FLSIZE);memset(FLR,0,FLSIZE);
  memset(DLL,0,DLSIZE);memset(DLR,0,DLSIZE);memset(RVL,0,RVSIZE);memset(RVR,0,RVSIZE);
  memset(1600000,0,131072);memset(1800000,0,131072);
  chpos=0;flpos=0;dlpos=0;rvpos=0;ap1pos=0;ap2pos=0;
  lfo1_phase=0;lfo2_phase=0;chor_phase=0;fl_phase=0;age_counter=1;
  rev_damp_l=0;rev_damp_r=0;comp_env=0;limit_gain=1;dcxl=0;dcxr=0;dcyl=0;dcyr=0;
  memset(MODSM,0,18);smooth_ready=0;control_count=0;
);
function note_on(note vel ch) local(i b best score bestscore) (
  best=-1; bestscore=10^30; i=0;
  loop(VOICE_COUNT,
    b=VBASE+i*VOICE_STRIDE;
    // Idle first, then quiet release voices, then oldest held note.
    score=b[0]<0.5 ? -1000000+i : b[12]<0.5 ? b[6] : 10+b[3]*0.000001;
