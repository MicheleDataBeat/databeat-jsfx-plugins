    );
  );
);
function update_rate() (
  dsp_rate=srate;smoothcoef=1-exp(-1/(0.005*srate));modcoef=1-exp(-1/(0.0015*srate));
  dc_r=exp(-2*$pi*5/srate);limit_release=exp(-1/(0.060*srate));
