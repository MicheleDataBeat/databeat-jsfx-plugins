lfo1_phase += SMOOTH[29]/srate; lfo1_phase >= 1 ? lfo1_phase -= 1;
lfo2_phase += SMOOTH[31]/srate; lfo2_phase >= 1 ? lfo2_phase -= 1;
lfo1v = lfowave(lfo1_phase,lfo1_shape);
lfo2v = lfowave(lfo2_phase,lfo2_shape);

mi=1;loop(17,MODSM[mi]+=(modsum(mi)-MODSM[mi])*modcoef;mi+=1;);
mpitch=MODSM[1];mmix=MODSM[2];mcut=MODSM[3];mres=MODSM[4];mamp=MODSM[5];mpan=MODSM[6];

outl=0; outr=0; activevoices=0;
i=0;
loop(VOICE_COUNT,
  b=VBASE+i*VOICE_STRIDE;
  b[0] > 0.5 ? (
    activevoices += 1;
