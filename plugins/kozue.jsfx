!smooth_ready ? (si=2;loop(67,SMOOTH[si]=slider(si);si+=1;);smooth_ready=1;);
si=2;loop(67,SMOOTH[si]+=(slider(si)-SMOOTH[si])*smoothcoef;si+=1;);
c=CHANNELS;loop(16,c[2]+=(c[1]-c[2])*modcoef;c+=8;);
