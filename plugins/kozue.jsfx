@serialize
// Reopening a project must never reload factory values over edits. REAPER restores the
// slider line and calls @serialize/@slider in an order this code does not assume, so the
// blob carries the loaded patch identity and every sound parameter and restores them here.
reading=file_avail(0)>=0;
state_version=2;file_var(0,state_version);
!reading ? (
  // A write can arrive between the read and the first @block (measured: REAPER stores an
  // undo state there); while a restore is pending the saved values are written, not the
  // factory-reloaded sliders, so the pending restore keeps the user's edits.
  !restore_pending ? (saved_patch=patch;saved_bank=bank;si=2;loop(67,SAVEBUF[si]=slider(si);si+=1;););
  file_var(0,saved_patch);file_var(0,saved_bank);file_mem(0,SAVEBUF+2,67);
) : state_version>=2 ? ( // file_avail() is not a remaining-count in @serialize (measured: 1); version gates the layout
  file_var(0,saved_patch);file_var(0,saved_bank);file_mem(0,SAVEBUF+2,67);
  saved_patch=floor(clamp(saved_patch,0,79));saved_bank=floor(clamp(saved_bank,0,1));
  patch=saved_patch;bank=saved_bank;restore_pending=1;
