  b[4]=0;b[5]=0;b[6]=0;b[7]=1;b[8]=0;b[9]=1;b[10]=0;b[11]=0;
  b[12]=1;b[13]=ch;b[14]=1;b[15]=0;b[18]=note*65537+ch*257+age_counter;
