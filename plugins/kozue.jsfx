function set_cat_name(i) (
  i<16?sprintf(#catname,"BASS"):i<32?sprintf(#catname,"LEAD"):i<48?sprintf(#catname,"KEYS"):i<64?sprintf(#catname,"PAD"):i<80?sprintf(#catname,"FX"):i<88?sprintf(#catname,"BASS / EXTENDED"):i<96?sprintf(#catname,"LEAD / EXTENDED"):i<104?sprintf(#catname,"KEYS / EXTENDED"):i<112?sprintf(#catname,"PAD / EXTENDED"):i<120?sprintf(#catname,"PLUCK / EXTENDED"):sprintf(#catname,"BRASS / MOTION");
);

// ---------- background ----------
col_bg(); gfx_rect(0,0,gfx_w,gfx_h,1);
gfx_gradrect(0,58*ui_s,gfx_w,gfx_h-58*ui_s,0.082,0.090,0.104,1,0,0,0,0,-0.000018/ui_s,-0.000020/ui_s,-0.000024/ui_s,0);

// ---------- top bar ----------
col_bar(); ui_rect(0,0,1100,58);
col_accent(); ui_rect(0,57,1100,1);
col_accent(); ui_font(26,'b'); ui_text(20,12,"KOZUE");
col_faint(); ui_font(10,0); ui_text(122,21,"10-VOICE SUBTRACTIVE SYNTH");
set_patch_name(floor(patch)+bank*80); set_cat_name(floor(patch)+bank*80);
col_well(); ui_rrect(380,10,370,38,5); col_edge(); ui_rrect_edge(380,10,370,38,5);
pressed=(mouse_cap&1) && !(last_mouse_cap&1);
pressed && hit(380,10,370,16) ? (ui_patch_request=(bank>0?patch:80+min(patch,47))+1;);
bank>0 ? col_on() : col_accent(); ui_font(9,'b'); ui_text(392,15,#catname);
sprintf(#tmp,"BANK %s   %03d",bank>0?"B":"A",floor(patch)+bank*80);
hit(380,10,370,16) ? col_text() : col_faint(); ui_font(9,0); ui_text_box(560,15,180,12,#tmp,2);
col_text(); ui_font(16,'b'); ui_text(392,27,#patchname);
pressed && hit(760,10,34,38) ? (ui_patch_request=max(0,patch+bank*80-1)+1;);
pressed && hit(798,10,34,38) ? (ui_patch_request=min(127,patch+bank*80+1)+1;);
hit(760,10,34,38) ? col_edge_hi() : col_well(); ui_rrect(760,10,34,38,5); col_edge(); ui_rrect_edge(760,10,34,38,5);
hit(798,10,34,38) ? col_edge_hi() : col_well(); ui_rrect(798,10,34,38,5); col_edge(); ui_rrect_edge(798,10,34,38,5);
col_text(); gfx_triangle(781*ui_s,23*ui_s,781*ui_s,35*ui_s,772*ui_s,29*ui_s); gfx_triangle(811*ui_s,23*ui_s,811*ui_s,35*ui_s,820*ui_s,29*ui_s);
// output meter: 60 dB range, peak_meter decays here exactly as before
col_well(); ui_rrect(870,20,205,12,3);
ui_db=clamp(1+20*log10(max(peak_meter,0.000001))/60,0,1);
ui_db>0 ? gfx_gradrect(872*ui_s,22*ui_s,201*ui_db*ui_s,8*ui_s,0.18,0.70,0.45,1,(0.9-0.18)/(201*ui_s),(0.55-0.70)/(201*ui_s),(0.25-0.45)/(201*ui_s),0);
col_edge(); ui_rrect_edge(870,20,205,12,3);
peak_meter*=0.90;
col_faint(); ui_font(8,0); ui_text(870,35,"OUTPUT"); ui_text(957,35,"-30"); ui_text(1010,35,"-15"); ui_text(1041,35,"-6"); ui_text(1064,35,"0");

